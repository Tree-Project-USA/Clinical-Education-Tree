<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree: oauth2.authorization.code -->
    <record model="ir.ui.view" id="view_oauth2_authorization_code_tree">
        <field name="name">tree.oauth2.authorization.code</field>
        <field name="model">oauth2.authorization.code</field>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <tree string="oauth2_authorization_code">
                <field name="name"/>
                <field name="client"/>
                <field name="client_id"/>
                <field name="user_id"/>
                <field name="scopes"/>
                <field name="auth_code"/>
                <field name="redirect_uri"/>
                <field name="expire_time"/>
            </tree>
        </field>
    </record>
    <!-- Form: oauth2.authorization.code -->
    <record model="ir.ui.view" id="view_oauth2_authorization_code_form">
        <field name="name">form.oauth2_authorization_code</field>
        <field name="model">oauth2.authorization.code</field>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <form string="oauth2_authorization_code">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="client"/>
                        <field name="client_id"/>
                        <field name="user_id"/>
                        <field name="scopes"/>
                        <field name="auth_code"/>
                        <field name="redirect_uri"/>
                        <field name="expire_time"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" type="object" class="oe_highlight" special="save"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Main Action: oauth2.authorization.code -->
    <record id="action_oauth2_authorization_code" model="ir.actions.act_window">
        <field name="name">OAuth2 Authorization Codes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">oauth2.authorization.code</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            All important OAuth Authorization Codes
          </p><p>
            Ekika helps you track, manage and maintain your OAuth2 Authorization Codes.
          </p>
        </field>
    </record>
    <!-- Sub Action Tree: oauth2.authorization.code -->
    <record id="action_oauth2_authorization_code_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_oauth2_authorization_code_tree"/>
        <field name="act_window_id" ref="action_oauth2_authorization_code"/>
    </record>
    <!-- Sub Action Form: oauth2.authorization.code -->
    <record id="action_oauth2_authorization_code_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_oauth2_authorization_code_form"/>
        <field name="act_window_id" ref="action_oauth2_authorization_code"/>
    </record>

</odoo>
