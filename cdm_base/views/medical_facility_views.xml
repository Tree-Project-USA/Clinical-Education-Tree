<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

    <!-- Medical Clinical Site Views -->
    <record id="medical_facility_view_tree" model="ir.ui.view">
        <field name="name">medical.facility.view.tree</field>
        <field name="model">medical.facility</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Clinical Site Name"/>
                <field name="scce_first_name" string="SCCE First Name"/>
                <field name="scce_last_name" string="SCCE Last Name"/>
                <field name="email" string="SCCE Email Address"/>
                <field name="address" string="Clinical Site Address"/>
                <field name="city"/>
                <field name="state"/>
                <field name="geographical_id"/>
            </tree>
        </field>
    </record>

    <record id="medical_facility_view_search" model="ir.ui.view">
        <field name="name">medical.facility.view.search</field>
        <field name="model">medical.facility</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="address"/>
                <field name="geographical_id"/>
                <field name="city"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="medical_facility_view_form" model="ir.ui.view">
        <field name="name">medical.facility.view.form</field>
        <field name="model">medical.facility</field>
        <field name="arch" type="xml">
            <form string="Clinical Site">
                <field name="contract_attachment" invisible="1"/>
                <field name="is_single_facility" invisible="1"/>
                <field name="active" invisible="1"/>
                <header>
                    <button name="facility_multi_department"
                            string="Enable Multi-Location"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_contract_history" class="oe_stat_button" icon="fa-file-text-o" type="object">
                            <div class="o_stat_info">
                                <field name="contracts_count" widget="statinfo" string="Contracts"/>
                            </div>
                        </button>
                        <button name="action_open_facility_department" type="object" class="oe_stat_button" icon="fa-map-marker">
                            <field name="department_count" widget="statinfo" string="Locations"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <span class="o_form_label">Clinical Site Name</span>
                        <h1>
                            <field name="name" placeholder="e.g. Memorial Hospital"/>
                        </h1>
                    </div>

                    <group>
                        <group name="contact_info" string="Primary Contact">
                            <field name="company_id" string="University" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="email" widget="email"/>
                            <field name="address"/>
                            <field name="main_setting_ids" widget="many2many_tags" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                        </group>
                        <group name="location_info" string="Location Details">
                            <field name="city" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                            <field name="state" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                            <field name="geographical_id" attrs="{'invisible':[('is_single_facility', '=', False)]}" options="{'no_create': True}"/>
                            <field name="setting_ids" widget="many2many_tags" attrs="{'invisible':[('is_single_facility', '=', True)]}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="SCCE Contacts" name="scce_info">
                            <field name="scce_ids" mode="tree">
                                <tree editable="bottom">
                                    <field name="scce_id" options="{'no_create': True}"/>
                                    <field name="email"/>
                                    <field name="is_primary_scce" widget="boolean_toggle"/>
                                    <field name="is_secondary_scce" widget="boolean_toggle"/>
                                    <field name="is_other" widget="boolean_toggle"/>
                                    <button name="action_partner_access" type="object" string="Portal Access" icon="fa-id-card-o" class="btn-sm btn-outline-secondary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Clinical Instructors (CI)" name="ci_info">
                            <field name="ci_ids">
                                <tree>
                                    <field name="first_name"/>
                                    <field name="last_name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                </tree>
                            </field>
                        </page>
                        <page name="internal_notes" string="Internal Notes">
                            <field name="comment" placeholder="Add private notes about this facility here..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    </data>
</odoo>