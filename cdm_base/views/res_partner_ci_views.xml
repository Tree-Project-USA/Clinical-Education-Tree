<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SCCE Views -->
    <record id="scce_view_tree" model="ir.ui.view">
        <field name="name">res.partner.scce.view.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="scce_view_form" model="ir.ui.view">
        <field name="name">res.partner.scce.view.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="is_scce" invisible="1"/>
                    <group>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- CI Views -->
    <record id="ci_view_tree" model="ir.ui.view">
        <field name="name">res.partner.ci.view.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="email"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="ci_view_form" model="ir.ui.view">
        <field name="name">res.partner.ci.view.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="is_ci" invisible="1"/>
                    <group>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="scce_ids" widget="many2many_tags"/>
                            <field name="entry_level_pt_degree_earned"/>
                            <field name="highest_degree_earned"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="degree_area"/>
                            <field name="years_experience_ci"/>
                            <field name="years_experience_clinician"/>
                        </group>
                        <group>
                            <field name="areas_expertise"/>
                            <field name="clinical_certification"/>
                            <field name="specify_area"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>