<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem 
        name="Clin Ed TREE" 
        id="menu_root_cpdm"  
        web_icon="cdm_base,static/description/logo.png"
    />

    <!-- Client Actions -->
    <!-- <record id="action_map_scce" model="ir.actions.client">
        <field name="name">Map Scce</field>
        <field name="tag">map_scce_tag</field>
    </record> -->

    <!-- Student Actions -->
    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Student Information</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context">{'default_is_student': True, 'default_can_apply_hardship': False, 'active_test': False}</field>
    </record>

    <record id="student_action_view2" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="cdm_base.student_view_tree"/>
        <field name="act_window_id" ref="student_action"/>
    </record>

    <record id="student_action_view3" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cdm_base.student_view_form"/>
        <field name="act_window_id" ref="student_action"/>
    </record>

    <!-- SCCE Actions -->
    <record id="scce_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">SCCE</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_scce', '=', True)]</field>
        <field name="context">{'default_is_scce': True, 'active_test': False}</field>
    </record>

    <record id="scce_tree_view" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="cdm_base.scce_view_tree"/>
        <field name="act_window_id" ref="scce_action"/>
    </record>

    <record id="scce_form_view" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cdm_base.scce_view_form"/>
        <field name="act_window_id" ref="scce_action"/>
    </record>

    <!-- CI Actions -->
    <record id="ci_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">CLINICAL INSTRUCTOR (CI)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_ci', '=', True)]</field>
        <field name="context">{'default_is_ci': True, 'active_test': False}</field>
    </record>

    <record id="ci_tree_view" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="cdm_base.ci_view_tree"/>
        <field name="act_window_id" ref="ci_action"/>
    </record>

    <record id="ci_form_view" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cdm_base.ci_view_form"/>
        <field name="act_window_id" ref="ci_action"/>
    </record>

    <!-- Medical Facility Actions -->
    <record id="medical_facility_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Clinical Sites</field>
        <field name="res_model">medical.facility</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Contract Actions -->
    <record id="action_facility_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">facility.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('facility_id', '!=', False)]</field>
        <field name="context">{'search_default_group_by_state': 1, 'create': False}</field>
    </record>

    <!-- Configuration Actions -->
    <record model="ir.actions.act_window" id="program_action">
        <field name="name">Program Duration</field>
        <field name="res_model">program</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="action_preferred_setting" model="ir.actions.act_window">
        <field name="name">Setting Types</field>
        <field name="res_model">preferred.setting</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Menu Structure -->
    <menuitem
        id="student_details_menu"
        name="Students"
        parent="menu_root_cpdm"
        sequence="3"/>

    <menuitem
        id="student_menu"
        name="Student Information"
        action="student_action"
        parent="student_details_menu"
        sequence="1"/>

    <menuitem
        id="clinic_details_menu"
        name="Clinical Sites"
        parent="menu_root_cpdm"
        sequence="4"/>

    <menuitem
        id="facility_menu"
        name="Clinical Sites"
        action="medical_facility_action"
        parent="clinic_details_menu"
        sequence="2"/>

    <menuitem
        id="scce_menu"
        name="SCCE"
        action="scce_action"
        parent="clinic_details_menu"
        sequence="3"/>
        
    <menuitem
        id="ci_menu"
        name="CI"
        action="ci_action"
        parent="clinic_details_menu"
        sequence="4"/>

    <menuitem
        id="facility_contract_menu"
        name="Contracts"
        action="action_facility_contract"
        parent="clinic_details_menu"
        sequence="5"/>

    <menuitem
        id="configuration_menu"
        name="Configuration"
        parent="menu_root_cpdm"
        sequence="100"/>

    <record id="action_un_form" model="ir.actions.server">
        <field name="name">Program Profile Action</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">
user = env.user
action = user.action_open_user_company()
        </field>
    </record>

    <menuitem
        id="university_profile_menu"
        name="Program Profile"
        parent="configuration_menu"
        action="action_un_form"
        sequence="1"/>

    <menuitem
        id="program_menu"
        name="Program Duration"
        action="program_action"
        parent="configuration_menu"
        sequence="10"/>

    <menuitem
        id="campus_menu"
        name="Student Campus"
        action="cdm_base.action_student_campus"
        parent="configuration_menu"
        sequence="20"/>

    <menuitem
        id="preferred_setting_menu"
        name="Settings Types"
        action="action_preferred_setting"
        parent="configuration_menu"
        sequence="30"/>
    

    <menuitem
        id="clinical_experience_menu"
        name="Clinical Experience"
        action="cdm_base.action_clinical_experience"
        parent="configuration_menu"
        sequence="60"/>

    <!-- 
    <menuitem
        id="map_scce_menu"
        name="MAP"
        action="action_map_scce"
        parent="menu_root_cpdm"
        sequence="80"/>
    -->

</odoo>
