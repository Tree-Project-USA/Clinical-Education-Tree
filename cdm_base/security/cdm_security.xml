<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="cdmt_category">
            <field name="name">CDM Access Rights</field>
            <field name="description">Access rights for Clinical Placement Decision Making</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_cdm_customer" model="res.groups">
            <field name="name">CDM Customer</field>
            <field name="category_id" ref="cdm_base.cdmt_category"/>
        </record>

        <!-- Base Multi-Company Rules -->
        <record id="clinical_experience_comp_rule" model="ir.rule">
            <field name="name">Clinical Experience multi-company</field>
            <field name="model_id" ref="model_clinical_experience"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="facility_department_comp_rule" model="ir.rule">
            <field name="name">Clinical Site Location multi-company</field>
            <field name="model_id" ref="model_facility_department"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="medical_facility_comp_rule" model="ir.rule">
            <field name="name">Medical Clinical Site multi-company</field>
            <field name="model_id" ref="model_medical_facility"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="facility_contract_comp_rule" model="ir.rule">
            <field name="name">Clinical Site Contract multi-company</field>
            <field name="model_id" ref="model_facility_contract"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="program_comp_rule" model="ir.rule">
            <field name="name">Program multi-company</field>
            <field name="model_id" ref="model_program"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="student_campus_comp_rule" model="ir.rule">
            <field name="name">Student Campus multi-company</field>
            <field name="model_id" ref="model_student_campus"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
