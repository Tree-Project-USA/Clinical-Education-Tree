<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="placement_request_comp_rule" model="ir.rule">
            <field name="name">Placement Request multi-company</field>
            <field name="model_id" ref="model_placement_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="placement_offer_comp_rule" model="ir.rule">
            <field name="name">Placement Offer multi-company</field>
            <field name="model_id" ref="model_placement_offer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="archive_comp_rule" model="ir.rule">
            <field name="name">Archive multi-company</field>
            <field name="model_id" ref="model_archive"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="archive_offer_comp_rule" model="ir.rule">
            <field name="name">Archive Offer multi-company</field>
            <field name="model_id" ref="model_archive_offer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
