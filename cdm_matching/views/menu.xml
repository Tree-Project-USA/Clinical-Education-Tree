<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Placement Request Action -->
    <record id="action_placement_request" model="ir.actions.act_window">
        <field name="name">TREE Match</field>
        <field name="res_model">placement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new placement request.
            </p>
        </field>
    </record>

    <!-- Placement Offer Action -->
    <record id="placement_offer_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Offers</field>
        <field name="res_model">placement.offer</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Archive Action (Placement History) -->
    <record id="archive_action_menu" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Placement History</field>
        <field name="res_model">archive</field>
        <field name="context">{}</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem 
        id="menu_placement_request" 
        name="TREE Match"
        parent="cdm_base.menu_root_cpdm"
        sequence="0"
        action="action_placement_request"/>

    <menuitem
        id="placement_offer_menu"
        name="Offers"
        action="placement_offer_action"
        parent="cdm_base.menu_root_cpdm"
        sequence="5"/>

    <menuitem
        id="archive_menu"
        name="Placement History"
        action="archive_action_menu"
        parent="cdm_base.student_details_menu"
        sequence="5"/>
</odoo>
