<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="placement_history_template" name="Placement History">
        <t t-call="website.layout">
            <div class="cards mt-4">
                <div class="container mt-4">
                  <table class="table table-striped table-bordered shadow-sm text-center mt-4">
                    <thead style="background-color:#b4904f; color: #000000">
                      <tr>
                        <th colspan="9">
                          Placement History
                        </th>
                      </tr>
                      <tr>
                        <th scope="col">Facility</th>
                        <th scope="col">Clinical Experience Type</th>
                        <th scope="col">Term</th>
                        <th scope="col">Year</th>
                        <th scope="col">Setting Type</th>
                        <th scope="col">Student Preferred City</th>
                        <th scope="col">Student Preferred State</th>
                        <th scope="col">Student Preferred Zip Code</th>
                        <th scope="col">Placement Status</th>
                      </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="archive_ids" t-as="val">
                          <t t-if="val.is_show_student">
                            <td>
                              <a t-attf-href="/show/facility/#{val.facility_id.id}"><i class="fa fa-eye mx-2"/><t t-esc="val.facility_id.name"/></a>
                            </td>
                            <td><t t-esc="dict(val._fields['placement_type'].selection).get(val.placement_type)"/></td>
                            <td><t t-esc="dict(val._fields['placement_term'].selection).get(val.placement_term)"/></td>
                            <td><t t-esc="val.year"/></td>
                            <td><t t-esc="dict(val._fields['setting'].selection).get(val.setting)"/></td>
                            <td><t t-esc="val.city"/></td>
                            <td><t t-esc="val.state"/></td>
                            <td><t t-esc="val.geographical_id.zip_code"/></td>
                            <td><t t-esc="dict(val._fields['placement_status'].selection).get(val.placement_status)"/></td>
                          </t>
                        </tr>
                    </tbody>
                  </table>
                  <div class="row mt-4 mt-4 mb-4 text-left">
                    <div class="col-12 mr-2">
                        <a
                            type="button"
                            class="btn my-2 float-end"
                            role="button" 
                            href="/my/home"
                            style="background-color:  #b4904f; !important; color: #000000"
                        >
                          Back To My Profile
                        </a>
                    </div>
                  </div>
                </div>
            </div>
        </t>
    </template>
</odoo>