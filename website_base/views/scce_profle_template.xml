<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="scce_profile_template" name="Scce Information">

<!-- ================================================================ user_information ===================================================================== -->
      <t t-call="website.layout">
        <div class="scce_profile">
          <div class="container">
            <div class="popup-card-confirm">
              <div class="content">
                <h3>Successfully</h3>
                <p id="content-p">
                  Your request submitted successfully
                </p>
              </div>
            </div>
              <div class="row mt-4">
                <div class="col-12">
                  <div class="text-center mb-4 mt-2">
                    <h3>SCCE Information</h3>
                  </div>
                  <div class="text-center">
                    <img
                      src="/website_base/static/src/img/blank-profile-picture.jpg"
                      class="img img-fluid rounded-circle o_wblog_author_avatar mr-1"
                      loading="lazy"
                      style="width: 12rem; height:12rem;"
                    />
                  </div>
                </div>
              </div>
                <ul class="nav nav-tabs my-4" id="myTab" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="scce-information-tab" data-bs-toggle="tab"
                      data-bs-target="#scce_information" type="button" role="tab" aria-controls="scce_information"
                      aria-selected="false">Basic SCCE Information</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="medical-attachment-ids-tab" data-bs-toggle="tab"
                      data-bs-target="#medical_attachment_ids" type="button" role="tab" aria-controls="medical_attachment_ids"
                      aria-selected="false">Facility Information</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link " id="ci-information-tab" data-bs-toggle="tab"
                      data-bs-target="#ci_information" type="button" role="tab" aria-controls="ci_information"
                      aria-selected="false">CI Information</button>
                  </li>
                </ul>
                <div class="tab-content" id="myTabContent">
                  <div class="tab-pane fade my-4 show active" id="scce_information" role="tabpanel"
                    aria-labelledby="scce-information-tab">
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">First Name</label>
                          <div>
                            <input
                              type="text"
                              id="first_name"
                              class="form-control"
                              name="first_name"
                              t-att-value="partner.first_name"
                              readonly="readonly"
                            />
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Last Name</label>
                          <div>
                            <input
                              type="text"
                              id="last_name"
                              class="form-control"
                              name="last_name"
                              t-att-value="partner.last_name"
                              readonly="readonly"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Phone</label>
                          <div>
                            <input
                              type="text"
                              id="phone"
                              class="form-control updated"
                              name="phone"
                              t-att-value="partner.phone"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Email</label>
                          <div>
                            <input
                              type="text"
                              id="email"
                              class="form-control updated"
                              name="email"
                              t-att-value="partner.email"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12 text-center">
                        <a
                         type="button"
                         class="btn my-4"
                         role="button" 
                         t-attf-href="/submit/availability"
                         style="background-color:  #326434; !important; color: #fff"
                       >
                         <i class="fa fa-pencil"/> Submit Availability
                       </a>
                      </div>
                    </div>
                  </div>
                  <div class="tab-pane fade my-4" id="medical_attachment_ids" role="tabpanel"
                    aria-labelledby="medical-attachment-ids-tab">
                    <table class="table table-striped table-bordered shadow-sm text-center mt-5">
                      <thead style="background-color:#326434; color: #fff">
                        <tr>
                          <th scope="col" colspan="1">Facility Name</th>
                          <th scope="col" colspan="1">Facility Address</th>
                          <th scope="col" colspan="1">City</th>
                          <th scope="col" colspan="1">State</th>
                          <th scope="col" colspan="1">Zip Code</th>
                          <th scope="col" colspan="1"></th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr t-foreach="scce_facility_ids" t-as="val">
                          <td colspan="1"><t t-esc="val.name"/></td>
                          <td colspan="1"><t t-esc="val.address"/></td>
                          <td colspan="1"><t t-esc="val.city"/></td>
                          <td colspan="1"><t t-esc="val.state"/></td>
                          <td colspan="1"><t t-esc="val.zip"/></td>
                          <td colspan="1">
                            <a
                              t-if="val.offer_ids"
                              type="button"
                              class="btn my-2"
                              role="button" 
                              t-attf-href="/facility/scce/placement/offer/#{val.id}"
                              style="background-color:  #326434; !important; color: #fff"
                            >
                            <i class="fa fa-eye mx-2"/> Show Placement Offer
                            </a>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                  <div class="tab-pane fade my-4" id="ci_information" role="tabpanel"
                    aria-labelledby="ci-information-tab">
                    <div class="row mt-2">
                      <div class="col-12">
                        <a
                          type="button"
                          class="btn my-2"
                          role="button" 
                          style="background-color:  #326434; !important; color: #fff"
                        >
                          <i class="fa fa-pencil"/> Add New CI
                        </a>
                      </div>
                    </div>
                    <table class="table table-striped table-bordered shadow-sm text-center mt-2">
                      <thead style="background-color:#326434; color: #fff">
                        <tr>
                          <th>First Name</th>
                          <th>Last Name</th>
                          <th>Phone</th>
                          <th>Email</th>
                          <th style="width: 25rem;"></th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td></td>
                          <td></td>
                          <td></td>
                          <td></td>
                          <td>
                            <a class="btn btn-danger"><i class="fa fa-trash"/></a>
                            <a class="btn btn-warning"><i class="fa fa-pencil"/>Update CI Information</a>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
          </div>
        </div>
      </t>
  </template>
</odoo>
