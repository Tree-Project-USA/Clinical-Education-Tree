<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="hardship_request_template" name="Hardship Request Template">
        <t t-call="website.layout">
            <div id="form_temp">
                <div id="wrap" class="oe_structure oe_empty my-4">
                    <div
                        class="alert alert-danger w-10 mx-auto text-center"
                        t-if="error"
                        role="alert"
                    >
                        <strong>
                            <t t-esc="error"/>
                        </strong>
                    </div>
                    <div class="container">
                        <form  
                            action="/create/hardship/request" 
                            class="hardship"
                            method="post"
                            enctype="multipart/form-data"
                        >
                        <div t-if="hardship_form_attachment" class="modal fade" id="download_attachment" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                            <div class="modal-dialog">
                              <div class="modal-content">
                                <div class="modal-header">
                                  <h1 class="modal-title fs-5">Download Hardship Form Attachment</h1>
                                </div>
                                <div class="modal-body text-center">
                                    <a 
                                    id="download_hardship"
                                    type="button"
                                    class="btn btn-primary"
                                    role="button" 
                                    style="background-color:  #326434 !important; color: #fff; border-color:#326434"
                                    >
                                    Hardship Form Attachment 
                                    <i class="fa fa-download" />
                                </a>
                                </div>
                              </div>
                            </div>
                          </div>
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="len_file" value="1" />
                            <input type="hidden" name="len_zip_code" value="1" />
                            <div class="file row mt-4">
                                <div>
                                    <table class="table add_file table-bordered">
                                        <thead style="color:# a6ab75;">
                                            <tr>
                                                <td>
                                                    <strong>
                                                        #
                                                    </strong>
                                                </td>
                                                <td>
                                                    <strong>
                                                        Zip code
                                                    </strong>
                                                </td>
                                                <td>
                                                    <strong>
                                                        State
                                                    </strong>
                                                </td>
                                                <td>
                                                    <strong>
                                                        City
                                                    </strong>
                                                </td>
                                                <td>
                                                </td>
                                            </tr>
                                        </thead>
                                        <tbody id="add_zip_code">
                                            
                                        </tbody>
                                        <tfooter class="footer">
                                            <tr>
                                                <td colspan="5">
                                                    <a 
                                                    id="add_zip" 
                                                    class="btn m-2"
                                                    style="background-color:#326434;color:#fff;" 
                                                    >
                                                    <h6>Add Zip Code</h6>
                                                    </a>
                                                </td>
                                            </tr>
                                        </tfooter>
                                    </table>
                                </div>
                            </div>
                            <div class="file row mt-4">
                                <div>
                                    <table class="table add_file table-bordered">
                                      <thead style="color:# a6ab75;">
                                        <tr>
                                          <th class="text-center" colspan="5">Application attachments</th>
                                          <th class="text-center" />
                                        </tr>
                                      </thead>
                                      <tbody id="add_file">
                                        
                                      </tbody>
                                    
                                      <tfooter>
                                        <tr>
                                          <td colspan="6">
                                            <a 
                                              id="add_files" 
                                              class="btn m-2"
                                              style="background-color:#326434;color:#fff;" 
                                            >
                                              <h6>Add File</h6>
                                            </a>
                                          </td>
                                        </tr>
                                      </tfooter>
                                    </table>
                                </div>
                            </div>
                            <div class="row mt-4">
                              <div class="col-12">
                                  <div class="form-group green-border-focus">
                                      <label class="required" for="note">Note</label>
                                      <textarea
                                        class="form-control"
                                        row="3"
                                        name="note"
                                        type="text"
                                        id="note"
                                      >
                                      </textarea>
                                  </div>
                              </div>
                          </div>
                          <div class="clearfix oe_login_buttons mt-4">
                              <button type="submit"
                                      class="custom_create btn btn-block" style="background-color:#326434;color:#fff;">
                                  Submit
                              </button>
                              <a href="/my/home"
                                    class="float-end custom_create btn btn-block "
                                    style="background-color:#326434;color:#fff;">
                                    Back To My Profile
                                </a>
                          </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>