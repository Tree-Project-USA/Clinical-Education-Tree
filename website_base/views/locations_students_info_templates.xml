<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="locations_students_info_template" name="Locations Students Info Template">
        <t t-call="website.layout">
            <div id="form_temp">
                <div id="wrap" class="oe_structure oe_empty">
                    <div class="container">
                        <div id="form_template">
                            <div class="form-group">
                                <div class='row ml-1'
                                        style="width:99%;">
                                    <div class="form-group col-12 show_total_project">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <table class="table table-bordered mt-3 total_project_costs">
                                                <thead>
                                                    <tr>
                                                        <td>
                                                            <strong>
                                                                State
                                                            </strong>
                                                        </td>
                                                        <td>
                                                            <strong>
                                                                City
                                                            </strong>
                                                        </td>
                                                        <td>
                                                            <strong>
                                                                Zip code
                                                            </strong>
                                                        </td>
                                                    </tr>
                                                </thead>
                                                <div class="collapse">
                                                    <tbody t-foreach="partner.locatio_ids" t-as="val">
                                                        <tr class="project_cost_line">
                                                            <td>
                                                                <div class="form-group">
                                                                    <div class="input-group mb-2">
                                                                        <input 
                                                                            type="text" 
                                                                            readonly="1"
                                                                            class="form-control" 
                                                                            t-att-value="val.state_id.name" 
                                                                            />
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="form-group">
                                                                    <div class="input-group mb-2">
                                                                        <input 
                                                                            type="text" 
                                                                            readonly="1"
                                                                            class="form-control" 
                                                                            t-att-value="val.city_id.name"
                                                                        />
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="form-group">
                                                                    <div class="input-group mb-2">
                                                                        <input 
                                                                            type="text" 
                                                                            readonly="1"
                                                                            class="form-control" 
                                                                            t-att-value="val.zip"
                                                                        />
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </div>
                                            </table>
                                        </div>
                                        <textarea class="d-none"
                                                    name="data_line_ids">
                                        </textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="clearfix oe_login_buttons">
                                <button type="submit"
                                        class="custom_create btn btn-block" style="background-color:#ab8631;color:#fff;">
                                    Confirm
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>