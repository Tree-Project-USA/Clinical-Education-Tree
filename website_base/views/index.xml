<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="user_sign_in" name="User Sign In" inherit_id="portal.user_dropdown">
        <xpath expr="//li" position="before">
           
            <t t-set="is_connected" t-value="not user_id._is_public()" />
            <t t-set="res_partner_vals" t-value="request.env.user.partner_id" />
            <li t-if="is_connected" class="nav-item dropdown ml-4">
              <a 
                href="/hardship/request" 
                role="menuitem" 
                class="dropdown-item"
                t-if="res_partner_vals.can_apply_hardship == False"
              >
              Hardship Request
              </a>
            </li>
        </xpath>
    
      </template>
</odoo>