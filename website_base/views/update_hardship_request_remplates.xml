<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="inherit_submenu" inherit_id="website.submenu">
    <xpath expr="//li[@t-if='submenu.is_visible and not (submenu.child_id or submenu.is_mega_menu)']" position="attributes">

       <attribute name="t-if" add="and submenu.check_menu_hardship()" separator=" "/>
    </xpath>
  </template>
  <template id="update_hardship_request_template" name="Hardship Request Template">
      <t t-call="website.layout">
          <div id="form_temp">
              <div id="wrap" class="oe_structure oe_empty my-4">
                  <div
                      class="alert alert-danger w-10 mx-auto text-center"
                      t-if="error"
                      role="alert"
                  >
                      <strong>
                          <t t-esc="error"/>
                      </strong>
                  </div>
                  <div class="container">
                      <form  
                      t-att-action="'/update/hardship/request?hardship=%s' % (hardship_id.id)" 
                          class="hard_ship_update"
                          method="post"
                          enctype="multipart/form-data"
                      >
                          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                          <input type="hidden" name="len_file" value="1" />
                          <input type="hidden" name="list_zip_code_h_u" id="list_zip_code_h_u"/> 
                          <div class="row mt-4">
                            <div>
                                <table class="table table-borderless mt-3 total_project_costs">
                                    <thead>
                                        <tr>
                                            <td>
                                                <strong>
                                                    #
                                                </strong>
                                            </td>
                                            <td>
                                                <strong>
                                                    Zip code
                                                </strong>
                                            </td>
                                            <td>
                                                <strong>
                                                    State
                                                </strong>
                                            </td>
                                            <td>
                                                <strong>
                                                    City
                                                </strong>
                                            </td>
                                        </tr>
                                    </thead>
                                    <div class="collapse">
                                        <tbody>
                                            <t t-if="geographical_ids">
                                                <t t-set="variable"
                                                    t-value="geographical_ids" />
                                            </t>
                                            <t t-else="">
                                                <t t-set="variable" t-value="3" />
                                            </t>
                                            <tr t-foreach="variable" t-as="val"
                                                class="project_cost_line">
                                                <t t-set="geographical"
                                                    t-value="request.env['geographical'].sudo().search([('id', '=', val)])"
                                                />
                                                <td>
                                                    <div class="form-group">
                                                        <span t-esc="val_index + 1" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="form-group">
                                                        <div class="input-group mb-2">
                                                            <input type="text" id="zip"
                                                                name="zip" required="required"
                                                                maxlength="9"
                                                                class="form-control"
                                                                t-att-value="geographical.zip_code if geographical_ids else ''" />
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="form-group">
                                                        <input type="text" id="state"
                                                            name="state"
                                                            style="pointer-events: none;"
                                                            required="required"
                                                            class="form-control"
                                                            t-att-value="geographical.state if geographical_ids else '' " />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="form-group">
                                                        <input type="text" id="city" name="city"
                                                            required="required"
                                                            style="pointer-events: none;"
                                                            class="form-control"
                                                            t-att-value="geographical.city if geographical_ids else '' " />
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </div>
                                </table>
                            </div>
                          </div>
                          <div class="row mt-4">
                              <div>
                                <table class="table add_file table-bordered">
                                  <thead>
                                    <tr>
                                      <th class="text-center" colspan="5">Application attachments</th>
                                      <th class="text-center" />
                                    </tr>
                                  </thead>
                                  <tbody id="add_file">
                                    
                                  </tbody>
                                  <tfooter>
                                    <tr>
                                      <td colspan="6">
                                        <a 
                                          id="add_files" 
                                          class="btn m-2"
                                          style="background-color:#ab8631;color:#fff;" 
                                        >
                                          <h6>Add File</h6>
                                        </a>
                                      </td>
                                    </tr>
                                  </tfooter>
                                </table>
                              </div>
                          </div>
                          <div class="row mt-4">
                            <div class="col-12">
                                <div class="form-group green-border-focus">
                                    <label class="required" for="note">Note</label>
                                    <textarea
                                      class="form-control"
                                      row="3"
                                      name="note"
                                      type="text"
                                      id="note"
                                    >
                                    </textarea>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix oe_login_buttons mt-4">
                            <button type="submit"
                                    class="custom_create btn btn-block" style="background-color:#ab8631;color:#fff;">
                                Submit
                            </button>
                        </div>
                      </form>
                  </div>
              </div>
          </div>
      </t>
  </template>
</odoo>