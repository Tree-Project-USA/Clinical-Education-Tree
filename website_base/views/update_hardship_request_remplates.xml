<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="update_hardship_request_template" name="Hardship Request Template">
      <t t-call="website.layout">
          <div id="form_temp">
              <div id="wrap" class="oe_structure oe_empty my-4">
                  <div
                      class="alert alert-danger w-10 mx-auto text-center"
                      t-if="error"
                      role="alert"
                  >
                      <strong>
                          <t t-esc="error"/>
                      </strong>
                  </div>
                  <div class="container">
                      <form  
                      t-att-action="'/update/hardship/request?hardship=%s' % (hardship_id.id)" 
                          class="hard_ship_update"
                          method="post"
                          enctype="multipart/form-data"
                      >
                          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                          <input type="hidden" name="len_file" value="1" />
                          <input type="hidden" name="len_zip_code" value="1" />
                          <div class="file row mt-4">
                            <div class="table-responsive">
                                <table class="table add_file table-striped table-bordered shadow-sm text-center my-4">
                                    <thead>
                                        <tr>
                                            <th>
                                                #
                                            </th>
                                            <th>
                                                Zip code
                                            </th>
                                            <th>
                                                State
                                            </th>
                                            <th>
                                                City
                                            </th>
                                            <th>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="add_zip_code">
                                        
                                    </tbody>
                                    <tfooter class="footer">
                                        <tr>
                                            <td colspan="5">
                                                <a 
                                                id="add_zip" 
                                                class="btn m-2"
                                                style="background-color:#F9D6BF; color: #083B4D" 
                                                >
                                                <h6><i class="fa fa-plus-circle"/></h6>
                                                </a>
                                            </td>
                                        </tr>
                                    </tfooter>
                                </table>
                            </div>
                        </div>
                          <div class="row mt-4">
                            <div class="col-lg-6 col-12">
                                <div class="table-responsive">
                                  <table class="table add_file table-striped table-bordered shadow-sm text-center">
                                    <thead>
                                      <tr>
                                        <th class="text-center" colspan="5">Application attachments</th>
                                        <th class="text-center" />
                                      </tr>
                                    </thead>
                                    <tbody id="add_file">
                                      
                                    </tbody>
                                    <tfooter>
                                      <tr>
                                        <td colspan="6">
                                          <a 
                                            id="add_files" 
                                            class="btn m-2">
                                            <h6><i class="fa fa-plus-circle"/></h6>
                                          </a>
                                        </td>
                                      </tr>
                                    </tfooter>
                                  </table>
                                </div>
                            </div>
                            <div class="col-lg-6 col-12">
                                <div class="form-group">
                                    <textarea
                                      class="form-control"
                                      row="3"
                                      name="note"
                                      id="note"
                                      placeholder="Note"
                                    />
                                </div>
                            </div>
                          </div>
                        <div class="clearfix oe_login_buttons mt-4">
                            <button type="submit"
                                    class="custom_create btn btn-block">
                                Submit
                            </button>
                            <a href="/my/home"
                                  class="float-end custom_create btn btn-block ">
                                  Back To My Profile
                              </a>
                        </div>
                      </form>
                  </div>
              </div>
          </div>
      </t>
  </template>
</odoo>