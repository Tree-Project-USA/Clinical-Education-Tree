<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="show_ci_placement_offer_facility_template" name="Show CI Placement Offer Facility">
        <t t-call="website.layout">
            <div class="container">
              <div class="alert alert-danger w-10 mx-auto text-center" t-if="error"
                  role="alert">
                  <strong>
                      <t t-esc="error" />
                  </strong>
              </div>
              <form
                class="availability"
              >
                    <div class="text-center mt-4" style="color: #083B4D">
                        <h2>Department Information</h2>
                    </div>
                    <div class="row my-4">
                      <div class="col-3 my-4 text-center">
                        <div class="nav flex-column nav-pills me-3 d-none d-lg-block" id="v-pills-tab"
                          role="tablist" aria-orientation="vertical">
                          <div class="text-center my-2">
                            <img
                              src="/website_base/static/src/img/hospital.png"
                              class="img img-fluid o_wblog_author_avatar mr-1"
                              loading="lazy"
                            />
                          </div>
                          <button class="col-12 nav-avalibility nav-link active" id="assigned-student-tab"
                            data-bs-toggle="pill" data-bs-target="#assigned_student" type="button" role="tab"
                            aria-controls="assigned_student" aria-selected="true">Assigned Student/s</button>
                          <button class="col-12 nav-avalibility nav-link" id="scce-information-tab" data-bs-toggle="pill"
                            data-bs-target="#scce_information" type="button" role="tab"
                            aria-controls="scce_information" aria-selected="false">SCCE Information</button>
                          <button class="col-12 nav-avalibility nav-link" id="placement-history-tab" data-bs-toggle="pill"
                            data-bs-target="#placement_history" type="button" role="tab"
                            aria-controls="placement_history" aria-selected="false">Placement History</button>
                        </div>
                        <div class="nav flex-column nav-pills me-3 d-sm-block d-lg-none" id="v-pills-tab"
                          role="tablist" aria-orientation="vertical">
                          <div class="text-center my-4">
                            <img
                              src="/website_base/static/src/img/hospital.png"
                              class="img img-fluid o_wblog_author_avatar mr-1"
                              loading="lazy"
                            />
                          </div>
                          <button class="nav-link active" id="assigned-student-tab" data-bs-toggle="pill"
                            data-bs-target="#assigned_student" type="button" role="tab"
                            aria-controls="assigned_student" aria-selected="true">
                            <i class="fa fa-user-md" style="font-size:20px;" />
                          </button>
                          <button class="nav-link" id="scce-information-tab" data-bs-toggle="pill"
                            data-bs-target="#scce_information" type="button" role="tab"
                            aria-controls="scce_information" aria-selected="false">
                            <i class="fa fa-user" style="font-size:20px;" />
                          </button>
                          <button class="nav-link" id="placement-history-tab" data-bs-toggle="pill"
                            data-bs-target="#placement_history" type="button" role="tab"
                            aria-controls="placement_history" aria-selected="false">
                            <i class="fa fa-history" style="font-size:20px;" />
                          </button>
                        </div>
                      </div>
                      <div class="col-9">
                        <div class="tab-content" id="myTabContent">
                          <t t-set="status" t-value="0"/>
                          <t t-foreach="archive_ids" t-as="archive">
                            <t t-if="archive.placement_status == 'pending'">
                              <t t-set="status" t-value="status + 1"/>
                            </t>
                          </t>
                          <div class="tab-pane fade show active" id="assigned_student" role="tabpanel" aria-labelledby="assigned-student-tab">
                            <div class="table-responsive">
                              <table class="table table-striped table-bordered shadow-sm text-center mt-4">
                                <thead style="background-color:#F9D6BF; color: #083B4D">
                                <tr>
                                  <th style="width: 2rem;">#</th>
                                  <th>Location</th>
                                  <th>Student Name</th>
                                  <th>Clinical Experience Type</th>
                                  <th>Setting Type</th>
                                  <th>Term</th>
                                  <th>Year</th>
                                  <th>View Student Information</th>
                                </tr>
                              </thead>
                              <tbody>
                                <tr t-foreach="archive_ids" t-as="val">
                                  <t t-if="val.active == True and (val.placement_status == 'pending' or val.is_show_portal == True)">
                                    <td><t t-esc="val_index + 1"/></td>
                                    <td><t t-esc="val.department_id.name"/></td>
                                    <td><t t-esc="val.student_id.name"/></td>
                                    <td>
                                      <t t-esc="val.experience_id.name"/>
                                    </td>
                                    <td><t t-esc="dict(val._fields['setting'].selection).get(val.setting)"/></td>
                                    <td><t t-esc="dict(val._fields['placement_term'].selection).get(val.placement_term)"/></td>
                                    <td><t t-esc="val.year"/></td>
                                    <td>
                                      <form
                                        class="availability"
                                      >
                                        <a
                                            type="button"
                                            class="btn  btn-outline my-2"
                                            role="button" 
                                            t-attf-href="/profile/student/#{val.student_id.id}"
                                            style="background-color:#F9D6BF; color: #083B4D"
                                            >
                                            <i class="fa fa-eye mx-1"/>
                                        </a>
                                      </form>
                                    </td>
                                  </t>
                                </tr>
                              </tbody>
                              </table>
                            </div>
                          </div>
                          <div class="tab-pane fade" id="scce_information" role="tabpanel" aria-labelledby="scce-information-tab">
                            <div class="table-responsive">
                              <table class="table table-striped table-bordered shadow-sm text-center mt-4">
                                <thead style="background-color:#F9D6BF; color: #083B4D">
                                <tr>
                                  <th scope="col">First Name</th>
                                  <th scope="col">Last Name</th>
                                  <th scope="col">Phone</th>
                                  <th scope="col">Email</th>
                                </tr>
                              </thead>
                              <tbody>
                                <tr t-foreach="scce_ids" t-as="val">
                                  <td><t t-esc="val.first_name"/></td>
                                  <td><t t-esc="val.last_name"/></td>
                                  <td><t t-esc="val.phone"/></td>
                                  <td><t t-esc="val.email"/></td>
                                </tr>
                              </tbody>
                              </table>
                            </div>
                          </div>
                          <div class="tab-pane fade" id="placement_history" role="tabpanel" aria-labelledby="placement-history-tab">
                            <div class="table-responsive">
                              <table class="table table-striped table-bordered shadow-sm text-center mt-4">
                                <thead style="background-color:#F9D6BF; color: #083B4D">
                                <tr>
                                  <th scope="col">Location</th>
                                  <th scope="col">City</th>
                                  <th scope="col">State</th>
                                  <th scope="col">Facility Zip Code</th>
                                  <th scope="col">Student Name</th>
                                  <th scope="col">Clinical Experience Type</th>
                                  <th scope="col">Setting Type</th>
                                  <th scope="col">Term</th>
                                  <th scope="col">Year</th>
                                  <th scope="col">Placement Status</th>
                                </tr>
                              </thead>
                              <tbody>
                                  <tr t-foreach="placement_history_ids" t-as="val">
                                    <td><t t-esc="val.department_id.name"/></td>
                                    <td><t t-esc="val.city"/></td>
                                    <td><t t-esc="val.state"/></td>
                                    <td><t t-esc="val.facility_id.geographical_id.zip_code"/></td>
                                    <td><t t-esc="val.student_id.name"/></td>
                                    <td>
                                      <t t-esc="val.experience_id.name"/>
                                    </td>
                                    <td><t t-esc="dict(val._fields['setting'].selection).get(val.setting)"/></td>
                                    <td><t t-esc="dict(val._fields['placement_term'].selection).get(val.placement_term)"/></td>
                                    <td><t t-esc="val.year"/></td>
                                    <td><t t-esc="dict(val._fields['placement_status'].selection).get(val.placement_status)"/></td>
                                  </tr>
                              </tbody>
                              </table>
                            </div>
                          </div>
                          <div class="tab-pane fade" id="placement_management" role="tabpanel" aria-labelledby="placement-management-tab">
                          </div>
                        </div>
                      </div>
                    </div>
                      <div class="clearfix oe_login_buttons my-4">
                        <a href="/my/home"
                            class="float-end custom_create btn btn-block "
                            style="background-color:#F9D6BF; color: #083B4D">
                            Back To My Profile
                        </a>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>