<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="show_facility_student_template" name="Show Facility Student">
    <t t-call="website.layout">
      <div class="container">
        <div class="alert alert-danger w-10 mx-auto text-center" t-if="error"
          role="alert">
          <strong>
            <t t-esc="error" />
          </strong>
        </div>
        <form
          class="availability"
        >
          <div class="text-center mt-4">
            <h2>Facility Information</h2>
          </div>
          <table class="table table-striped table-bordered shadow-sm mt-5">
            <thead style="background-color:#326434; color: #fff">
              <tr class="text-center">
                <th style="width: 15rem;">Name</th>
                <th>Setting</th>
                <th style="width: 10rem;">Street</th>
                <th style="width: 10rem;">City</th>
                <th style="width: 10rem;">State</th>
                <th>SCCE</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="department_id" t-as="val">
                <td class="text-center">
                  <t t-esc="val.name" />
                </td>
                <td class="text-right">
                  <t t-foreach="val.setting_ids" t-as="setting">
                    <t t-esc="setting_index + 1" />- <span t-esc="setting.name" /><br />
                  </t>
                </td>
                <td class="text-center">
                  <t t-esc="val.street" />
                </td>
                <td class="text-center">
                  <t t-esc="val.city" />
                </td>
                <td class="text-center">
                  <t t-esc="val.state" />
                </td>
                <td class="text-center">
                  <t t-foreach="val.scce_ids" t-as="scce">
                    <t t-esc="scce_index + 1" />- <span t-esc="scce.first_name" />
                                <span
                      t-esc="scce.last_name" /><br />
                  </t>
                </td>
              </tr>
            </tbody>
          </table>
          <div>
            <ul class="nav nav-tabs" id="myTab" role="tablist">
              <li class="nav-item active" role="presentation">
                <button class="nav-link active" id="profile-tab" data-bs-toggle="tab"
                  data-bs-target="#profile" type="button" role="tab" aria-controls="profile"
                  aria-selected="false">SCCE Information</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="ci-information-tab" data-bs-toggle="tab"
                  data-bs-target="#ci_information" type="button" role="tab"
                  aria-controls="ci_information" aria-selected="false">CI Information</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="placement-history-tap" data-bs-toggle="tab"
                  data-bs-target="#placement_history" type="button" role="tab"
                  aria-controls="placement_history" aria-selected="false">Facility Placement History</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="post-placement-managament-tab" data-bs-toggle="tab"
                  data-bs-target="#post_placement_managament" type="button" role="tab"
                  aria-controls="post_placement_managament" aria-selected="false">Post Placement
                  Managament</button>
              </li>
            </ul>
            <div class="tab-content" id="myTabContent">
              <div class="tab-pane fade my-4 show active" id="profile" role="tabpanel"
                aria-labelledby="profile-tab">
                <table class="table table-striped table-bordered shadow-sm text-center my-5">
                  <thead style="background-color:#326434; color: #fff">
                    <tr>
                      <th scope="col">First Name</th>
                      <th scope="col">Last Name</th>
                      <th scope="col">Phone</th>
                      <th scope="col">Email</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="scce_ids" t-as="val">
                      <td>
                        <t t-esc="val.first_name" />
                      </td>
                      <td>
                        <t t-esc="val.last_name" />
                      </td>
                      <td>
                        <t t-esc="val.phone" />
                      </td>
                      <td>
                        <t t-esc="val.email" />
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="tab-pane fade my-4" id="ci_information" role="tabpanel"
                aria-labelledby="ci-information-tab">
                <table class="table table-striped table-bordered shadow-sm text-center my-5">
                  <thead style="background-color:#326434; color: #fff">
                    <tr>
                      <th scope="col">First Name</th>
                      <th scope="col">Last Name</th>
                      <th scope="col">Phone</th>
                      <th scope="col">Email</th>
                      <th scope="col">Ci Details</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="department_id.facility_id.ci_ids" t-as="ci">
                      <td>
                        <span t-field="ci.first_name" />
                      </td>
                      <td>
                        <span t-field="ci.last_name" />
                      </td>
                      <td>
                        <span t-field="ci.phone" />
                      </td>
                      <td>
                        <span t-field="ci.email" />
                      </td>
                      <td>
                        <a class="btn btn-primary" t-att-href="'/my/report/%s?ci_id=%s' % (slug(department_id), ci.id)">
                          CI Details
                          <i class="fa fa-pencil"/>
                        </a>
                      </td>
                    </tr>
                  </tbody>
                </table>
                <t t-call="website_base.add_new_cis"/>
              </div>
              <div class="tab-pane fade my-4" id="placement_history" role="tabpanel"
                aria-labelledby="placement-history-tap">
                <table class="table table-striped table-bordered shadow-sm text-center mt-4">
                  <thead style="background-color:#326434; color: #fff">
                    <tr>
                      <th style="width: 5rem;">#</th>
                      <th>Clinical Experience Type</th>
                      <th>Setting Type</th>
                      <th>Term</th>
                      <th>Year</th>
                      <th>PTSE1</th>
                      <th>PTSE2</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="archive_ids" t-as="val">
                      <td>
                        <t t-esc="val_index + 1" />
                      </td>
                      <td>
                        <t t-esc="val.experience_id.name"/>
                      </td>
                      <td>
                        <t t-esc="dict(val._fields['setting'].selection).get(val.setting)" />
                      </td>
                      <td>
                        <t
                          t-esc="dict(val._fields['placement_term'].selection).get(val.placement_term)" />
                      </td>
                      <td>
                        <t t-esc="val.year" />
                      </td>
                      <td></td>
                      <td></td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="tab-pane fade my-4" id="post_placement_managament" role="tabpanel"
                aria-labelledby="post-placement-managament-tab">
                <table class="table table-striped table-bordered shadow-sm text-center my-5">
                  <thead style="background-color:#326434; color: #fff">
                    <tr>
                      <th scope="col">Student</th>
                      <th scope="col">Campus</th>
                      <th scope="col">Home Address</th>
                      <th scope="col">Name Clinical Education Site</th>
                      <th scope="col">City</th>
                      <th scope="col">State</th>
                      <th scope="col">Clinical Experience Number</th>
                      <th scope="col">Clinical Experience Dates</th>
                      <!-- <th scope="col">Ci Details</th> -->
                      <th scope="col">PTSE 3</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="plcements" t-as="plcement">
                      <td>
                        <span t-field="plcement.student_id" />
                      </td>
                      <td>
                        <span t-field="plcement.campus" />
                      </td>
                      <td>
                        <span t-field="plcement.home_address" />
                      </td>
                      <td>
                        <span t-field="plcement.name_clinical_education_site" />
                      </td>
                      <td>
                        <span t-field="plcement.city" />
                      </td>
                      <td>
                        <span t-field="plcement.state" />
                      </td>
                      <td>
                        <span t-field="plcement.clinical_experience_number" />
                      </td>
                      <td>
                        <span t-field="plcement.clinical_experience_dates" />
                      </td>
                      <td>
                        <a t-if="plcement.stage_type == 'ci_details'" class="btn btn-primary" t-att-href="'/my/report/%s' % plcement.id">
                          CI Details
                          <i class="fa fa-pencil"/>
                        </a>
                        <a t-else="" class="btn btn-primary" t-att-href="'/my/report/%s' % plcement.id">
                          PTSE 3
                        </a>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="clearfix oe_login_buttons my-4">
            <a href="/my/home"
              class="float-end custom_create btn btn-block "
              style="background-color:#326434;color:#fff;">
              Back To My Profile
            </a>
          </div>
        </form>
      </div>
    </t>
  </template>

  <template id="add_new_cis">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#new_ci_modal">Add New CI</button>
    <div class="modal fade" id="new_ci_modal" tabindex="-1" aria-labelledby="add_new_ci" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="add_new_ci">Add New CI</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form t-att-action="'/add/ci/%s' % slug(department_id)" id="ptse-form" class="hardship" method="post" enctype="multipart/form-data">
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-md-6">
                <!-- 











 -->
                <label for="first_name" class="form-label">First Name</label>
                <input type="text" class="form-control" id="first_name" name="first_name" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="last_name" class="form-label">Last Name</label>
                <input type="text" class="form-control" id="last_name" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="entry_level_pt_degree_earned" class="form-label">Entry Level PT Degree Earned</label>
                <input type="text" class="form-control" id="entry_level_pt_degree_earned"/>
              </div>
              <div class="col-md-6">
                <label for="highest_degree_earned" class="form-label">Highest Degree Earned</label>
                <input type="text" class="form-control" id="highest_degree_earned"/>
              </div>
              <div class="col-md-6">
                <label for="degree_area" class="form-label">Degree Area</label>
                <input type="text" class="form-control" id="degree_area"/>
              </div>
              <div class="col-md-6">
                <label for="years_experience_ci" class="form-label">Years Experience CI</label>
                <input type="text" class="form-control" id="years_experience_ci"/>
              </div>
              <div class="col-md-6">
                <label for="years_experience_clinician" class="form-label">Years Experience Clinician</label>
                <input type="text" class="form-control" id="years_experience_clinician"/>
              </div>
              <div class="col-md-6">
                <label for="areas_expertise" class="form-label">Areas Expertise</label>
                <input type="text" class="form-control" id="areas_expertise" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="clinical_certification" class="form-label">Clinical Certification</label>
                <input type="text" class="form-control" id="clinical_certification"/>
              </div>
              <div class="col-md-6">
                <label for="specify_area" class="form-label">Specify Area</label>
                <input type="text" class="form-control" id="specify_area"/>
              </div>
              <div class="col-md-6">
                <label for="apta_credentialed_ci" class="form-label">Apta Credentialed CI</label>
                <input type="text" class="form-control" id="apta_credentialed_ci"/>
              </div>
              <div class="col-md-6">
                <label for="other_ci_credential" class="form-label">Other CI Credential</label>
                <input type="text" class="form-control" id="other_ci_credential"/>
              </div>
              <div class="col-md-6">
                <label for="professional_organization_membership" class="form-label">Professional Organization Membership</label>
                <input type="text" class="form-control" id="professional_organization_membership"/>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button class="btn btn-primary" type="submit">Save</button>
          </div>
        </form>
        </div>
      </div>
    </div>
  </template>
</odoo>