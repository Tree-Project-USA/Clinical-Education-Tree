<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="show_facility_student_template" name="Show Facility Student">
    <t t-call="website.layout">
      <div class="container">
        <div class="alert alert-danger w-10 mx-auto text-center" t-if="error"
          role="alert">
          <strong>
            <t t-esc="error" />
          </strong>
        </div>
        <div
          class="availability"
        >
          <div class="text-center mt-4" style="color: #083B4D;">
            <h1>Facility Information</h1>
          </div>
          <div class="table-responsive">
            <table class="table table-striped table-bordered shadow-sm mt-5">
              <thead style="background-color:#F9D6BF; color: #083B4D">
                <tr class="text-center">
                  <th style="width: 15rem;">Name</th>
                  <th>Setting</th>
                  <th style="width: 10rem;">Street</th>
                  <th style="width: 10rem;">City</th>
                  <th style="width: 10rem;">State</th>
                </tr>
              </thead>
              <tbody>
                <tr t-foreach="department_id" t-as="val">
                  <td class="text-center">
                    <t t-esc="val.name" />
                  </td>
                  <td class="text-right">
                    <t t-foreach="val.setting_ids" t-as="setting">
                      <t t-esc="setting_index + 1" />- <span t-esc="setting.name" /><br />
                    </t>
                  </td>
                  <td class="text-center">
                    <t t-esc="val.street" />
                  </td>
                  <td class="text-center">
                    <t t-esc="val.city" />
                  </td>
                  <td class="text-center">
                    <t t-esc="val.state" />
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div>
            <ul class="nav nav-tabs" id="myTab" role="tablist">
              <li class="nav-item active" role="presentation">
                <button class="nav-link mx-1 my-1 active" id="profile-tab" data-bs-toggle="tab"
                  data-bs-target="#profile" type="button" role="tab" aria-controls="profile"
                  aria-selected="false">SCCE Information</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link mx-1 my-1" id="placement-history-tap" data-bs-toggle="tab"
                  data-bs-target="#placement_history" type="button" role="tab"
                  aria-controls="placement_history" aria-selected="false">Facility Placement History</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link mx-1 my-1" id="post-placement-managament-tab" data-bs-toggle="tab"
                  data-bs-target="#post_placement_managament" type="button" role="tab"
                  aria-controls="post_placement_managament" aria-selected="false">Post Placement
                  Managament</button>
              </li>
            </ul>
            <div class="tab-content" id="myTabContent">
              <div class="tab-pane fade my-4 show active" id="profile" role="tabpanel"
                aria-labelledby="profile-tab">
                <div class="table-responsive">
                  <table class="table table-striped table-bordered shadow-sm text-center my-5">
                    <thead style="background-color:#F9D6BF; color: #083B4D">
                      <tr>
                        <th scope="col">First Name</th>
                        <th scope="col">Last Name</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Email</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr t-foreach="scce_ids" t-as="val">
                        <td>
                          <t t-esc="val.first_name" />
                        </td>
                        <td>
                          <t t-esc="val.last_name" />
                        </td>
                        <td>
                          <t t-esc="val.phone" />
                        </td>
                        <td>
                          <t t-esc="val.email" />
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="tab-pane fade my-4" id="placement_history" role="tabpanel"
                aria-labelledby="placement-history-tap">
                <div class="table-responsive">
                  <table class="table table-striped table-bordered shadow-sm text-center mt-4">
                    <thead style="background-color:#F9D6BF; color: #083B4D">
                      <tr>
                        <th style="width: 5rem;">#</th>
                        <th>Clinical Experience Type</th>
                        <th>Setting Type</th>
                        <th>Term</th>
                        <th>Year</th>
                        <th>PTSE1</th>
                        <th>PTSE2</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr t-foreach="archive_ids" t-as="val">
                        <td>
                          <t t-esc="val_index + 1" />
                        </td>
                        <td>
                          <t t-esc="val.experience_id.name"/>
                        </td>
                        <td>
                          <t t-esc="dict(val._fields['setting'].selection).get(val.setting)" />
                        </td>
                        <td>
                          <t
                            t-esc="dict(val._fields['placement_term'].selection).get(val.placement_term)" />
                        </td>
                        <td>
                          <t t-esc="val.year" />
                        </td>
                        <td></td>
                        <td></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="tab-pane fade my-4" id="post_placement_managament" role="tabpanel"
                aria-labelledby="post-placement-managament-tab">
                <div class="table-responsive">
                  <table class="table table-striped table-bordered shadow-sm text-center my-5">
                    <thead style="background-color:#F9D6BF; color: #083B4D">
                      <tr>
                        <th scope="col">CI Name</th>
                        <th scope="col">CI Details</th>
                        <th scope="col">PTSE 1</th>
                        <th scope="col">PTSE 2</th>
                        <th scope="col">PTSE 3</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr t-foreach="post_plcements" t-as="plcement">
                        <t t-set="ptse_1_survey" t-value="plcement.archive_id.experience_id.ptse_1_survey"/>
                        <t t-set="ptse_2_survey" t-value="plcement.archive_id.experience_id.ptse_2_survey"/>
                        <t t-set="user_input_1" t-value="ptse_1_survey.mapped('user_input_ids').search([
                        ('partner_id', '=', request.env.user.partner_id.id),
                        ('state', '=', 'done'),
                        ('survey_id', '=', ptse_1_survey.id)
                        ])"/>
                        <t t-set="user_input_2" t-value="ptse_2_survey.mapped('user_input_ids').search([
                        ('partner_id', '=', request.env.user.partner_id.id),
                        ('state', '=', 'done'),
                        ('survey_id', '=', ptse_2_survey.id)
                        ])"/>
                        
                        <td>
                          <span t-field="plcement.ci_id" />
                        </td>
                        <td>
                          <a t-if="not plcement.ptse_3_id" class="btn btn-primary" t-att-href="'/student/details/%s' % (plcement.id)">
                            Submit
                            </a>
                            <a t-else="" class="nav-link" t-att-href="'/ci/details/%s' % (plcement.ptse_3_id.id)">
                              View
                                <i class="fa fa-eye mx-2"/>
                            </a>
                            
                        </td>
                        <td>
                          <a t-if="not ptse_1_survey">
                            - 
                          </a>
                            <a t-elif="not plcement.ptse_1 and not user_input_1" class="btn btn-primary" t-attf-href="/survey/start/#{ptse_1_survey.access_token}">
                              Submit
                              <i class="fa fa-pencil"></i>
                            </a>
                            <a t-else="" class="nav-link" t-attf-href="/survey/print/#{ptse_1_survey.access_token}?answer_token=#{user_input_1.access_token}">
                             View
                             <i class="fa fa-eye mx-2"/>
                            </a>
                        </td>
                        <td>
                          <a t-if="not ptse_2_survey">
                            - 
                          </a>
                          <a t-elif="not plcement.ptse_2 and not user_input_2" class="btn btn-primary" t-attf-href="/survey/start/#{ptse_2_survey.access_token}?plcement=#{plcement.id}">
                            Submit 
                            <i class="fa fa-pencil"></i>
                          </a>
                          <a t-else="" class="nav-link" t-attf-href="/survey/print/#{ptse_2_survey.access_token}?answer_token=#{user_input_2.access_token}">
                            View
                             <i class="fa fa-eye mx-2"/>
                          </a>
                        </td>
                        <td>
                          <a t-if="plcement.ptse_3_id"  t-att-href="'/ci/details/%s' % (plcement.ptse_3_id.id)">
                            View
                            <i class="fa fa-eye mx-2"/>
                            </a>
                            <span t-else="">-</span>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
          <div class="clearfix oe_login_buttons my-4">
            <a href="/my/home"
              class="float-end custom_create btn btn-block "
              style="background-color:#F9D6BF; color: #083B4D">
              Back To My Profile
            </a>
          </div>
        </div>
      </div>
    </t>
  </template>

  <template id="add_new_cis">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#new_ci_modal">Add New CI</button>
    <div class="modal fade" id="new_ci_modal" tabindex="-1" aria-labelledby="add_new_ci" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="add_new_ci">Add New CI</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <form t-att-action="'/add/ci/%s' % (department_id.id)"  method="post" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-md-6">
                <label for="first_name" class="form-label">First Name</label>
                <input type="text" class="form-control" id="first_name" name="first_name" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="last_name" class="form-label">Last Name</label>
                <input type="text" class="form-control" id="last_name" name="last_name" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="entry_level_pt_degree_earned" class="form-label">Entry Level PT Degree Earned</label>
                <input type="text" class="form-control" id="entry_level_pt_degree_earned" name="entry_level_pt_degree_earned" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="highest_degree_earned" class="form-label">Highest Degree Earned</label>
                <input type="text" class="form-control" id="highest_degree_earned" name="highest_degree_earned" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="degree_area" class="form-label">Degree Area</label>
                <input type="text" class="form-control" id="degree_area" name="degree_area" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="years_experience_ci" class="form-label">Years Experience CI</label>
                <input type="text" class="form-control" id="years_experience_ci" name="years_experience_ci" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="years_experience_clinician" class="form-label">Years Experience Clinician</label>
                <input type="text" class="form-control" id="years_experience_clinician" name="years_experience_clinician" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="areas_expertise" class="form-label">Areas Expertise</label>
                <input type="text" class="form-control" id="areas_expertise" name="areas_expertise" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="clinical_certification" class="form-label">Clinical Certification</label>
                <input type="text" class="form-control" id="clinical_certification" name="clinical_certification" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="specify_area" class="form-label">Specify Area</label>
                <input type="text" class="form-control" id="specify_area" name="specify_area" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="apta_credentialed_ci" class="form-label">Apta Credentialed CI</label>
                <input type="text" class="form-control" id="apta_credentialed_ci" name="apta_credentialed_ci" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="other_ci_credential" class="form-label">Other CI Credential</label>
                <input type="text" class="form-control" id="other_ci_credential" name="other_ci_credential" required="required"/>
              </div>
              <div class="col-md-6">
                <label for="professional_organization_membership" class="form-label">Professional Organization Membership</label>
                <input type="text" class="form-control" id="professional_organization_membership" name="professional_organization_membership" required="required"/>
              </div>
            </div>
            <div class="modal-footer">
              <button class="btn btn-primary" type="submit">Submit</button>
            </div>
          </form>
          </div>
        </div>
      </div>
    </div>
  </template>
</odoo>