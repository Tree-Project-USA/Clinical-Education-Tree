<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="locations_students_template" name="Locations Students Template">
        <t t-call="website.layout">
            <!-- <div class="spinner"></div> -->
            <div class="container">
                <div class="loading-indicator text-center"
                     style="display: flex;flex-direction: column;align-items: center;justify-content: center;height: 90vh;">
                    <div class="spinner-border" style ="width:15vh; height:15vh; color:#1F8E93" role="status">
                        <span class="visually-hidden"></span>
                    </div>
                </div>
            </div>
          <div id="form_temp" class="locations_student d-none">
            <t
                t-set="hardship_request"
                t-value="request.env['hardship.request'].sudo().search([('student_id', '=', request.env.user.partner_id.id)])"
            />
                <div class="alert alert-success text-center shadow-sm" t-if="hardship_request.state == 'update'">
                    <div class="d-flex justify-content-center">
                        <p>
                            Your hardship information need to be updated
                        </p>
                        <a class="mx-2" href="/update/hardship/request">here</a>
                    </div>
                </div>
                <div id="wrap" class="oe_structure oe_empty my-4">
                    <div class="alert alert-danger w-10 mx-auto text-center" t-if="error"
                        role="alert">
                        <strong>
                            <t t-esc="error" />
                        </strong>
                    </div>
                    <div class="zip_code_error alert alert-danger w-10 mx-auto text-center d-none"
                        role="alert">
                        <strong>
                            You cannot duplicate the zip code.
                        </strong>
                    </div>
                    <div class="container">
                        <input type="hidden" name="len_course" t-att-value="rw" />
                        <form
                            action="/add/location"
                            method="post"
                            enctype="multipart/form-data"
                        >
                            <input type="hidden" name="csrf_token"
                                t-att-value="request.csrf_token()" />
                            <input type="hidden" name="list_zip_code" id="list_zip_code"/>  
                            
                            <div class="row mt-4">
                                <div>
                                    <table class="table table-borderless mt-3 total_project_costs">
                                        <thead>
                                            <tr>
                                                <td>
                                                    <strong>
                                                        #
                                                    </strong>
                                                </td>
                                                <td>
                                                    <strong>
                                                        Zip code
                                                    </strong>
                                                </td>
                                                <td>
                                                    <strong>
                                                        State
                                                    </strong>
                                                </td>
                                                <td>
                                                    <strong>
                                                        City
                                                    </strong>
                                                </td>
                                            </tr>
                                        </thead>
                                        <div class="collapse">
                                            <tbody id="locations_zip_code">
                                                <input type="hidden" t-att-value="rw" name="variable" id="variable" />  
                                                <input type="hidden" t-att-value="locations_zips" name="locations_zip" id="locations_zip" />  
                                                
                                            </tbody>
                                        </div>
                                    </table>
                                </div>
                            </div>
                            <div class="clearfix oe_login_buttons mt-4">
                                <button type="submit"
                                    class="custom_create btn btn-block"
                                    style="background-color:#ab8631;color:#fff;">
                                    Submit
                                </button>
                                <a href="/my/home"
                                    class="float-end custom_create btn btn-block"
                                    style="background-color:#ab8631;color:#fff;">
                                    Back
                                </a>
                            </div>
                            <div class="float-end">
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>