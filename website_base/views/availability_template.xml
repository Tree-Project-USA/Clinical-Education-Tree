<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="availability_template" name="Availability">
        <t t-call="website.layout">
            <div class="container">
                <form
                t-att-action="'/submit/availability/%s' % (facility_id.id)"
                    class="availability"
                    method="post"
                    enctype="multipart/form-data"
                >
                <input type="hidden" name="csrf_token"
                    t-att-value="request.csrf_token()" />
                <input type="hidden" name="facility_id"
                    t-att-value="facility_id.id" />
                    <div class="row mt-4">
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">Facility Name</label>
                                <div>
                                    <input
                                        type="text"
                                        id="facility_name"
                                        class="form-control"
                                        name="facility_name"
                                        t-att-value="facility_id.name"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">University</label>
                                <div>
                                    <input
                                        type="text"
                                        id="university"
                                        class="form-control"
                                        name="university"
                                        t-att-value="company_id.name"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="row">
                                <label class="col-form-label" for="placement_term">Term</label>
                                <select
                                    class="form-select"
                                    name="placement_term"
                                    required="required"
                                >
                                    <option
                                        value=""
                                        selected="selected"
                                        disabled="1">
                                        select...
                                    </option>
                                    <option
                                        name='placement_term'
                                        value="fall"
                                        id="placement_term"
                                    >
                                        FALL
                                    </option>
                                    <option
                                        name='placement_term'
                                        value="spring"
                                        id="placement_term"
                                    >
                                        SPRING
                                    </option>
                                    <option
                                        name='placement_term'
                                        value="summer"
                                        id="placement_term"
                                    >
                                        SUMMER
                                    </option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-4">
                            <div class="row">
                                <label for="staticEmail" class="col-form-label">Year</label>
                                <select
                                    class="form-select"
                                    name="term"
                                    required="required"
                                >
                                <option
                                    value=""
                                    selected="selected"
                                    disabled="1">
                                    select...
                                </option>
                                <t t-foreach="SELECTION_YEAR_RANGE" t-as="nationality">
                                    <option
                                    t-att-value="nationality[1]"
                                    >
                                    <t t-esc="nationality[1]" />
                                    </option>
                                </t>
                                </select>
  
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="row">
                                <label for="staticEmail" class="col-form-label">CE Type</label>
                                <select
                                    class="form-select"
                                    name="placement_type"
                                    required="required"
                                >
                                    <option
                                        value=""
                                        selected="selected"
                                        disabled="1">
                                        select...
                                    </option>
                                    <option
                                        name='placement_type'
                                        value="ice"
                                        id="placement_type"
                                    >
                                        ICE
                                    </option>
                                    <option
                                        name='placement_type'
                                        value="tce"
                                        id="placement_type"
                                    >
                                        TCE I
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">CE Date</label>
                                <div>
                                    <input
                                        type="text"
                                        id="first_name"
                                        class="form-control"
                                        name="first_name"
                                        t-att-value=""
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">Availability</label>
                                <div>
                                    <input
                                        type="text"
                                        id="offers"
                                        class="form-control"
                                        name="offers"
                                        t-att-value=""
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">Setting</label>
                                <select
                                    class="form-select"
                                    name="setting"
                                    required="required"
                                >
                                    <option
                                        value=""
                                        selected="selected"
                                        disabled="1">
                                        select...
                                    </option>
                                    <option
                                        name='setting'
                                        value="ip"
                                        id="setting"
                                    >
                                        IP
                                    </option>
                                    <option
                                        name='setting'
                                        value="op"
                                        id="setting"
                                    >
                                        OP
                                    </option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix oe_login_buttons mt-4">
                        <button type="submit"
                            class="custom_create btn btn-block"
                            style="background-color:#ab8631;color:#fff;">
                            Submit
                        </button>
                        <a href="/my/home"
                            class="float-end custom_create btn btn-block "
                            style="background-color:#ab8631;color:#fff;">
                            Back To My Profile
                        </a>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>