<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="availability_template" name="Availability">
        <t t-call="website.layout">
            <div class="container">
                <div class="loading-indicator text-center"
                    style="display: flex;flex-direction: column;align-items: center;justify-content: center;height: 90vh;">
                    <div class="spinner-border" style="width:15vh; height:15vh; color:#326434"
                        role="status">
                        <span class="visually-hidden"></span>
                    </div>
                </div>
            </div>
            <div class="container pt24 pb24">
                <form
                  action="/submit/availability"
                  class="d-none availability"
                  method="post"
                  enctype="multipart/form-data"
                >
                <input type="hidden" name="csrf_token"
                    t-att-value="request.csrf_token()" />
                    <input type="hidden" name="len_department" value="1" />
                    <input type="hidden" name="line_department_list" value="" />
                    <input type="hidden" name="placement_term_list" value="" />
                    <input type="hidden" name="experience_id_list" value="" />
                    <div class="row">
                      <div class="col-lg-4 col-12">
                          <label for="staticEmail" class="col-form-label">Program</label>
                          <select name="company_id" 
                              id="company_id"
                              class="form-control col-xl-12 custom-select" required="required">
                              <option  value="" selected="selected">select</option>
                              <t t-foreach="company_ids" t-as="company">
                                <option  t-att-value="company.id">
                                  <t t-esc="company.name"/>
                                </option>
                              </t>
                          </select>
                          <div class="invalid-feedback">
                            Please provide a valid Program.
                        </div>
                      </div>
                      <div class="col-lg-4 col-12">
                      <label for="staticEmail" class="col-form-label">Location</label>
                          <div>
                              <a 
                                  class="btn btn-primary" 
                                  type="button" 
                                  data-bs-toggle="modal"
                                  data-bs-target="#modal_department"
                              >
                                  Show Location
                              </a>
                          </div>
                          <div class="invalid-feedback">
                            Please provide a valid First Name CI.
                        </div>
                          <div class="modal fade update_ci_information" id="modal_department"
                              tabindex="-1" aria-hidden="true">
                              <div class="modal-dialog modal-xl">
                                  <div class="modal-content">
                                      <div class="modal-header">
                                      <h5 class="modal-title" id="exampleModalLabel">Locations</h5>
                                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      
                                      <div class="modal-body">
                                      <!-- <div class="row" t-foreach="val.line_ids" t-as="line"> -->
                                          <table class="table table-striped table-bordered shadow-sm text-center mt-5">
                                              <thead>
                                                  <tr>
                                                      <th>Location</th>
                                                      <th>Street</th>
                                                      <th>State</th>
                                                      <th>City</th>
                                                      <th>Number</th>
                                                  </tr>
                                              </thead>
                                              <tbody id="table_body">
                                              </tbody>
                                          </table>
                                      <!-- </div> -->
                                  </div>
                              </div>
                          </div>
                      </div>
                      </div>
                      <div class="col-lg-4 col-12">
                        <label for="staticEmail" class="col-form-label">Offer Setting Type</label>
                        <select name="setting"  
                        class="form-control col-xl-12 custom-select setting" required="required">
                            <option  value="" selected="selected">select</option>
                            <option  value="op">OP</option>
                            <option value="ip">IP</option>
                        </select>
                        <div class="invalid-feedback">
                            Please provide a valid Offer Setting Type.
                        </div>
                    </div>
                      <div class="col-lg-6 col-12">
                          <label for="staticEmail" class="col-form-label">Year</label>
                          <select name="year_term" 
                              id="year_term"
                              class="form-control col-xl-12 custom-select experience_id" required="required">
                              <option  value="" selected="selected">select</option>
                              <t t-foreach="SELECTION_YEAR_RANGE" t-as="year">
                                <option  t-att-value="year['id']">
                                  <t t-esc="year['id']"/>
                                </option>
                                
                              </t>
                          </select>
                          <div class="invalid-feedback">
                            Please provide a valid Year.
                        </div>
                      </div>
                      <div class="col-lg-6 col-12">
                        <label for="staticEmail" class="col-form-label ">Term</label>
                        <select name="placement_term"
                        id="placement_term" multiple="multiple"  
                        class="form-control col-xl-12 custom-select placement_term" required="required">
                            <option value="fall">FALL</option>
                            <option value="spring">SPRING</option>
                            <option value="summer">SUMMER</option>
                        </select>
                        <div class="invalid-feedback">
                            Please provide a valid Term.
                        </div>
                    </div>
                  </div>
                  <div class="row mt-4">
                      <div class="col-lg-6 col-12">
                          <label for="staticEmail" class="col-form-label">CE Type</label>
                          <select name="experience_id" 
                            multiple="multiple"
                              id="experience_id"
                              class="form-control col-xl-12 custom-select experience_id" required="required">
                          </select>
                          <div class="invalid-feedback">
                            Please provide a valid First Name CI.
                        </div>
                      </div>
                  </div>
                    <div class="clearfix oe_login_buttons mt-4">
                        <button type="button"
                            class="custom_create btn btn-block" id="submit-offers"
                            style="background-color:#326434;color:#fff;">
                            Submit
                        </button>
                        <a href="/my/home"
                            class="float-end custom_create btn btn-block "
                            style="background-color:#326434;color:#fff;">
                            Back To My Profile
                        </a>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>