<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="availability_template" name="Availability">
        <t t-call="website.layout">
            <div class="container">
                <form
                  action="/submit/availability"
                  class="availability"
                  method="post"
                  enctype="multipart/form-data"
                >
                <input type="hidden" name="csrf_token"
                    t-att-value="request.csrf_token()" />
                    <input type="hidden" name="len_department" value="1" />
                    <div class="row mt-4">
                        <div>
                            <table class="table add_file table-bordered">
                              <thead>
                                <tr>
                                    <th style="width: 20rem" class="text-center">University</th>
                                    <th style="width: 20rem" class="text-center">Department</th>
                                    <th class="text-center">CE Type</th>
                                    <th class="text-center">Term</th>
                                    <th class="text-center">Year</th>
                                    <th class="text-center">Offer Setting Type</th>
                                    <th class="text-center">Number of Offers</th>
                                    <th class="text-center"></th>
                                </tr>
                              </thead>
                              <tbody id="add_department">
                                
                              </tbody>
                            
                              <tfooter>
                                <tr>
                                  <td colspan="7">
                                    <a 
                                      id="add_departments" 
                                      class="btn m-2"
                                      style="background-color:#ab8631;color:#fff;" 
                                    >
                                      <h6>Add Department</h6>
                                    </a>
                                  </td>
                                </tr>
                              </tfooter>
                            </table>
                        </div>
                    </div>
                    <div class="clearfix oe_login_buttons mt-4">
                        <button type="submit"
                            class="custom_create btn btn-block"
                            style="background-color:#ab8631;color:#fff;">
                            Submit
                        </button>
                        <a href="/my/home"
                            class="float-end custom_create btn btn-block "
                            style="background-color:#ab8631;color:#fff;">
                            Back To My Profile
                        </a>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>