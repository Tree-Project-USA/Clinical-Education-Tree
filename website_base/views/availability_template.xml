<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="availability_template" name="Availability">
        <t t-call="website.layout">
            <div class="container">
                <form
                    action="/submit/availability"
                    class="availability"
                    method="post"
                    enctype="multipart/form-data"
                >
                    <t t-esc="facility_id.name" />
                    <div class="row mt-4">
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">Facility Name</label>
                                <div>
                                    <input
                                        type="text"
                                        id="facility_name"
                                        class="form-control"
                                        name="facility_name"
                                        t-att-value="facility_id.name"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">University</label>
                                <div>
                                    <input
                                        type="text"
                                        id="university"
                                        class="form-control"
                                        name="university"
                                        t-att-value="company_id.name"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <!-- <select class="form-select" aria-label="Default select example">
                                <option>Open this select menu</option>
                                <option value="1">One</option>
                                <option value="2">Two</option>
                                <option value="3">Three</option>
                              </select> -->
                            <div>
                                <div>
                                    <label class="required" for="placement_term">Term</label>
                                    <select
                                        class="form-select"
                                        name="term"
                                    >
                                        <option
                                            name='placement_term'
                                            value="fall"
                                            id="placement_term"
                                        >
                                            FALL
                                        </option>
                                        <option
                                            name='placement_term'
                                            value="spring"
                                            id="placement_term"
                                        >
                                            SPRING
                                        </option>
                                        <option
                                            name='placement_term'
                                            value="summer"
                                            id="placement_term"
                                        >
                                            SUMMER
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-4">
                            <div class="row">
                                <label for="staticEmail" class="col-form-label">Year</label>
                                <select
                                        class="form-select"
                                        name="term"
                                    >
                                    <option
                                        value=""
                                        selected="selected"
                                        disabled="1">
                                        select...
                                    </option>
                                    <t t-foreach="SELECTION_YEAR_RANGE" t-as="nationality">
                                        <option
                                        t-att-value="nationality.index"
                                        >
                                        <t t-esc="nationality.index" />
                                        </option>
                                    </t>
                                    </select>
                                <div>
                                    <input
                                        type="text"
                                        id="first_name"
                                        class="form-control"
                                        name="first_name"
                                        t-att-value="SELECTION_YEAR_RANGE"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">CE Type</label>
                                <div>
                                    <input
                                        type="text"
                                        id="first_name"
                                        class="form-control"
                                        name="first_name"
                                        t-att-value="facility_id.name"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">CE Date</label>
                                <div>
                                    <input
                                        type="text"
                                        id="first_name"
                                        class="form-control"
                                        name="first_name"
                                        t-att-value="facility_id.name"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">Availability</label>
                                <div>
                                    <input
                                        type="text"
                                        id="first_name"
                                        class="form-control"
                                        name="first_name"
                                        t-att-value="facility_id.name"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">Setting</label>
                                <div>
                                    <input
                                        type="text"
                                        id="first_name"
                                        class="form-control"
                                        name="first_name"
                                        t-att-value="facility_id.name"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group row">
                                <label for="staticEmail" class="col-form-label">Assigned Student/s</label>
                                <div>
                                    <input
                                        type="text"
                                        id="first_name"
                                        class="form-control"
                                        name="first_name"
                                        t-att-value="facility_id.name"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
