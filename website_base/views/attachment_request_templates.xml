<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="attachment_request_template" name="Attachment Request">
        <t t-call="website.layout">
            <div id="form_temp_attachment_request">
                <div id="wrap" class="oe_structure oe_empty my-4">
                    <div class="container">
                        <form  
                            action="/create/attachment/request" 
                            method="post"
                            enctype="multipart/form-data"
                        >
                        <div t-if="hardship_form_attachment" class="modal fade" id="download_attachment" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                          </div>
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="len_attachment" value="1" />
                            <input type="hidden" name="len_scce_attachment" value="1" />
                            <div class="row mt-4">
                                <div>
                                  <div class="attachment_request">
                                    <table class="table add_attachment table-bordered">
                                      <thead>
                                        <tr>
                                          <th class="text-center" colspan="4">Required Attachment</th>
                                        </tr>
                                        <tr>
                                            <th>Attachment Type</th>
                                            <th>Expiration Date</th>
                                            <th>Attachment</th>
                                            <th class="text-center" />
                                        </tr>
                                      </thead>
                                      <tbody id="add_attachment">
                                        
                                      </tbody>
                                    
                                      <tfooter>
                                        <tr>
                                          <td colspan="4">
                                            <a 
                                              id="add_attachments" 
                                              class="btn m-2"
                                              style="background-color:#F9D6BF; color: #083B4D" 
                                            >
                                              <h6>Add Attachment</h6>
                                            </a>
                                          </td>
                                        </tr>
                                      </tfooter>
                                    </table>
                                  </div>
                                  <div class="scce_attachment_request">
                                    <table class="table add_attachment table-bordered">
                                      <thead>
                                        <tr>
                                          <th class="text-center" colspan="4">
                                            SCCE Required Attachment
                                          </th>
                                        </tr>
                                        <tr>
                                            <th>Attachment Type</th>
                                            <th>Expiration Date</th>
                                            <th>Attachment</th>
                                            <th class="text-center" />
                                        </tr>
                                      </thead>
                                      <tbody id="add_scce_attachment">
                                        
                                      </tbody>
                                    
                                      <tfooter>
                                        <tr>
                                          <td colspan="4">
                                            <a 
                                              id="add_scce_attachments" 
                                              class="btn m-2">
                                              <h6>Add Attachment</h6>
                                            </a>
                                          </td>
                                        </tr>
                                      </tfooter>
                                    </table>
                                  </div>
                                </div>
                            </div>
                          <div class="clearfix oe_login_buttons mt-4">
                              <button type="submit"
                                      class="custom_create btn btn-block">
                                  Submit
                              </button>
                              <a href="/my/home"
                                    class="float-end custom_create btn btn-block ">
                                    Back To My Profile
                                </a>
                          </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>