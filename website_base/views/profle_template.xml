<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="user_profile_templates" name="User Information">

<!-- ================================================================ user_information ===================================================================== -->
      <t t-call="website.layout">
        <div class="delegate_profile">
          <div class="container">
              <div class="row mt-4">
                <div class="col-12">
                  <div class="text-center mb-4 mt-2">
                    <h3>User Information</h3>
                  </div>
                  <div class="text-center">
                    <img
                      t-if="partner.image_1920"
                      t-att-src="image_data_uri(partner.image_1920)"
                      class="img img-fluid rounded-circle o_wblog_author_avatar mr-1"
                      loading="lazy"
                      style="width: 12rem; height:12rem;"
                    />
                    <img
                      t-else=""
                      src="/website_base/static/src/img/blank-profile-picture.jpg"
                      class="img img-fluid rounded-circle o_wblog_author_avatar mr-1"
                      loading="lazy"
                      style="width: 12rem; height:12rem;"
                  />
                  </div>
                </div>
              </div>
              <div class="row mt-4">
                <div class="col-lg-6 col-12">
                    <label for="name">Name</label>
                    <div class="form-group mt-1" style="background-color: #e0e0e0;
                    padding: 0.5rem;
                    color: #4b4a4a;
                    border-bottom: 2px solid #716d6d;">
                      <span t-field="partner.name" />
                    </div>
                </div>
                <div class="col-lg-6 col-12">
                    <label for="first_name">First name</label>
                    <div class="form-group mt-1" style="background-color: #e0e0e0;
                    padding: 0.5rem;
                    color: #4b4a4a;
                    border-bottom: 2px solid #716d6d;">
                    <span t-field="partner.first_name" />
                        <!-- <input
                        type="text"
                        id="first_name"
                        name="first_name"
                        class="form-control"
                        required="required"
                        placeholder="first_name"
                        readonly="1"
                        t-att-value="partner.first_name"
                        /> -->
                    </div>
                </div>
              </div>
              <div class="row mt-4">
                <div class="col-lg-6 col-12">
                  <label for="last_name">Last name</label>
                  <div class="form-group mt-1" style="background-color: #e0e0e0;
                  padding: 0.5rem;
                  color: #4b4a4a;
                  border-bottom: 2px solid #716d6d;">
                  <span t-field="partner.last_name" />
                      <!-- <input
                      type="text"
                      id="last_name"
                      name="last_name"
                      required="required"
                      class="form-control"
                      placeholder="last_name"
                      readonly="1"
                      t-att-value="partner.last_name"
                      /> -->
                  </div>
                </div>
                <div class="col-lg-6 col-12">
                  <label for="phone">Phone</label>
                  <div class="form-group mt-1" style="background-color: #e0e0e0;
                  padding: 0.5rem;
                  color: #4b4a4a;
                  border-bottom: 2px solid #716d6d;">
                  <span t-field="partner.phone" />
                      <!-- <input
                      type="text"
                      id="phone"
                      name="phone"
                      class="form-control"
                      required="required"
                      placeholder="phone"
                      readonly="1"
                      t-att-value="partner.phone"
                      /> -->
                  </div>
                </div>
              </div>
              <div class="row mt-4">
                <div class="col-lg-6 col-12">
                  <label for="email">Email</label>
                  <div class="form-group mt-1" style="background-color: #e0e0e0;
                  padding: 0.5rem;
                  color: #4b4a4a;
                  border-bottom: 2px solid #716d6d;">
                  <span t-field="partner.email" />
                      <!-- <input
                      type="text"
                      id="email"
                      name="email"
                      class="form-control"
                      required="required"
                      placeholder="email"
                      readonly="1"
                      t-att-value="partner.email"
                      /> -->
                  </div>
                </div>
                <div class="col-lg-6 col-12">
                  <label for="home_address">Home address</label>
                  <div class="form-group mt-1" style="background-color: #e0e0e0;
                  padding: 0.5rem;
                  color: #4b4a4a;
                  border-bottom: 2px solid #716d6d;">
                  <span t-field="partner.home_address" />
                      <!-- <input
                      type="text"
                      id="home_address"
                      name="home_address"
                      class="form-control"
                      required="required"
                      placeholder="home_address"
                      readonly="1"
                      t-att-value="partner.home_address"
                      /> -->
                  </div>
                </div>
              </div>
              <div class="row mt-4 mb-4 text-center">
                <div class="col-12 mr-2">
                  <a
                    t-if="partner.is_reach_maximum_zip_code == False"
                    type="button"
                    class="btn"
                    role="button" 
                    href="/my/account"
                    style="background-color:  #ab8631; !important; color: #fff"
                  >
                    <i class="fa fa-pencil"/> Add Location 
                  </a>
                  <a
                    t-if="partner.is_reach_maximum_zip_code == True"
                    type="button"
                    class="btn"
                    role="button" 
                    href="/info/hardship/request"
                    style="background-color:  #ab8631; !important; color: #fff"
                  >
                    Show your Location 
                  </a>
                </div>
              </div>
          </div>
        </div>
      </t>
  </template>
</odoo>
