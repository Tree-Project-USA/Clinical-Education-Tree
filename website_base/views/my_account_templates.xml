<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_details" name="portal My Details">
        <t t-call="website.layout">
            <t t-set="additional_title">Contact Details</t>
            <div class="container oe_website_sale">
                <form action="/my/account" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="row">
                        <t t-set="partner_can_edit_vat" t-value="partner.can_edit_vat()"/>
                        <div class="col-lg-12">
                            <div t-if="error_message" class="alert alert-danger" role="alert">
                                <t t-foreach="error_message" t-as="err">
                                    <t t-esc="err"/>
                                    <br />
                                </t>
                            </div>
                            <div t-if="success" class="alert alert-success" role="alert">
                                <t t-esc="success"/>
                            </div>
                        </div>
                        <div t-attf-class="form-group col-lg-12">
                            <label class="col-form-label" for="name">Name</label>
                            <input 
                                    type="text" 
                                    name="name" 
                                    t-attf-class="form-control" 
                                    t-att-value="name or partner.name"
                                />
                        </div>
                        <div t-attf-class="form-group col-lg-6">
                            <label class="col-form-label" for="email">Email</label>
                            <input 
                                    type="email" 
                                    name="email" 
                                    t-attf-class="form-control" 
                                    t-att-value="email or partner.email" 
                                />
                        </div>
                        <div t-attf-class="form-group col-lg-6">
                            <label class="col-form-label" for="mobile">Mobile</label>
                            <div class="input-group mb-2">
                                <input 
                                    type="text" 
                                    id="mobile" 
                                    name="mobile" 
                                    required="required"
                                    maxlength="9" 
                                    t-attf-class="form-control" 
                                    t-att-value="partner.mobile" 
                                    />
                            </div>
                        </div>
                        <div class="clearfix" />
                        <div t-attf-class="form-group col-lg-6">
                            <label class="col-form-label" for="country_id">Country</label>
                            <select name="country_id" t-attf-class="form-control">
                                <t t-foreach="countries or []" t-as="country">
                                    <option 
                                            t-att-value="country.id" 
                                            t-att-selected="country.id == int(country_id) if country_id else country.id == partner.country_id.id"
                                        >
                                        <t t-esc="country.name" />
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div t-attf-class="form-group col-lg-6 col-12">
                            <label class="col-form-label" for="state">State</label>
                            <select
                                                        name="state"
                                                        id="state"
                                                        t-attf-class="custom-select"
                                                        t-att-value="partner.state"
                                                    >
                                <t t-foreach="states" t-as="state">
                                    <option
                                                                t-att-value="state.id"
                                                                value="state.id"
                                                            >
                                        <t t-esc="state.name" />
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div t-attf-class="form-group col-lg-6">
                            <label class="col-form-label" for="street">District</label>
                            <input 
                                    type="text" 
                                    name="street" 
                                    t-attf-class="form-control" 
                                    t-att-value="street or partner.street"
                                />
                        </div>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary float-center mb32 ">
                                Confirm
                            <span class="fa fa-long-arrow-right" />
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>