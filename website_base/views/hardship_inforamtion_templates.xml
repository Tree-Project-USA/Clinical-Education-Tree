<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="hardship_information_template" name="Hardship Information">
        <t t-call="website.layout">
            <div class="container hardship_information">
                <input
                    type="hidden"
                    id="state"
                    t-att-value="hardship_id.state"
                />
                <div class="d-flex align-items-center flex-wrap text-center style_stage mt-4">
                    <span id="draft" class="draft">Draft</span>
                    <span id="update" class="update" >Required Update</span>
                    <span id="under_review" class="under_review">Under Review</span>
                    <span id="confirm" class="confirm">Validate</span>
                    <span id="expired" class="expired">Expired</span>
                    <span id="cancel" class="cancel">Cancelled</span>
                </div>
                <div class="row mt-4">
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">First Name</label>
                        <div>
                          <input
                            type="text"
                            id="first_name"
                            class="form-control"
                            name="first_name"
                            t-att-value="hardship_id.student_id.first_name"
                            readonly="readonly"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Last Name</label>
                        <div>
                          <input
                            type="text"
                            id="last_name"
                            class="form-control"
                            name="last_name"
                            t-att-value="hardship_id.student_id.last_name"
                            readonly="readonly"
                          />
                        </div>
                      </div>
                    </div>
                </div>
                <div class="row mt-4">
                    <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Home Address</label>
                          <div>
                            <input
                              type="text"
                              id="home_address"
                              name="home_address"
                              class="form-control updated"
                              readonly="readonly"
                              t-att-value="hardship_id.student_id.home_address"
                            />
                          </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Home Phone</label>
                          <div>
                            <input
                              type="text"
                              id="phone"
                              max="10"
                              name="phone"
                              class="form-control updated"
                              readonly="readonly"
                              t-att-value="hardship_id.student_id.phone"
                            />
                          </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-4">
                    <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Personal Phone</label>
                          <div>
                            <input
                              type="text"
                              id="personal_phone"
                              max="10"
                              name="personal_phone"
                              class="form-control updated"
                              readonly="readonly"
                              t-att-value="hardship_id.student_id.personal_phone"
                            />
                          </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Personal Email Address</label>
                          <div>
                            <input
                              type="email"
                              id="email"
                              name="email"
                              class="form-control updated"
                              readonly="readonly"
                              t-att-value="hardship_id.student_id.email"
                            />
                          </div>
                        </div>
                    </div>
                </div>
                <div>
                  <div class="row s_col_no_resize s_col_no_bgcolor">
                    <table class="table table-borderless mt-3 total_project_costs">
                        <thead>
                            <tr>
                                <td style="width: 40px;">
                                   #
                                </td>
                                <td>
                                    <strong>
                                        Zip code
                                    </strong>
                                </td>
                                <td>
                                    <strong>
                                        State
                                    </strong>
                                </td>
                                <td>
                                    <strong>
                                        City
                                    </strong>
                                </td>
                            </tr>
                        </thead>
                        <div class="collapse">
                            <tbody t-foreach="hardship_id.geographical_ids" t-as="location">
                                <tr class="project_cost_line">
                                    <td>
                                        <div class="form-group">
                                            <span t-esc="location_index + 1"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="form-group">
                                            <div class="input-group mb-2">
                                                <input 
                                                    type="text" 
                                                    readonly="1"
                                                    class="form-control" 
                                                    t-att-value="location.zip_code"
                                                />
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="form-group">
                                            <div class="input-group mb-2">
                                                <input 
                                                    type="text" 
                                                    readonly="1"
                                                    class="form-control" 
                                                    t-att-value="location.state" 
                                                    />
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="form-group">
                                            <div class="input-group mb-2">
                                                <input 
                                                    type="text" 
                                                    readonly="1"
                                                    class="form-control" 
                                                    t-att-value="location.city"
                                                />
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </div>
                    </table>
                  </div>
                </div>
                <div>
                  <div class="row s_col_no_resize s_col_no_bgcolor">
                    <table class="table table-borderless mt-3 total_project_costs">
                        <thead>
                            <tr>
                                <td style="width: 40px;">
                                   #
                                </td>
                                <td>
                                    <strong>
                                        State
                                    </strong>
                                </td>
                                <td>
                                    <strong>
                                        File Confirmation
                                    </strong>
                                </td>
                                <td>
                                    <strong>
                                        File Cancelation
                                    </strong>
                                </td>
                            </tr>
                        </thead>
                        <div class="collapse">
                            <tbody>
                                <tr class="project_cost_line"  t-foreach="hardship_ids" t-as="file">
                                  <t >
                                    <td>
                                        <div class="form-group">
                                            <span t-esc="file_index + 1"/>
                                        </div>
                                    </td>
                                    <td>
                                        <t t-esc="file.state"/>
                                    </td>
                                    <td>
                                      <a 
                                        t-if="file.attachment_confirm"
                                        type="button"
                                        class="btn my-2"
                                        role="button" 
                                        style="background-color:  #ab8631; !important; color: #fff"
                                        t-attf-href="/web/content/hardship.request/#{file.id}/attachment_confirm?download=true"
                                      >
                                      <i class="fa fa-download" />
                                      </a>
                                      <a 
                                        t-if="file.attachment_confirm"
                                        type="button"
                                        class="btn my-2"
                                        role="button" 
                                        style="background-color:  #ab8631; !important; color: #fff"
                                        t-attf-href="/web/content/hardship.request/#{file.id}/attachment_confirm"
                                      >
                                      <i class="fa fa-eye"/>
                                      </a>
                                    </td>
                                    <td>
                                      <a 
                                        t-if="file.attachment_cancel"
                                        type="button"
                                        class="btn my-2"
                                        role="button" 
                                        style="background-color:  #ab8631; !important; color: #fff"
                                        t-attf-href="/web/content/hardship.request/#{file.id}/attachment_cancel?download=true"
                                      >
                                      <i class="fa fa-download" />
                                      </a>
                                      <a 
                                        t-if="file.attachment_cancel"
                                        type="button"
                                        class="btn my-2"
                                        role="button" 
                                        style="background-color:  #ab8631; !important; color: #fff"
                                        t-attf-href="/web/content/hardship.request/#{file.id}/attachment_cancel"
                                      >
                                      <i class="fa fa-eye"/>
                                      </a>
                                    </td>
                                  </t>
                                </tr>
                            </tbody>
                        </div>
                    </table>
                  </div>
                </div>
                <div class="row mt-4 mt-4 mb-4 text-left">
                    <div class="col-12 mr-2">
                        <a
                            type="button"
                            class="btn my-2 float-end"
                            role="button" 
                            href="/my/home"
                            style="background-color:  #ab8631; !important; color: #fff"
                        >
                          Back To My Profile
                        </a>
                        <a 
                          t-if="hardship_id.state == 'update'"
                          type="button"
                          class="btn my-2"
                          role="button" 
                          style="background-color:  #ab8631; !important; color: #fff"
                          t-attf-href="/update/hardship/request"
                        >
                          Update Hardship Inforamtion
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
