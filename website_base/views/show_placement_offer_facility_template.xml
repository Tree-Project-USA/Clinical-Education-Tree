<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="show_placement_offer_facility_template" name="Show Placement Offer Facility">
        <t t-call="website.layout">
            <div class="container">
              <form
                class="availability"
              >
                    <div class="text-center mt-4">
                        <h2>Information Facility</h2>
                    </div>
                    <table class="table table-striped table-bordered shadow-sm text-center mt-5">
                        <thead style="background-color:#ab8631; color: #000">
                          <tr>
                            <th scope="col">Facility Name</th>
                            <th scope="col">SCCE First Name</th>
                            <th scope="col">SCCE Last Name</th>
                            <th scope="col">SCCE Email Address</th>
                            <th scope="col">Facility Address</th>
                            <th scope="col">City</th>
                            <th scope="col">State</th>
                            <th scope="col">Zip Code</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr t-foreach="facility_id" t-as="val">
                            <td><t t-esc="val.name"/></td>
                            <td><t t-esc="val.scce_primary_id.first_name"/></td>
                            <td><t t-esc="val.scce_primary_id.last_name"/></td>
                            <td><t t-esc="val.scce_primary_id.email"/></td>
                            <td><t t-esc="val.address"/></td>
                            <td><t t-esc="val.city"/></td>
                            <td><t t-esc="val.state"/></td>
                            <td><t t-esc="val.zip"/></td>
                          </tr>
                        </tbody>
                      </table>
                    <table class="table table-striped table-bordered shadow-sm text-center my-5">
                        <thead style="background-color:#ab8631; color: #000">
                          <tr>
                            <th scope="col">Assigned Student/s</th>
                            <th scope="col"></th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr t-foreach="placement_offer_ids" t-as="val">
                            <td><t t-esc="val.student_id.name"/></td>
                            <td>
                              <form
                                class="availability"
                                t-att-action="'/assigned/student/%s' % (val.id)"
                                method="post"
                                enctype="multipart/form-data"
                              >
                                <a
                                    type="button"
                                    class="btn my-2"
                                    role="button" 
                                    t-attf-href="/profile/student/#{val.id}"
                                    style="background-color:  #ab8631; !important; color: #fff"
                                >
                                    <i class="fa fa-eye mx-2"/> View Student Profile
                                </a>
                                <a
                                    type="button"
                                    class="btn my-2"
                                    role="button" 
                                    t-attf-href="/assigned/student/#{val.id}"
                                    style="background-color:  #ab8631; !important; color: #fff"
                                >
                                    Confirm
                                </a>
                                <a
                                    
                                    type="button"
                                    class="btn my-2"
                                    role="button" 
                                    t-attf-href="/declin/eassigned/student/#{val.id}"
                                    style="background-color:  #ab8631; !important; color: #fff"
                                >
                                Decline Student
                                </a>
                              </form>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                      <div class="clearfix oe_login_buttons mt-4">
                        <a href="/my/home"
                            class="float-end custom_create btn btn-block "
                            style="background-color:#ab8631;color:#fff;">
                            Back To My Profile
                        </a>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>