<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="show_placement_offer_facility_template" name="Show Placement Offer Facility">
        <t t-call="website.layout">
            <div class="container">
              <div class="alert alert-danger w-10 mx-auto text-center" t-if="error"
                  role="alert">
                  <strong>
                      <t t-esc="error" />
                  </strong>
              </div>
              <form
                class="availability"
              >
                    <div class="text-center mt-4">
                        <h2>Facility Information</h2>
                    </div>
                    <table class="table table-striped table-bordered shadow-sm text-center mt-5">
                        <thead style="background-color:#ab8631; color: #000">
                          <tr>
                            <th scope="col">Facility Name</th>
                            <th scope="col">Facility Address</th>
                            <th scope="col">City</th>
                            <th scope="col">State</th>
                            <th scope="col">Zip Code</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            <td><t t-esc="facility_id.name"/></td>
                            <td><t t-esc="facility_id.address"/></td>
                            <td><t t-esc="facility_id.city"/></td>
                            <td><t t-esc="facility_id.state"/></td>
                            <td><t t-esc="facility_id.zip"/></td>
                          </tr>
                        </tbody>
                      </table>
                      <div>
                        <ul class="nav nav-tabs" id="myTab" role="tablist">
                          <li class="nav-item" role="presentation" t-if="archive_ids">
                            <button class="nav-link active" id="assigned-student-tab" data-bs-toggle="tab" data-bs-target="#assigned_student" type="button" role="tab" aria-controls="assigned_student" aria-selected="false">Assigned Student/s</button>
                          </li>
                          <li class="nav-item" role="presentation">
                            <button class="nav-link" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">Department</button>
                          </li>
                          <li class="nav-item" role="presentation">
                            <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">SCCE Information</button>
                          </li>
                          <li class="nav-item" role="presentation">
                            <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#placement_history" type="button" role="tab" aria-controls="placement_history" aria-selected="false">Placement History</button>
                          </li>
                        </ul>
                        <div class="tab-content" id="myTabContent">
                          <div class="tab-pane fade show active" id="assigned_student" role="tabpanel" aria-labelledby="assigned-student-tab">
                            <table class="table table-striped table-bordered shadow-sm text-center my-5">
                              <thead style="background-color:#ab8631; color: #000">
                                <tr>
                                  <th scope="col">Student Name</th>
                                  <th scope="col">Clinical Experience Type</th>
                                  <th scope="col">Setting Type</th>
                                  <th scope="col">Term</th>
                                  <th scope="col">Year</th>
                                  <th scope="col"></th>
                                </tr>
                              </thead>
                              <tbody>
                                <tr t-foreach="archive_ids" t-as="val">
                                  <t t-if="val.active == True and (val.placement_status == 'pending' or val.is_show_portal == True)">
                                    <td><t t-esc="val.student_id.name"/></td>
                                    <td>
                                      <t t-if="val.placement_type in ['tce1', 'tce2']">
                                        TCE
                                      </t>
                                      <t t-else="">
                                        ICE
                                      </t>
                                    </td>
                                    <td><t t-esc="dict(val._fields['setting'].selection).get(val.setting)"/></td>
                                    <td><t t-esc="dict(val._fields['placement_term'].selection).get(val.placement_term)"/></td>
                                    <td><t t-esc="val.year"/></td>
                                    <td>
                                      <form
                                        class="availability"
                                      >
                                        <a
                                            type="button"
                                            class="btn my-2"
                                            role="button" 
                                            t-attf-href="/profile/student/#{val.student_id.id}"
                                            style="background-color:  #ab8631; !important; color: #000000"
                                        >
                                            <i class="fa fa-eye mx-2"/> View Student Profile
                                        </a>
                                        <a
                                            t-if="val.placement_status == 'pending'"
                                            type="button"
                                            class="btn my-2"
                                            role="button" 
                                            t-attf-href="/confirm/student/#{val.id}"
                                            style="background-color:  #ab8631; !important; color: #000000"
                                        >
                                            Confirm
                                        </a>
                                        <a
                                            t-if="val.placement_status != 'not_placed'"
                                            type="button"
                                            class="btn my-2"
                                            role="button" 
                                            t-attf-href="/declin/eassigned/student/#{val.id}"
                                            style="background-color:  #ab8631; !important; color: #000000"
                                        >
                                        Decline Student
                                        </a>
                                        <a
                                            t-if="val.archive_offer_id or val.placement_status != 'not_placed'"
                                            type="button"
                                            class="btn my-2"
                                            role="button" 
                                            t-attf-href="/cancel/eassigned/student/#{val.id}"
                                            style="background-color:  #ab8631; !important; color: #000000"
                                        >
                                            Cancel Offer all together
                                        </a>
                                        <a
                                            t-if="val.placement_status == 'not_placed'"
                                            type="button"
                                            class="btn my-2"
                                            role="button" 
                                            t-attf-href="/replay/student/#{val.id}"
                                            style="background-color:  #ab8631; !important; color: #000000"
                                        >
                                            Replay placement Offer
                                        </a>
                                      </form>
                                    </td>
                                  </t>
                                </tr>
                              </tbody>
                            </table>
                          </div>
                          <div class="tab-pane fade" id="home" role="tabpanel" aria-labelledby="home-tab">
                            <table class="table table-striped table-bordered shadow-sm text-center my-5">
                              <thead style="background-color:#ab8631; color: #000">
                                <tr>
                                  <th scope="col">Name</th>
                                  <th scope="col">City</th>
                                  <th scope="col">State</th>
                                  <th scope="col">ZIP Code</th>
                                </tr>
                              </thead>
                              <tbody>
                                <tr t-foreach="department_ids" t-as="val">
                                  <td><t t-esc="val.name"/></td>
                                  <td><t t-esc="val.city"/></td>
                                  <td><t t-esc="val.state"/></td>
                                  <td><t t-esc="val.geographical_id.zip_code"/></td>
                                </tr>
                              </tbody>
                            </table>
                          </div>
                          <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                            <table class="table table-striped table-bordered shadow-sm text-center my-5">
                              <thead style="background-color:#ab8631; color: #000">
                                <tr>
                                  <th scope="col">First Name</th>
                                  <th scope="col">Last Name</th>
                                  <th scope="col">Phone</th>
                                </tr>
                              </thead>
                              <tbody>
                                <tr t-foreach="scce_ids" t-as="val">
                                  <td><t t-esc="val.first_name"/></td>
                                  <td><t t-esc="val.last_name"/></td>
                                  <td><t t-esc="val.phone"/></td>
                                </tr>
                              </tbody>
                            </table>
                          </div>
                          <div class="tab-pane fade" id="placement_history" role="tabpanel" aria-labelledby="contact-tab">
                            <table class="table table-striped table-bordered shadow-sm text-center mt-4">
                              <thead style="background-color:#ab8631; color: #000000">
                                <tr>
                                  <th scope="col">Department</th>
                                  <th scope="col">Student Name</th>
                                  <th scope="col">Clinical Experience Type</th>
                                  <th scope="col">Setting Type</th>
                                  <th scope="col">Term</th>
                                  <th scope="col">Year</th>
                                  <th scope="col">City</th>
                                  <th scope="col">State</th>
                                  <th scope="col">Facility Zip Code</th>
                                  <th scope="col">Placement Status</th>
                                </tr>
                              </thead>
                              <tbody>
                                  <tr t-foreach="placement_history_ids" t-as="val">
                                    <td><t t-esc="val.department_id.name"/></td>
                                    <td><t t-esc="val.student_id.name"/></td>
                                    <td>
                                      <t t-if="val.placement_type in ['tce1', 'tce2']">
                                        TCE
                                      </t>
                                      <t t-else="">
                                        ICE
                                      </t>
                                    </td>
                                    <td><t t-esc="dict(val._fields['setting'].selection).get(val.setting)"/></td>
                                    <td><t t-esc="dict(val._fields['placement_term'].selection).get(val.placement_term)"/></td>
                                    <td><t t-esc="val.year"/></td>
                                    <td><t t-esc="val.city"/></td>
                                    <td><t t-esc="val.state"/></td>
                                    <td><t t-esc="val.facility_id.geographical_id.zip_code"/></td>
                                    <td><t t-esc="dict(val._fields['placement_status'].selection).get(val.placement_status)"/></td>
                                  </tr>
                              </tbody>
                            </table>
                          </div>
                        </div>
                      </div>
                      <div class="clearfix oe_login_buttons my-4">
                        <a href="/my/home"
                            class="float-end custom_create btn btn-block "
                            style="background-color:#ab8631;color:#000000;">
                            Back To My Profile
                        </a>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>