<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="ci_profile_template" name="CI Information">

    <!-- ================================================================ user_information
    ===================================================================== -->
    <t t-call="website.layout">
      <div class="ci_profile">
        <div class="container">
          <div class="popup-card-confirm">
            <div class="content">
              <h3>Successfully</h3>
              <p id="content-p">
                Your request submitted successfully
              </p>
            </div>
          </div>
          <div class="row my-4">
            <div class="col-3 my-4 text-center">
              <div class="nav flex-column nav-pills me-3 d-none d-lg-block" id="v-pills-tab"
                role="tablist" aria-orientation="vertical">
                <div class="text-center my-2">
                  <img
                    t-if="partner.image_1920"
                    t-att-src="image_data_uri(partner.image_1920)"
                    class="img img-fluid rounded-circle o_wblog_author_avatar mr-1"
                    loading="lazy"
                    style="width: 12rem; height:12rem;"
                  />
                  <img
                    t-else=""
                    src="/website_base/static/src/img/user.png"
                    class="img img-fluid o_wblog_author_avatar mr-1"
                    loading="lazy"
                  />
                </div>
                <button class="col-12 nav-ci nav-link active" id="scce-information-tab"
                  data-bs-toggle="pill" data-bs-target="#scce_information" type="button" role="tab"
                  aria-controls="scce_information" aria-selected="true">CI Information</button>
                <button class="col-12 nav-ci nav-link" id="facility-information-tab"
                  data-bs-toggle="pill" data-bs-target="#facility_information" type="button"
                  role="tab" aria-controls="facility_information" aria-selected="false">Facility
                  Information</button>
                <button class="col-12 nav-ci nav-link" id="post-placement-managament-tab"
                  data-bs-toggle="pill" data-bs-target="#post_placement_managament" type="button"
                  role="tab" aria-controls="post_placement_managament" aria-selected="false">Post
                  Placement Managament</button>
              </div>
              <div class="nav flex-column nav-pills me-3 d-sm-block d-lg-none" id="v-pills-tab"
                role="tablist" aria-orientation="vertical">
                <div class="text-center my-4">
                  <img
                    t-if="partner.image_1920"
                    t-att-src="image_data_uri(partner.image_1920)"
                    class="img img-fluid rounded-circle o_wblog_author_avatar mr-1"
                    loading="lazy"
                    style="width: 12rem; height:12rem;"
                  />
                  <img
                    t-else=""
                    src="/website_base/static/src/img/user.png"
                    class="img img-fluid o_wblog_author_avatar mr-1"
                    loading="lazy"
                  />
                </div>
                <button class="nav-link active" id="scce-information-tab" data-bs-toggle="pill"
                  data-bs-target="#scce_information" type="button" role="tab"
                  aria-controls="scce_information" aria-selected="true">
                  <i class="fa fa-address-card" style="color:#083B4D; font-size:20px;" />
                </button>
                <button class="nav-link" id="facility-information-tab" data-bs-toggle="pill"
                  data-bs-target="#facility_information" type="button" role="tab"
                  aria-controls="facility_information" aria-selected="false">
                  <i class="fa fa-hospital-o" style="color:#083B4D; font-size:20px;" />
                </button>
                <button class="nav-link" id="post-placement-managament-tab" data-bs-toggle="pill"
                  data-bs-target="#post_placement_managament" type="button" role="tab"
                  aria-controls="post_placement_managament" aria-selected="false">
                  <i class="fa fa-cogs" style="color:#083B4D; font-size:20px;" />
                </button>
              </div>
            </div>
            <div class="col-9">
              <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade my-4 show active" id="scce_information" role="tabpanel"
                  aria-labelledby="scce-information-tab">
                  <div class="row mt-4">
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">First Name</label>
                        <div>
                          <input
                            type="text"
                            id="first_name"
                            class="form-control"
                            name="first_name"
                            t-att-value="partner.first_name"
                            readonly="readonly"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Last Name</label>
                        <div>
                          <input
                            type="text"
                            id="last_name"
                            class="form-control"
                            name="last_name"
                            t-att-value="partner.last_name"
                            readonly="readonly"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="row mt-4">
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Phone</label>
                        <div>
                          <input
                            type="text"
                            id="phone"
                            class="form-control updated"
                            name="phone"
                            t-att-value="partner.phone"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Email</label>
                        <div>
                          <input
                            type="text"
                            id="email"
                            class="form-control updated"
                            name="email"
                            t-att-value="partner.email"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="row mt-4">
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Entry Level PT Degree Earned</label>
                        <div>
                          <input
                            type="text"
                            id="entry_level_pt_degree_earned"
                            class="form-control updated"
                            name="entry_level_pt_degree_earned"
                            t-att-value="partner.entry_level_pt_degree_earned"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Highest Degree Earned</label>
                        <div>
                          <input
                            type="text"
                            id="highest_degree_earned"
                            class="form-control updated"
                            name="highest_degree_earned"
                            t-att-value="partner.highest_degree_earned"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="row mt-4">
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Aegree Area</label>
                        <div>
                          <input
                            type="text"
                            id="degree_area"
                            class="form-control updated"
                            name="degree_area"
                            t-att-value="partner.degree_area"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Years Experience CI</label>
                        <div>
                          <input
                            type="text"
                            id="years_experience_ci"
                            class="form-control updated"
                            name="years_experience_ci"
                            t-att-value="partner.years_experience_ci"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="row mt-4">
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Years Experience Clinician</label>
                        <div>
                          <input
                            type="text"
                            id="years_experience_clinician"
                            class="form-control updated"
                            name="years_experience_clinician"
                            t-att-value="partner.years_experience_clinician"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Areas Expertise</label>
                        <div>
                          <input
                            type="text"
                            id="areas_expertise"
                            class="form-control updated"
                            name="areas_expertise"
                            t-att-value="partner.areas_expertise"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="row mt-4">
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Clinical Certification</label>
                        <div>
                          <input
                            type="text"
                            id="clinical_certification"
                            class="form-control updated"
                            name="clinical_certification"
                            t-att-value="partner.clinical_certification"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Specify Area</label>
                        <div>
                          <input
                            type="text"
                            id="specify_area"
                            class="form-control updated"
                            name="specify_area"
                            t-att-value="partner.specify_area"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="row mt-4">
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Other CI Credential</label>
                        <div>
                          <input
                            type="text"
                            id="other_ci_credential"
                            class="form-control updated"
                            name="other_ci_credential"
                            t-att-value="partner.other_ci_credential"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Other CI Credential</label>
                        <div>
                          <input
                            type="text"
                            id="other_ci_credential"
                            class="form-control updated"
                            name="other_ci_credential"
                            t-att-value="partner.other_ci_credential"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="row mt-4">
                    <div class="col-lg-6">
                      <div class="form-group row">
                        <label for="staticEmail" class="col-form-label">Professional Organization
                          Membership</label>
                        <div>
                          <input
                            type="text"
                            id="professional_organization_membership"
                            class="form-control updated"
                            name="professional_organization_membership"
                            t-att-value="partner.professional_organization_membership"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="tab-pane fade my-4" id="facility_information" role="tabpanel"
                  aria-labelledby="facility-information-tab">
                  <div class="table-responsive">
                    <table class="table table-striped table-bordered shadow-sm text-center my-4">
                      <thead style="background-color:#F9D6BF; color: #083B4D">
                      <tr>
                        <th scope="col" colspan="1">Facility Name</th>
                        <th scope="col" colspan="1">Facility Address</th>
                        <th scope="col" colspan="1">City</th>
                        <th scope="col" colspan="1">State</th>
                        <th scope="col" colspan="1">Zip Code</th>
                        <th scope="col" colspan="1"></th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr t-foreach="scce_facility_ids" t-as="val">
                        <td colspan="1">
                          <t t-esc="val.name" />
                        </td>
                        <td colspan="1">
                          <t t-esc="val.address" />
                        </td>
                        <td colspan="1">
                          <t t-esc="val.city" />
                        </td>
                        <td colspan="1">
                          <t t-esc="val.state" />
                        </td>
                        <td colspan="1">
                          <t t-esc="val.zip" />
                        </td>
                        <td colspan="1">
                          <t t-set="student"
                            t-value="request.env['archive'].sudo().search([('facility_id', '=', val.id)])" />
                          <a
                            t-if="val.offer_ids and student"
                            type="button"
                            class="btn my-2"
                            role="button"
                            t-attf-href="/facility/ci/placement/offer/#{val.id}"
                            style="background-color:#F9D6BF; color: #083B4D"
                          >
                            <i class="fa fa-eye mx-2" />Placement Offer </a>
                        </td>
                      </tr>
                    </tbody>
                    </table>
                  </div>
                </div>
                <div class="tab-pane fade my-4" id="post_placement_managament" role="tabpanel"
                  aria-labelledby="post-placement-managament-tab">
                  <div class="table-responsive">
                    <table class="table table-striped table-bordered shadow-sm text-center my-4">
                      <thead style="background-color:#F9D6BF; color: #083B4D">
                      <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Email</th>
                        <th scope="col">Term</th>
                        <th scope="col">Year</th>
                        <th scope="col">CI Details</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr t-foreach="plcement_ids" t-as="plcement">
                        <td>
                          <span t-field="plcement.student_id" />
                        </td>
                        <td>
                          <span t-field="plcement.student_id.email" />
                        </td>
                        <td>
                          <span t-field="plcement.year" />
                        </td>
                        <td>
                          <span t-field="plcement.placement_term" />
                        </td>
                        <td>
                          <a t-if="plcement.ptse_3_id.stage_type == 'ci_details'"
                            class="btn btn-primary"
                            t-att-href="'/ci/details/%s' % (plcement.ptse_3_id.id)"> Submit <i
                              class="fa fa-pencil" />
                          </a>
                          <a t-else="" class="nav-link"
                            t-att-href="'/ci/details/%s' % (plcement.ptse_3_id.id)"> View <i
                              class="fa fa-eye mx-2" />
                          </a>

                        </td>
                      </tr>
                    </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>