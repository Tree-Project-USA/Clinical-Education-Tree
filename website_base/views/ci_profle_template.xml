<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="ci_profile_template" name="CI Information">

<!-- ================================================================ user_information ===================================================================== -->
      <t t-call="website.layout">
        <div class="ci_profile">
          <div class="container">
            <div class="popup-card-confirm">
              <div class="content">
                <h3>Successfully</h3>
                <p id="content-p">
                  Your request submitted successfully
                </p>
              </div>
            </div>
              <div class="row mt-4">
                <div class="col-12">
                  <div class="text-center mb-4 mt-2">
                    <h3>CI Information</h3>
                  </div>
                  <div class="text-center">
                    <img
                      src="/website_base/static/src/img/blank-profile-picture.jpg"
                      class="img img-fluid rounded-circle o_wblog_author_avatar mr-1"
                      loading="lazy"
                      style="width: 12rem; height:12rem;"
                    />
                  </div>
                </div>
              </div>
                <ul class="nav nav-tabs my-4" id="myTab" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="scce-information-tab" data-bs-toggle="tab"
                      data-bs-target="#scce_information" type="button" role="tab" aria-controls="scce_information"
                      aria-selected="false">Basic CI Information</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="medical-attachment-ids-tab" data-bs-toggle="tab"
                      data-bs-target="#medical_attachment_ids" type="button" role="tab" aria-controls="medical_attachment_ids"
                      aria-selected="false">Facility Information</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link " id="ci-information-tab" data-bs-toggle="tab"
                      data-bs-target="#ci_information" type="button" role="tab" aria-controls="ci_information"
                      aria-selected="false">CI Information</button>
                  </li>
                </ul>
                <div class="tab-content" id="myTabContent">
                  <div class="tab-pane fade my-4 show active" id="scce_information" role="tabpanel"
                    aria-labelledby="scce-information-tab">
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">First Name</label>
                          <div>
                            <input
                              type="text"
                              id="first_name"
                              class="form-control"
                              name="first_name"
                              t-att-value="partner.first_name"
                              readonly="readonly"
                            />
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Last Name</label>
                          <div>
                            <input
                              type="text"
                              id="last_name"
                              class="form-control"
                              name="last_name"
                              t-att-value="partner.last_name"
                              readonly="readonly"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Phone</label>
                          <div>
                            <input
                              type="text"
                              id="phone"
                              class="form-control updated"
                              name="phone"
                              t-att-value="partner.phone"
                            />
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Email</label>
                          <div>
                            <input
                              type="text"
                              id="email"
                              class="form-control updated"
                              name="email"
                              t-att-value="partner.email"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Entry Level PT Degree Earned</label>
                          <div>
                            <input
                              type="text"
                              id="entry_level_pt_degree_earned"
                              class="form-control updated"
                              name="entry_level_pt_degree_earned"
                              t-att-value="partner.entry_level_pt_degree_earned"
                            />
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Highest Degree Earned</label>
                          <div>
                            <input
                              type="text"
                              id="highest_degree_earned"
                              class="form-control updated"
                              name="highest_degree_earned"
                              t-att-value="partner.highest_degree_earned"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Aegree Area</label>
                          <div>
                            <input
                              type="text"
                              id="degree_area"
                              class="form-control updated"
                              name="degree_area"
                              t-att-value="partner.degree_area"
                            />
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Years Experience CI</label>
                          <div>
                            <input
                              type="text"
                              id="years_experience_ci"
                              class="form-control updated"
                              name="years_experience_ci"
                              t-att-value="partner.years_experience_ci"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Years Experience Clinician</label>
                          <div>
                            <input
                              type="text"
                              id="years_experience_clinician"
                              class="form-control updated"
                              name="years_experience_clinician"
                              t-att-value="partner.years_experience_clinician"
                            />
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Areas Expertise</label>
                          <div>
                            <input
                              type="text"
                              id="areas_expertise"
                              class="form-control updated"
                              name="areas_expertise"
                              t-att-value="partner.areas_expertise"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Clinical Certification</label>
                          <div>
                            <input
                              type="text"
                              id="clinical_certification"
                              class="form-control updated"
                              name="clinical_certification"
                              t-att-value="partner.clinical_certification"
                            />
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Specify Area</label>
                          <div>
                            <input
                              type="text"
                              id="specify_area"
                              class="form-control updated"
                              name="specify_area"
                              t-att-value="partner.specify_area"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Other CI Credential</label>
                          <div>
                            <input
                              type="text"
                              id="other_ci_credential"
                              class="form-control updated"
                              name="other_ci_credential"
                              t-att-value="partner.other_ci_credential"
                            />
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Other CI Credential</label>
                          <div>
                            <input
                              type="text"
                              id="other_ci_credential"
                              class="form-control updated"
                              name="other_ci_credential"
                              t-att-value="partner.other_ci_credential"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-4">
                      <div class="col-lg-6">
                        <div class="form-group row">
                          <label for="staticEmail" class="col-form-label">Professional Organization Membership</label>
                          <div>
                            <input
                              type="text"
                              id="professional_organization_membership"
                              class="form-control updated"
                              name="professional_organization_membership"
                              t-att-value="partner.professional_organization_membership"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="tab-pane fade my-4" id="medical_attachment_ids" role="tabpanel"
                    aria-labelledby="medical-attachment-ids-tab">
                    <table class="table table-striped table-bordered shadow-sm text-center mt-5">
                      <thead style="background-color:#326434; color: #fff">
                        <tr>
                          <th scope="col" colspan="1">Facility Name</th>
                          <th scope="col" colspan="1">Facility Address</th>
                          <th scope="col" colspan="1">City</th>
                          <th scope="col" colspan="1">State</th>
                          <th scope="col" colspan="1">Zip Code</th>
                          <th scope="col" colspan="1"></th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr t-foreach="scce_facility_ids" t-as="val">
                          <td colspan="1"><t t-esc="val.name"/></td>
                          <td colspan="1"><t t-esc="val.address"/></td>
                          <td colspan="1"><t t-esc="val.city"/></td>
                          <td colspan="1"><t t-esc="val.state"/></td>
                          <td colspan="1"><t t-esc="val.zip"/></td>
                          <td colspan="1">
                            <a
                              t-if="val.offer_ids"
                              type="button"
                              class="btn my-2"
                              role="button" 
                              t-attf-href="/facility/ci/placement/offer/#{val.id}"
                              style="background-color:  #326434; !important; color: #fff"
                            >
                            <i class="fa fa-eye mx-2"/> Show Placement Offer
                            </a>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
          </div>
        </div>
      </t>
  </template>
</odoo>
