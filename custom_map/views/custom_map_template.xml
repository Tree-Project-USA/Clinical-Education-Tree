<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_map_page" name="Custom Map Page">
        <t t-call="website.layout">
            <div class="student_map" id="map" style="width: 100%; height: 700px;"></div>
    
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
            <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />
            <link rel="stylesheet" href="https://unpkg.com/esri-leaflet-geocoder@2.3.3/dist/esri-leaflet-geocoder.css" />
            <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
            <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>
            <script src="https://unpkg.com/esri-leaflet@2.5.3/dist/esri-leaflet.js"></script>
            <script src="https://unpkg.com/esri-leaflet-geocoder@2.3.3/dist/esri-leaflet-geocoder.js"></script>
        </t>
    </template>

  <record id="map_student" model="website.menu">
    <field name="name">Map Medical Facility</field>
    <field name="url">/medical/facility/map</field>
    <field name="parent_id" ref="website.main_menu" />
    <field name="sequence" type="int">22</field>
  </record>
</odoo>
