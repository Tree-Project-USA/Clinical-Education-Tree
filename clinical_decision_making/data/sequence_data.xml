<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <data noupdate="1">
        <!-- Student Sequence -->
        <record id="studentid_sequence" model="ir.sequence">
            <field name="name">Student</field>
            <field name="code">res_partner_sequence</field>
            <field name="implementation">no_gap</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- SCCE Sequence -->
        <record id="scceid_sequence" model="ir.sequence">
            <field name="name">SCCE</field>
            <field name="code">scce_sequence</field>
            <field name="implementation">no_gap</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Clinical Site Sequence -->
        <record id="facilityid_sequence" model="ir.sequence">
            <field name="name">Clinical Site</field>
            <field name="code">medical_facility_sequence</field>
            <field name="implementation">no_gap</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequences for sequencePlcement Management -->
        <record id="ir_sequence_post_plcement_management" model="ir.sequence">
            <field name="name">sequence Plcement Management</field>
            <field name="code">post.plcement.management</field>
            <field name="prefix">PPM</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False" />
        </record>

    </data>
</odoo>