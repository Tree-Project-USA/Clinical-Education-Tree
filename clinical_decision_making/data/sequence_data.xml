<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- Student Sequence -->
    <record id="studentid_sequence" model="ir.sequence">
        <field name="name">Student</field>
        <field name="code">res_partner_sequence</field>
        <field name="implementation">no_gap</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
      </record>

    <!-- SCCE Sequence -->
    <record id="scceid_sequence" model="ir.sequence">
        <field name="name">SCCE</field>
        <field name="code">scce_sequence</field>
        <field name="implementation">no_gap</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
      </record>

    <!-- Clinical Site Sequence -->
    <record id="facilityid_sequence" model="ir.sequence">
        <field name="name">Clinical Site</field>
        <field name="code">medical_facility_sequence</field>
        <field name="implementation">no_gap</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
      </record>

</odoo>