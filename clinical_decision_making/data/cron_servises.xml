<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="cron_account_creation_invitation" model="ir.cron">
            <field name="name">Account Creation Invitation Cron Job</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model.action_send_account_creation_invitation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-02-01 00:00:00')"/>
        </record>

        <record id="cron_action_require_renewal" model="ir.cron">
            <field name="name">Require Renewal Cron</field>
            <field name="model_id" ref="clinical_decision_making.model_facility_contract"/>
            <field name="state">code</field>
            <field name="code">model.action_require_renewal()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 23:59:59')"/>
        </record>

        <record id="cron_contract_expired" model="ir.cron">
            <field name="name">Expired Contract Cron</field>
            <field name="model_id" ref="clinical_decision_making.model_facility_contract"/>
            <field name="state">code</field>
            <field name="code">model.action_expired_contract()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 23:59:59')"/>
        </record>
</odoo>
