<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View active.facility.depend.wizard form -->
    <record id="view_active_facility_depend_wizard_form" model="ir.ui.view">
        <field name="name">view.active.facility.depend.wizard.form</field>
        <field name="model">active.facility.depend.wizard</field>
        <field name="arch" type="xml">
            <form string="Active Facility Depend Wizard">
                    <div class="mb-3">
                        Select which department to apply activation.
                    </div>
                    <field name="facility_id" invisible="1"/>
                    <field name="department_ids" class="o_portal_wizard_user_one2many" widget="portal_wizard_user_one2many">
                        <tree string="Department" editable="bottom" create="false" delete="false">
                            <field name="active" invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="city"/>
                            <field name="state"/>
                            <field name="geographical_id" readonly="1"/>

                            <button name="archive_department" string="Archive Department" type="object" class="btn btn-link" onclick="return false;" attrs="{'invisible':[('active', '!=', True)]}"/>

                            <!-- Archive Department and Offers -->
                            <button name="archive_department_and_offers" string="Archive Department and Offers" type="object" class="btn btn-link" attrs="{'invisible':[('active', '!=', True)]}"/>

                            <!-- Archive Department and Unlink Offers -->
                            <button name="archive_department_and_unlink_offers" string="Archive Department and Unlink Offers" type="object" class="btn btn-link" attrs="{'invisible':[('active', '!=', True)]}"/>

                            <!-- Unarchive Department -->
                            <button name="unarchive_department" string="Unarchive Department" type="object" class="btn btn-link" attrs="{'invisible':[('active', '=', True)]}"/>

                            <!-- Unarchive Department and Offers -->
                            <button name="unarchive_department_and_offers" string="Unarchive Department and Offers" type="object" class="btn btn-link" attrs="{'invisible':[('active', '=', True)]}"/>

                            <!-- Unarchive Department and Unlink Offers -->
                            <button name="unarchive_department_and_unlink_offers" string="Unarchive Department and Unlink Offers" type="object" class="btn btn-link" attrs="{'invisible':[('active', '=', True)]}"/>
                        </tree>
                    </field>
                <footer>
                        <button name="archive_department" string="Archive Department" type="object" class="btn btn-primary"/>
                        <button name="archive_department_and_offers" string="Archive Department and Offers" type="object" class="btn btn-success"/>
                        <button name="archive_department_and_unlink_offers" string="Archive Department and Unlink Offers" type="object" class="btn btn-danger"/>
                        <button name="unarchive_department" string="Unarchive Department" type="object" class="btn btn-primary"/>
                        <button name="unarchive_department_and_offers" string="Unarchive Department and Offers" type="object" class="btn btn-success"/>
                        <button name="unarchive_department_and_unlink_offers" string="Unarchive Department and Unlink Offers" type="object" class="btn btn-danger"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    

    <!-- Action active.facility.depend.wizard -->
    <record id="action_active_facility_depend_wizard" model="ir.actions.act_window">
        <field name="name">Active Facility Depend Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">active.facility.depend.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="clinical_decision_making.model_medical_facility"/>
        <field name="target">new</field>
    </record>

</odoo>
