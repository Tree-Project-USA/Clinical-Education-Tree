<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- SCCE Views -->
    <record id="ci_view_tree" model="ir.ui.view">
        <field name="name">res.partner.scce.view.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="email"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="ci_view_form" model="ir.ui.view">
        <field name="name">res.partner.scce.view.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="scce_id"/>
                            <field name="is_ci" invisible="1"/>
                            <field name="entry_level_pt_degree_earned"/>
                            <field name="highest_degree_earned"/>
                            <field name="degree_area"/>
                            <field name="years_experience_ci"/>
                            <field name="years_experience_clinician"/>
                        </group>
                        <group>
                            <field name="areas_expertise"/>
                            <field name="clinical_certification"/>
                            <field name="specify_area"/>
                            <field name="apta_credentialed_ci"/>
                            <field name="other_ci_credential"/>
                            <field name="professional_organization_membership"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>