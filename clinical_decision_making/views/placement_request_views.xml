<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_placement_request_tree" model="ir.ui.view">
        <field name="name">placement.request.tree</field>
        <field name="model">placement.request</field>
        <field name="arch" type="xml">
            <tree string="Placement Requests" decoration-info="placement_type == 'ice'">
                <field name="name"/>
                <field name="placement_type"/>
                <field name="placement_term"/>
                <field name="student_ids" widget="many2many_tags"/>
                <field name="facility_ids" widget="many2many_tags"/>
                <field name="create_date"/>
                <field name="create_uid"/>
            </tree>
        </field>
    </record>
    <!-- Form View -->
    <record id="view_placement_request_form" model="ir.ui.view">
        <field name="name">placement.request.form</field>
        <field name="model">placement.request</field>
        <field name="arch" type="xml">
            <form string="Placement Request">
                <header>
                    <button name="apply_filter" string="Apply Filter" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" data-hotkey="v"/>
                    <field name="state" widget="statusbar" clickable="False"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_students" type="object" icon="fa-users">
                            <field name="student_count" widget="statinfo"/>
                            <field name="student_ids" invisible="1"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_lines" type="object" icon="fa-list">
                            <field name="offer_count" widget="statinfo"/>
                            <field name="offer_ids" invisible="1"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_facilities" type="object" icon="fa-building">
                            <field name="facility_count" widget="statinfo"/>
                            <field name="facility_ids" invisible="1" force_save="1" readonly="1"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Name </span>
                        <h1 class="d-flex">
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="placement_type"/>
                            <field name="placement_term"/>
                            <field name="year"/>
                            <field name="filter_by_hardship"/>
                        </group>
                        <group>
                            <field name="code" string="Category"/>
                            <field name="program_id"/>
                            <field name="student_id"/>
                            <field name="facility_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Matching">
                            <field name="archive_ids">
                                <tree edit="false" create="false" delete="false">
                                    <field name="student_id" invisible="1"/>
                                    <field name="first_name"/>
                                    <field name="last_name"/>
                                    <field name="hardship_status"/>
                                    <field name="facility_id"/>
                                    <field name="criteria"/>
                                    <button name="action_approve" type="object" string="Approve" class="btn btn-outline-success" attrs="{'invisible': [('match_state', '!=', False)]}"/>
                                    <button name="action_decline" type="object" string="Decline" class="btn btn-outline-danger" attrs="{'invisible': [('match_state', '!=', False)]}"/>
                                    <field name="match_state" widget="badge" decoration-danger="match_state == 'decline'" decoration-success="match_state  == 'approve'"/>
                                </tree>
                            </field>
                        </page>
                        <!-- <page string="Matching">
                            <field name="tree_ids" nolabel="1">
                                <tree editable="bottom" js_class="o_fields_col" decoration-primary="tree_state=='approved_pp'" decoration-success="tree_state == 'approved_p'" decoration-warning="tree_state=='not_confirm_state'" decoration-muted="tree_state=='not_accepet_dis'">
                                    <header>
                                    </header>
                                    <field name="request_id" invisible="1"/>
                                    <field name="parent_state" invisible="1"/>
                                    <field name="tree_state" invisible="1"/>
