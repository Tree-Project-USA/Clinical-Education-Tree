<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_placement_request_tree" model="ir.ui.view">
        <field name="name">placement.request.tree</field>
        <field name="model">placement.request</field>
        <field name="arch" type="xml">
            <tree string="Placement Requests">
                <field name="name"/>
                <field name="company_id" string="University" groups="base.group_multi_company"/>
                <field name="experience_id"/>
                <field name="placement_term"/>
                <field name="year"/>
                <field name="student_ids" widget="many2many_tags" optional="hide"/>
                <field name="facility_ids" widget="many2many_tags" optional="hide"/>
                <field name="create_date"/>
                <field name="create_uid"/>
            </tree>
        </field>
    </record>
    <!-- Form View -->
    <record id="view_placement_request_form" model="ir.ui.view">
        <field name="name">placement.request.form</field>
        <field name="model">placement.request</field>
        <field name="arch" type="xml">
            <form string="Placement Request">
                <header>
                    <button name="apply_filters" string="Apply Filter" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" data-hotkey="v"/>
                    <field name="state" widget="statusbar" clickable="False" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_students" type="object" icon="fa-users">
                            <field name="student_count" string="Students" widget="statinfo"/>
                            <field name="student_ids" invisible="1"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_offer_lines" type="object" icon="fa-list">
                            <field name="archive_offer_count" widget="statinfo" string="Available Offers"/>
                            <field name="archive_offer_ids" invisible="1"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_facilities" type="object" icon="fa-building">
                            <field name="facility_count" string="Clinical Sites" widget="statinfo"/>
                            <field name="facility_ids" invisible="1" force_save="1" readonly="1"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="o_form_label">Name</label>
                        <h1 class="d-flex">
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" string="University" groups="base.group_multi_company"/>
                            <field name="experience_id"/>
                            <field name="placement_term"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="apply_hardship" string="Hardship"/>
                            <field name="apply_setting"/>
                        </group>
                        <group>
                            <field name="apply_location" string="Distance"/>
                            <field name="location_dist" attrs="{'invisible': [('apply_location', '=', False)], 'required': [('apply_location', '=', True)]}"/>
                        </group>
                        <group>
                            <field name="apply_placement_priority"/>
                        </group>
                        <group>
                            <field name="placement_status" string="Placement Status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Match">
                            <field name="archive_ids">
                                <tree edit="false" create="false" delete="false" class="cdm">
                                    <field name="student_id" invisible="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="first_name" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="last_name" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="facility_id" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="offer_criteria" colspan="3" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="student_criteria" colspan="6" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="placement_status" invisible="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="is_declined" invisible="1"/>
                                    <field name="match_state" string="Status" widget="badge" decoration-danger="match_state == 'decline'" decoration-success="match_state  == 'approve'"/>
                                    <button name="action_approve" type="object" string="Approve" class="btn btn-outline-success" attrs="{'invisible': ['|', ('match_state', '!=', False), ('placement_status', '!=', 'matched')]}"/>
                                    <button name="action_decline" type="object" string="Decline and Release Offer" class="btn-outline-danger"  attrs="{'invisible': ['|', ('match_state', '!=', False), ('placement_status', '!=', 'matched')]}"/>
                                    <button name="declined_student_offer" type="object" string="Permanently Decline" class="btn btn-outline-danger"  attrs="{'invisible': ['|', ('match_state', '!=', False), ('placement_status', '!=', 'matched')]}"/>
                                    <button name="apply_student_offer" type="object" string="Re-Apply offer " class="btn btn-outline-secondary"  attrs="{'invisible': [('is_declined', '!=', True)]}"/>
                                    <button name="action_view_student" type="object" string="View Student" class="btn btn-outline-secondary" icon="fa-address-card"/>
                                    <button name="action_open_archive_log" string="Placement Log" type="object" icon="fa-external-link" title="Open Log"/>

                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>