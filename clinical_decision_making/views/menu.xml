    <menuitem
        id="student_details_menu"
        name="Students Details"
        parent="menu_root_cpdm"
        sequence="3"/>
    <menuitem
        id="student_menu"
        name="Students"
        action="student_action"
        parent="student_details_menu"
        sequence="1"/>
    <menuitem
        id="hardship_request_menu"
        name="Hardship"
        action="hardship_request_action"
        parent="student_details_menu"
        sequence="2"/>
    
    <menuitem
        id="clinic_details_menu"
        name="Clinic Details"
        parent="menu_root_cpdm"
        sequence="4"/>

    <menuitem
        id="configuration_menu"
        name="Configuration"
        parent="menu_root_cpdm"
        sequence="5"/>
        

    <menuitem
        id="placement_offer_menu"
        name="Placement Offer"
        action="placement_offer_action"
        parent="clinic_details_menu"
        sequence="1"/>

    <menuitem
        id="facility_menu"
        name="Clinics"
        action="medical_facility_action"
        parent="clinic_details_menu"
        sequence="2"/>

    <menuitem
        id="scce_menu"
        name="Scces"
        action="scce_action"
        parent="clinic_details_menu"
        sequence="3"/>

    <menuitem
        id="geographical_menu"
        name="Geographical Data"
        action="geographical_action"
        parent="configuration_menu"
        sequence="99"/>

    <menuitem
        id="program_menu"
        name="Students Program"
        action="program_action"
        parent="configuration_menu"
        sequence="99"/>
    
