<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem name="CPDM Tree" id="menu_root_cpdm" />

    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context">{'default_is_student': True, 'default_can_apply_hardship': False}</field>
    </record>

    <record id="student_action_view2" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="clinical_decision_making.student_view_tree"/>
        <field name="act_window_id" ref="student_action"/>
    </record>
    <record id="student_action_view3" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="clinical_decision_making.student_view_form"/>
        <field name="act_window_id" ref="student_action"/>
    </record>

    <!-- <record id="cpdm_tree_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Internship</field>
        <field name="res_model">cpdm.tree</field>
        <field name="view_mode">tree,form</field>
    </record> -->

    <!-- <record id="cohort_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Placement</field>
        <field name="res_model">cohort</field>
        <field name="context">{'group_by': 'cpdm_tree_id', 'create': False}</field>
        <field name="view_mode">tree,form</field>
    </record> -->

    <record id="scce_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">scce</field>
        <field name="res_model">scce</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="medical_facility_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Clinics</field>
        <field name="res_model">medical.facility</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="placement_offer_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Placement Offer</field>
        <field name="res_model">placement.offer</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <record id="placement_request_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Placement request</field>
        <field name="res_model">placement.request</field>
        <field name="view_mode">tree,form</field>
    </record> -->

    <record id="archive_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Archive</field>
        <field name="res_model">archive</field>
        <field name="context">{'group_by': 'facility_id', 'create': False, 'edit': False}</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="hardship_request_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Hardship Request</field>
        <field name="res_model">hardship.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="facility_contract_history_view_form_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">facility.contract.history</field>
        <field name="view_mode">form</field>
    </record>

    <record id="action_facility_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">facility.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('facility_id', '!=', False)]</field>
        <field name="context">{'search_default_group_by_state': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new contract
            </p>
        </field>
    </record>

    <record model="ir.actions.act_window" id="program_action">
        <field name="name">Student Programs</field>
        <field name="res_model">program</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        id="cpdm_tree_menu"
        name="Decisions Making Tree"
        parent="menu_root_cpdm"
        sequence="1"/>

    <record id="action_placement_request" model="ir.actions.act_window">
        <field name="name">Placement Requests</field>
        <field name="res_model">placement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new placement request.
            </p>
        </field>
    </record>
