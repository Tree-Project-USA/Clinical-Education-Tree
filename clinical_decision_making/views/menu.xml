<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem 
        name="Clin Ed TREE" 
        id="menu_root_cpdm"  
        web_icon="clinical_decision_making,static/description/icon.jpeg"
        />

    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Student Information</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context">{'default_is_student': True, 'default_can_apply_hardship': False, 'active_test': False}</field>
    </record>

    <record id="student_action_view2" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="clinical_decision_making.student_view_tree"/>
        <field name="act_window_id" ref="student_action"/>
    </record>

    <record id="student_action_view3" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="clinical_decision_making.student_view_form"/>
        <field name="act_window_id" ref="student_action"/>
    </record>

    <record id="scce_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">SCCE</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_scce', '=', True)]</field>
        <field name="context">{'default_is_scce': True, 'active_test': False}</field>
    </record>

  <record id="scce_tree_view" model="ir.actions.act_window.view">
    <field eval="1" name="sequence" />
    <field name="view_mode">tree</field>
    <field name="view_id" ref="clinical_decision_making.scce_view_tree" />
    <field name="act_window_id" ref="scce_action" />
  </record>

  <record id="scce_form_view" model="ir.actions.act_window.view">
    <field eval="2" name="sequence" />
    <field name="view_mode">form</field>
    <field name="view_id" ref="clinical_decision_making.scce_view_form" />
    <field name="act_window_id" ref="scce_action" />
  </record>

    <record id="ci_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">CLINICAL INSTRUCTOR (CI)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_ci', '=', True)]</field>
        <field name="context">{'default_is_ci': True, 'active_test': False}</field>
    </record>

  <record id="ci_tree_view" model="ir.actions.act_window.view">
    <field eval="1" name="sequence" />
    <field name="view_mode">tree</field>
    <field name="view_id" ref="clinical_decision_making.ci_view_tree" />
    <field name="act_window_id" ref="ci_action" />
  </record>

  <record id="ci_form_view" model="ir.actions.act_window.view">
    <field eval="2" name="sequence" />
    <field name="view_mode">form</field>
    <field name="view_id" ref="clinical_decision_making.ci_view_form" />
    <field name="act_window_id" ref="ci_action" />
  </record>

    <record id="medical_facility_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Clinical Sites</field>
        <field name="res_model">medical.facility</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="placement_offer_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Offers</field>
        <field name="res_model">placement.offer</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <record id="placement_request_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Placement request</field>
        <field name="res_model">placement.request</field>
        <field name="view_mode">tree,form</field>
    </record> -->

    <record id="archive_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Placement History</field>
        <field name="res_model">archive</field>
        <field name="context">{}</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="hardship_request_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Hardship Accommodation</field>
        <field name="res_model">hardship.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="facility_contract_history_view_form_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">facility.contract.history</field>
        <field name="view_mode">form</field>
    </record>

    <record id="action_facility_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">facility.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('facility_id', '!=', False)]</field>
        <field name="context">{'search_default_group_by_state': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new contract
            </p>
        </field>
    </record>

    <record model="ir.actions.act_window" id="program_action">
        <field name="name">Program Duration</field>
        <field name="res_model">program</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- <menuitem
        id="cpdm_tree_menu"
        name="Decisions Making Tree"
        parent="menu_root_cpdm"
        sequence="1"/> -->

    <record id="action_placement_request" model="ir.actions.act_window">
        <field name="name">TREE Match</field>
        <field name="res_model">placement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new placement request.
            </p>
        </field>
    </record>

    <record id="action_preferred_setting" model="ir.actions.act_window">
        <field name="name">Setting Types</field>
        <field name="res_model">preferred.setting</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Preferred Setting.
            </p>
        </field>
    </record>

    <record id="preferred_setting_action_view" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="clinical_decision_making.preferred_setting_tree"/>
        <field name="act_window_id" ref="action_preferred_setting"/>
    </record>
    <!-- <menuitem
        id="cpdm_menu"
        name="Internship"
        action="cpdm_tree_action"
        parent="cpdm_tree_menu"
        sequence="1"/> -->
    
    <!-- <menuitem
        id="cohort_menu"
        name="Internship Placement"
        action="cohort_action"
        parent="cpdm_tree_menu"
        sequence="2"/> -->

    <menuitem 
        id="menu_placement_request" 
        name="TREE Match"
        parent="menu_root_cpdm"
        sequence="0"
        action="action_placement_request"/>

    <menuitem
        id="student_details_menu"
        name="Students"
        parent="menu_root_cpdm"
        sequence="3"/>
    <menuitem
        id="student_menu"
        name="Student Information"
        action="student_action"
        parent="student_details_menu"
        sequence="1"/>
    <menuitem
        id="hardship_request_menu"
        name="Hardship/Accommodation"
        action="hardship_request_action"
        parent="student_details_menu"
        sequence="2"/>
    <menuitem
        id="clinic_details_menu"
        name="Clinical Sites"
        parent="menu_root_cpdm"
        sequence="4"/>

    <menuitem
        id="configuration_menu"
        name="Configuration"
        parent="menu_root_cpdm"
        sequence="6"/>
        

    <menuitem
        id="placement_offer_menu"
        name="Offers"
        action="placement_offer_action"
        parent="menu_root_cpdm"
        sequence="5"/>

    <menuitem
        id="facility_menu"
        name="Clinical Sites"
        action="medical_facility_action"
        parent="clinic_details_menu"
        sequence="2"/>

    <menuitem
        id="scce_menu"
        name="SCCE"
        action="scce_action"
        parent="clinic_details_menu"
        sequence="3"/>
        
        <menuitem
        id="ci_menu"
        name="CI"
        action="ci_action"
        parent="clinic_details_menu"
        sequence="3"/>

        <record id="action_un_form" model="ir.actions.server">
            <field name="name">Program Profile Action</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">
user = env.user
action = user.action_open_user_company()
            </field>
        </record>

    <menuitem
        id="university_profile_menu"
        name="Program Profile"
        parent="configuration_menu"
        action="action_un_form"
        sequence="1"/>

    <menuitem
        id="program_menu"
        name="Program Duration"
        action="program_action"
        parent="configuration_menu"
        sequence="99"/>
    
    <menuitem
        id="attachment_type_menu"
        name="Program Attachment Type"
        action="clinical_decision_making.action_attachment_type"
        parent="configuration_menu"
        sequence="100"/>

    <menuitem
        id="scce_attachment_type_menu"
        name="Site Attachment Type"
        action="clinical_decision_making.action_scce_attachment_type"
        parent="configuration_menu"
        sequence="101"/>

    <menuitem
        id="clinical_experience_menu"
        name="Clinical Experience"
        action="clinical_decision_making.action_clinical_experience"
        parent="configuration_menu"
        sequence="15"
        />
    

    <menuitem
        id="archive_menu"
        name="Placement History"
        action="archive_action"
        parent="student_details_menu"
        sequence="5"/>
    <menuitem
        id="facility_contract_menu"
        name="Contracts"
        action="action_facility_contract"
        parent="clinic_details_menu"
        sequence="2"/>


    <!-- TODO Improve this for better performance
    <menuitem 
        id="placement_setting_menu"
        name="Placement"
        action="placement_setting_action"
        parent="setting_menu"
        sequence="5"/> -->

    <menuitem
        id="preferred_setting_menu"
        name="Settings Types"
        action="action_preferred_setting"
        parent="configuration_menu"
        sequence="99"/>

</odoo>
