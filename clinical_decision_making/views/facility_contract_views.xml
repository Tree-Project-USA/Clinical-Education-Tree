<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="facility_contract_history_view_list" model="ir.ui.view">
        <field name="name">clinical.site.contract.history.list</field>
        <field name="model">facility.contract.history</field>
        <field name="arch" type="xml">
            <tree string="Contracts"
                  default_order = 'date_start desc'
                  edit="false"
                  delete="false"
                  duplicate="false"
                  import="false"
                  create="false">
                <field name="is_under_contract" invisible="1"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="under_contract_state" widget="state_selection" optional="hide"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'close'"
                       decoration-success="state == 'open'"/>
                <field name="contract_count"/>
            </tree>
        </field>
    </record>


    <record id="facility_contract_history_view_form" model="ir.ui.view">
        <field name="name">facility.contract.history.form</field>
        <field name="model">facility.contract.history</field>
        <field name="arch" type="xml">
            <form string="Contract History"
                  create="false"
                  edit="false"
                  delete="false"
                  duplicate="false"
                  import="false">
                <header>
                    <button name="facility_contract_view_form_new_action" string="Create" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <h1>
                        <div class="d-flex justify-content-start">
                            <div>
                                <field name="display_name"/>
                            </div>
                            <div class="ps-3">
                                <field name="name"/>
                                <field name="under_contract_state" widget="state_selection" readonly="1"/>
                            </div>
                        </div>
                    </h1>
                    <group>
                        <group>
                            <field name="facility_id" string="Clinical Site"/>
                            <field name="contract_id" invisible="1"/>
                            <field name="country_code" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="History" name="contract_history">
                            <field name="contract_ids" widget="one2many" readonly="0">
                                <tree string="Current Contracts"
                                      decoration-primary="state == 'open'"
                                      decoration-muted="state == 'close'"
                                      decoration-bf="id == parent.contract_id"
                                      default_order = "date_start desc, state desc"
                                      editable="bottom"
                                      no_open="1"
                                      create="0" delete="0">
                                    <button name="action_open_contract_form" type="object" icon="fa-external-link" title="Open Contract"/>
                                    <field name="name" string="Contract Name" invisible="1"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'close'" decoration-success="state == 'open'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>



    <!-- facility Contract Views -->
    <record id="facility_contract_view_tree" model="ir.ui.view">
        <field name="name">clinical.site.contract.view.tree</field>
        <field name="model">facility.contract</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <tree>
                <field name="facility_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'close'" decoration-success="state == 'open'"/>
            </tree>
        </field>
    </record>

    <record id="facility_contract_view_form" model="ir.ui.view">
        <field name="name">clinical.site.contract.view.form</field>
        <field name="model">facility.contract</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Current Contract">
                <header>
                    <button name="facility_contract_view_form_renewal_action" string="RENEW CONTRACT" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'require_renewal')]}"/>
                    <button name="action_cancel" string="CANCEL CONTRACT" type="object" class="btn btn-danger" attrs="{'invisible': [('state', '=', 'cancel')]}" data-hotkey="c"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title mb24">
                        <h1>
                            <field id="name" class="text-break" name="name" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="date_start" string="Dates"/>
                            <div class="o_row">
                                <span class="text-muted">From</span>
                                <field name="date_start" class="oe_inline" widget="daterange" options="{'related_end_date': 'date_end'}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <span class="text-muted">To</span>
                                <field name="date_end" class="oe_inline" widget="daterange" options="{'related_end_date': 'date_start'}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </div>
                        </group>
                        <group>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Details" name="other">
                            <group><field name="contract_attachment" required="1"/></group>
                            <group name="notes_group" string="Notes">
                                <field name="notes" nolabel="1" colspan="2" placeholder="Type in notes about this contract..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>