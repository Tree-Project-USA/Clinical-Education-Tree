<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View facility.department View Tree -->
    <record id="view_facility_department_tree" model="ir.ui.view">
        <field name="name">view.facility.department.tree</field>
        <field name="model">facility.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="facility_id" invisible="1"/>
                <field name="name"/>
                <field name="scce_ids" widget="many2many_tags"/>
                <field name="setting_ids" widget="many2many_tags"/>
                <field name="street"/>
                <field name="city"/>
                <field name="state"/>
                <field name="geographical_id"/>
                <field name="active_state" widget="badge" decoration-danger="active_state == 'not_active'" decoration-success="active_state == 'active'"/>
            </tree>
        </field>
    </record>

    <!-- View facility.department form -->
    <record id="view_facility_department_form" model="ir.ui.view">
        <field name="name">view.facility.department.form</field>
        <field name="model">facility.department</field>
        <field name="arch" type="xml">
            <form>
                <field name="is_main_department" invisible="1"/>
                <field name="facility_scce_ids" invisible="1"/>
                <field name="active" invisible="1"/>
                <header></header>
                <sheet>
                    <widget name="web_ribbon" title="Not Active" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div name="button_box" position="inside">
                        <button name="action_open_department_archive_offer" type="object" class="oe_stat_button" string="Avalible Offers">
                            <field name="archive_offer_count" widget="statinfo" string="Offers History"/>
                        </button>
                        <button name="action_view_placement_history" type="object" class="oe_stat_button" string="Placement History">
                            <field name="archive_count" widget="statinfo" string="Placement History"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_students" type="object" icon="fa-users">
                            <field name="student_count" string="Students" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..." required="1" attrs="{'readonly': [('is_main_department', '=', True)]}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="facility_id" required="1"/>
                            <field name="street" attrs="{'readonly': [('is_main_department', '=', True)]}"/>
                            <field name="geographical_id" required="1" attrs="{'readonly': [('is_main_department', '=', True)]}"/>
                        </group>
                        <group>
                            <field name="city"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Setting">
                            <field name="setting_ids"/>
                        </page>
                        <page string="SCCE">
                            <field name="scce_ids" options="{'no_open': True, 'no_create': True, 'create': False}" widget="one2many">
                                <tree>
                                    <field name="first_name"/>
                                    <field name="last_name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Placement History">
                            <field name="archive_ids" options="{'no_open': True, 'no_create': True, 'create': False}" widget="one2many">
                                <tree>
                                    <field name="studentid"/>
                                    <field name="student_id"/>
                                    <field name="facility_id"/>
                                    <field name="company_id"/>
                                    <field name="experience_id"/>
                                    <field name="setting"/>
                                    <field name="placement_term"/>
                                    <field name="year"/>
                                    <field name="city"/>
                                    <field name="state"/>
                                    <field name="geographical_id"/>
                                    <field name="placement_status"/>
                                    <field name="is_show_student" widget="boolean_toggle" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View facility.department search -->
    <record id="view_facility_department_search" model="ir.ui.view">
        <field name="name">view.facility.department.search</field>
        <field name="model">facility.department</field>
        <field name="arch" type="xml">
            <search string="Facility Department">
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action facility.department -->
    <record id="action_facility_department" model="ir.actions.act_window">
        <field name="name">Facility Department</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">facility.department</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
