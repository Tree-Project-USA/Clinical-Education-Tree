<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SCCE Views -->
    <record id="scce_view_tree" model="ir.ui.view">
        <field name="name">scce.view.tree</field>
        <field name="model">scce</field>
        <field name="arch" type="xml">
            <tree>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="email"/>
            </tree>
        </field>
    </record>
    <record id="scce_view_form" model="ir.ui.view">
        <field name="name">scce.view.form</field>
        <field name="model">scce</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Site Views -->
    <record id="site_view_tree" model="ir.ui.view">
        <field name="name">site.view.tree</field>
        <field name="model">site</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email"/>
                <field name="address"/>
                <field name="city_id"/>
                <field name="state_id"/>
                <field name="zip"/>
                <field name="setting_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </tree>
        </field>
    </record>
    <record id="site_view_form" model="ir.ui.view">
        <field name="name">site.view.form</field>
        <field name="model">site</field>
        <field name="arch" type="xml">
            <form>
                <field name="contract_attachment" invisible="1"/>
                <sheet>
                    <div name="button_box" position="inside">
                        <field name="contract_warning" invisible="1"/>
                        <button name="action_open_contract_history"
                            class="oe_stat_button"
                            icon="fa-book"
                            type="object">
                            <div attrs="{'invisible' : [('first_contract_date', '=', False)]}" class="o_stat_info">
                                <span class="o_stat_text text-success" attrs="{'invisible' : [('contract_warning', '=', True)]}" title="In Contract Since"> In Contract Since</span>
                                <span class="o_stat_value text-success" attrs="{'invisible' : [('contract_warning', '=', True)]}">
                                    <field name="first_contract_date" readonly="1"/>
                                </span>
                                <span class="o_stat_text text-danger" attrs="{'invisible' : [('contract_warning', '=', False)]}" title="In Contract Since">
                                    In Contract Since
                                </span>
                                <span class="o_stat_value text-danger" attrs="{'invisible' : [('contract_warning', '=', False)]}">
                                    <field name="first_contract_date" readonly="1"/>
                                </span>
                            </div>
                            <div attrs="{'invisible' : [('first_contract_date', '!=', False)]}" class="o_stat_info">
                                <span class="o_stat_value text-danger">
                                   <field name="contracts_count"/>
                                </span>
                                <span attrs="{'invisible' : [('contracts_count', '!=', 1)]}" class="o_stat_text text-danger" >
                                    Contract
                                </span>
                                <span attrs="{'invisible' : [('contracts_count', '=', 1)]}" class="o_stat_text text-danger">
                                    Contracts
                                </span>
                            </div>
                        </button>
                        <button
                            name="print_report"
                            type="object"
                            string="Contact Attachment File"
                            class="oe_highlight"
                            icon="fa-download"
                            attrs="{'invisible' : [('contract_attachment', '=', False)]}"
                            >
                        </button>
                    </div>
                    <group>
                        <label for="name"/>
                        <field name="name"/>
                        <group>
                            <field name="setting_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="email"/>
                            <field name="address"/>
                            <field name="city_id"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                            <field name="zip"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Setting Views -->
    <record id="category_setting_view_tree" model="ir.ui.view">
        <field name="name">category.setting.view.tree</field>
        <field name="model">category.setting</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>
    <record id="category_setting_view_form" model="ir.ui.view">
        <field name="name">category.setting.view.form</field>
        <field name="model">category.setting</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Location Setting Views -->
    <record id="location_setting_view_tree" model="ir.ui.view">
        <field name="name">location.setting.view.tree</field>
        <field name="model">location.setting</field>
        <field name="arch" type="xml">
            <tree>
                <field name="student_id"/>
                <field name="state_id"/>
                <field name="city_id"/>
                <field name="zip"/>
            </tree>
        </field>
    </record>
    <record id="location_setting_view_form" model="ir.ui.view">
        <field name="name">location.setting.view.form</field>
        <field name="model">location.setting</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <label for="student_id" attrs="{'readonly': [('id', '!=', False)]}"/>
                        <field name="student_id"/>
                        <group>
                            <field name="state_id"/>
                        </group>
                        <group>
                            <field name="city_id"/>
                            <field name="zip"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>