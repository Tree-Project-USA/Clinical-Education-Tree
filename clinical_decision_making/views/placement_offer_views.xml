<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record model="ir.ui.view" id="placement_offer_view_tree">
            <field name="name">placement.offer.tree</field>
            <field name="model">placement.offer</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="priority" optional="show" widget="priority" nolabel="1" invisible="1"/>
                    <field name="name" invisible="1"/>
                    <field name="facility_id" string="Clinical Site"/>
                    <field name="state" widget="badge" 
                    decoration-primary="state == 'offer_matched'" 
                    decoration-success="state == 'offer_still_available'" 
                    decoration-warning="state == 'offer_cancel'" 
                    decoration-muted="state == 'offer_details_entered'"/>
                    <field name="create_date"/>
                    <field name="create_uid"/>
                    </tree>
                </field>
            </record>

            <!-- Form View -->
            <record model="ir.ui.view" id="placement_offer_view_form">
                <field name="name">placement.offer.form</field>
                <field name="model">placement.offer</field>
                <field name="arch" type="xml">
                    <form>
                        <field name="is_single_facility" invisible="1"/>
                        <field name="active" invisible="1"/>
                        <header>
                            <button name="action_prograss" string="Approve" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'offer_details_entered')]}" data-hotkey="v"/>
                            <button name="action_draft" string="Return to Offer Details" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'in', ['offer_details_entered', 'offer_matched'])]}" data-hotkey="w"/>
                            <button name="action_cancel" string="Cancel Offer" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'offer_still_available')]}" data-hotkey="c"/>
                            <field name="state" widget="statusbar" clickable="False"/>
                        </header>

                        <sheet>
                            <widget name="web_ribbon" title="Not Active" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                            <div class="oe_button_box" name="button_box">
                                <button name="action_open_archive_offer_ids" type="object" class="oe_stat_button" string="Avalible Offers">
                                    <field name="archive_offer_count" widget="statinfo" string="Available Offers"/>
                                </button>
                            </div>
                            <div class="oe_title" invisible="1">
                                <span class="o_form_label">Seq </span>
                                <h1 class="d-flex">
                                    <field name="priority" widget="priority" class="me-3"/>
                                    <field name="name" readonly="1"/>
                                    <field name="company_id" string="University" groups="base.group_multi_company"/>
                                    <br/>
                                </h1>
                            </div>
                            <group>
                                <group>
                                    <!-- <field name="student_id"/> -->
                                    <field name="scce_id" string="SCCE"/>
                                    <field name="facility_id" string="Clinical Site" attrs="{'readonly': [('state', '!=', 'offer_details_entered')]}"/>
                                    <field name="main_department_id" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>

                                </group>
                                <group>
                                    <field name="city" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                                    <field name="geographical_state" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                                    <field name="zip_code" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                                </group>
                            </group>
                            <notebook>
                                <page string="Offers">
                                    <field name="line_ids" attrs="{'readonly': [('state', '!=', 'offer_details_entered')]}">
                                        <tree editable="bottom">
                                            <field name="facility_id" invisible="1"/>
                                            <field name="department_ids" invisible="1"/>
                                            <field name="department_id" attrs="{'column_invisible':[('parent.is_single_facility', '=', True)], 'required':[('parent.is_single_facility', '=', False)]}"/>
                                            <field name="company_id" string="University" groups="base.group_multi_company"/>
                                            <field name="experience_id" required="1" widget="many2many_tags"/>
                                            <field name="placement_term" required="1"/>
                                            <field name="year" force_save="1" required="1"/> 
                                            <field name="setting" string="Offer Setting Type"/>
                                            <field name="offers" string="Number of Offers"/>
                                            <field name="street" optional="hide" attrs="{'column_invisible':[('parent.is_single_facility', '=', True)]}"/>
                                            <field name="city" optional="hide" attrs="{'column_invisible':[('parent.is_single_facility', '=', True)]}"/>
                                            <field name="state" optional="hide" attrs="{'column_invisible':[('parent.is_single_facility', '=', True)]}"/>
                                            <field name="geographical_id" optional="hide" attrs="{'column_invisible':[('parent.is_single_facility', '=', True)]}"/>
                                        </tree>
                                    </field>
                                </page>
                            </notebook>
                        </sheet>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" groups="base.group_user"/>
                            <field name="message_ids"/>
                        </div>
                    </form>
                </field>
            </record>

        <!-- List View -->
        <record model="ir.ui.view" id="archive_offer_view_tree">
            <field name="name">archive.offer.tree</field>
            <field name="model">archive.offer</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false" delete="false">
                    <field name="active" invisible="1"/>
                    <field name="student_id"/>
                    <field name="is_linked" />
                    <field name="department_id"/>
                    <field name="facility_id"/>
                    <field name="offer_id"/>
                    <field name="offer_line_id"/>
                    <field name="setting"/>
                    <field name="experience_id"/>
                    <field name="company_id" string="University" groups="base.group_multi_company"/>
                    <field name="placement_term"/>
                    <field name="year"/>
                    <field name="term"/>
                    </tree>
                </field>
            </record>

        <record id="action_archive_offer" model="ir.actions.act_window">
            <field name="name">Offers</field>
            <field name="res_model">archive.offer</field>
            <field name="view_mode">tree</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        </record>

        </data>
    </odoo>