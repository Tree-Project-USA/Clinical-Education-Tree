<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record model="ir.ui.view" id="placement_offer_view_tree">
            <field name="name">placement.offer.tree</field>
            <field name="model">placement.offer</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="priority" optional="show" widget="priority" nolabel="1"/>
                    <field name="name" />
                    <field name="facility_id"/>
                    <field name="year"/>
                    <field name="placement_type"/>
                    <field name="placement_term"/>
                    <field name="state" widget="badge" 
                    decoration-primary="state == 'done'" 
                    decoration-success="state == 'placementing'" 
                    decoration-warning="state == 'cancel'" 
                    decoration-muted="state == 'draft'"/>
                    <field name="create_date"/>
                    <field name="create_uid"/>
                    </tree>
                </field>
            </record>

            <!-- Form View -->
            <record model="ir.ui.view" id="placement_offer_view_form">
                <field name="name">placement.offer.form</field>
                <field name="model">placement.offer</field>
                <field name="arch" type="xml">
                    <form>
                        <header>
                            <button name="action_prograss" string="Confirm" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" data-hotkey="v"/>
                            <button name="action_draft" string="Return To Draft" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'in', ['draft', 'done'])]}" data-hotkey="w"/>
                            <button name="action_cancel" string="Cancel" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'placementing')]}" data-hotkey="c"/>
                            <field name="state" widget="statusbar" clickable="False"/>
                        </header>

                        <sheet>
                            <div class="oe_button_box" name="button_box">
                                <button name="action_open_archive_offer_ids" type="object" class="oe_stat_button" icon="fa-bullhorn" string="Avalible Offers">
                                    <field name="archive_offer_count" widget="statinfo" string="Offers"/>
                                </button>
                            </div>
                            <div class="oe_title">
                                <span class="o_form_label">Seq </span>
                                <h1 class="d-flex">
                                    <field name="priority" widget="priority" class="me-3"/>
                                    <field name="name" readonly="1"/>
                                    <br/>
                                </h1>
                            </div>
                            <group>
                                <group>
                                    <!-- <field name="student_id"/> -->
                                    <field name="facility_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="placement_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="placement_term" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="year" force_save="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                </group>
                                <group>
                                    <field name="zip_code"/>
                                    <field name="geographical_state"/>
                                    <field name="city"/>
                                </group>
                            </group>
                            <notebook>
                                <page string="Offer Lines">
                                    <field name="line_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                        <tree editable="bottom">
                                            <field name="name" required="1"/>
                                            <field name="setting"/>
                                            <field name="offers"/>
                                        </tree>
                                    </field>
                                </page>
                            </notebook>
                        </sheet>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" groups="base.group_user"/>
                            <field name="message_ids"/>
                        </div>
                    </form>
                </field>
            </record>

        <!-- List View -->
        <record model="ir.ui.view" id="archive_offer_view_tree">
            <field name="name">archive.offer.tree</field>
            <field name="model">archive.offer</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false" delete="false">
                    <field name="student_id"/>
                    <field name="is_linked" />
                    <field name="facility_id"/>
                    <field name="offer_id"/>
                    <field name="offer_line_id"/>
                    <field name="setting"/>
                    <field name="placement_type"/>
                    <field name="placement_term"/>
                    <field name="year"/>
                    <field name="term"/>
                    </tree>
                </field>
            </record>

        <record id="action_archive_offer" model="ir.actions.act_window">
            <field name="name">Offers</field>
            <field name="res_model">archive.offer</field>
            <field name="view_mode">tree</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        </record>

        </data>
    </odoo>