<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

    <!-- Medical Facility Views -->
    <record id="medical_facility_view_tree" model="ir.ui.view">
        <field name="name">medical.facility.view.tree</field>
        <field name="model">medical.facility</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Facility Name"/>
                <field name="scce_first_name" string="SCCE First Name"/>
                <field name="scce_last_name" string="SCCE Last Name"/>
                <field name="email" string="SCCE Email Address"/>
                <field name="address" string="Facility Address"/>
                <field name="city"/>
                <field name="state"/>
                <field name="geographical_id"/>
            </tree>
        </field>
    </record>

    <record id="medical_facility_view_search" model="ir.ui.view">
        <field name="name">medical.facility.view.search</field>
        <field name="model">medical.facility</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="address"/>
                <field name="geographical_id"/>
                <field name="city"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="medical_facility_view_form" model="ir.ui.view">
        <field name="name">medical.facility.view.form</field>
        <field name="model">medical.facility</field>
        <field name="arch" type="xml">
            <form>
                <field name="contract_attachment" invisible="1"/>
                <field name="is_single_facility" invisible="1"/>
                <field name="active" invisible="1"/>
                <header>
                <button name="facility_multi_department"
                    string="Apply Multi Department"
                    type="object"
                    attrs="{'invisible':[('is_single_facility', '=', False)]}"
                />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Not Active" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div name="button_box" position="inside">
                        <field name="contract_warning" invisible="1"/>
            
                        <button type="object" name="action_open_department_archive"
                                class="text-center fa fa-fw fa-circle text-success"
                                attrs="{'invisible': [('active', '=', False)]}">
                            <span style="padding:10px;">Active</span>
                        </button>
                        <button type="object" name="action_open_department_archive"
                                class="fa fa-fw fa-circle text-center"
                                attrs="{'invisible': [('active', '=', True)]}">
                            <span style="padding:10px;">Not Active</span>
                        </button>

                        <button name="action_open_contract_history"
                            class="oe_stat_button"
                            icon="fa-book"
                            type="object">
                            <div class="o_stat_info">
                                <span class="o_stat_text text-danger" >
                                    Contract
                                </span>
                            </div>
                        </button>

                        <button name="action_open_facility_department" type="object" class="oe_stat_button" string="Department">
                            <field name="department_count" widget="statinfo" string="Departments"/>
                        </button>
                        <button
                            name="action_open_placement_offer"
                            type="object"
                            string="Offers"
                            class="oe_highlight"
                            icon="fa-ticket"
                            >
                        </button>
                        <button name="action_view_placement_history" type="object" class="oe_stat_button" string="Placement History">
                            <field name="archive_count" widget="statinfo" string="Placement History"/>
                        </button>
                        <button name="action_open_placement_archive_offer" type="object" class="oe_stat_button" string="Avalible Offers">
                            <field name="archive_offer_count" widget="statinfo" string="Offers History"/>
                        </button>
                    </div>
                    <group>
                        <label for="name" string="Facility Name"/>
                        <field name="name"/>
                        <field name="company_id" string="university" readonly="1"/>
                        <group>
                            <field name="email" string="Facility Email Address"/>
                            <field name="address" string="Facility Address"/>
                            <field name="scce_primary_id" string="SCCE Primary" invisible="1"/>
                            <field name="scce_first_name" string="SCCE Last Name" invisible="1"/>
                            <field name="scce_last_name" string="SCCE Last Name" invisible="1"/>
                            <field name="setting_ids" widget="many2many_tags" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="city" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                            <field name="state" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                            <field name="geographical_id" attrs="{'invisible':[('is_single_facility', '=', False)]}"/>
                            <field name="setting_ids" widget="many2many_tags" attrs="{'invisible':[('is_single_facility', '=', True)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Department" attrs="{'invisible':[('is_single_facility', '=', True)]}">
                            <field name="department_ids">
                                <tree editable="bottom" decoration-primary="is_main_department==True">
                                    <field name="is_main_department" invisible="1"/>
                                    <field name="company_id" string="university" readonly="1"/>
                                    <field name="facility_id" invisible="1"/>
                                    <field name="name" required="1"/>
                                    <field name="scce_ids" domain="[('id', 'in', parent.scce_ids)]" widget="many2many_tags"/>
                                    <field name="setting_ids" widget="many2many_tags"/>
                                    <field name="city"/>
                                    <field name="state"/>
                                    <field name="geographical_id" required="1"/>
                                    <field name="active_state" widget="badge" decoration-danger="active_state == 'not_active'" decoration-success="active_state == 'active'"/>
                                    <button name="action_view_facility_department" type="object" icon="fa-external-link" title="Open Department Details"/>
                                </tree>
                            </field>
                        </page>
                        <page string="SCCE Information">
                            <field name="scce_ids" widget="one2many">
                                <tree editable="bottom" class="prima">
                                    <field name="facility_id" invisible="1"/>
                                    <field name="scce_id"/>
                                    <field name="is_primary_scce" widget="boolean_toggle" readonly="1" invisible="1"/>
                                    <button string="Set to Primary" name="action_set_primary" type="object" icon="fa-check" attrs="{'invisible': [('is_primary_scce', '=', True)]}"/>
                                    <field name="is_secondary_scce" widget="boolean_toggle" readonly="1" invisible="1"/>
                                    <button string="Set to Secondary" name="action_set_secondary" type="object" icon="fa-check" attrs="{'invisible': [('is_secondary_scce', '=', True)]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Placement History">
                            <field name="archive_ids" options="{'no_open': True, 'no_create': True, 'create': False}" widget="one2many">
                                <tree>
                                    <field name="department_id"/>
                                    <field name="student_id"/>
                                    <field name="company_id" string="university" readonly="1"/>
                                    <field name="experience_id"/>
                                    <field name="setting"/>
                                    <field name="placement_term"/>
                                    <field name="year"/>
                                    <field name="city"/>
                                    <field name="state"/>
                                    <field name="geographical_id"/>
                                    <field name="placement_status"/>
                                    <field name="is_show_student" widget="boolean_toggle" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    </data>
</odoo>