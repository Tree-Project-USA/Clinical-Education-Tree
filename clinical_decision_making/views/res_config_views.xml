<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="view_cdmp_config_settings" model="ir.ui.view">
            <field name="name">config.tree.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='integration']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box" id="cdmp_tree">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Clinical Decision Making Tree</span>
                            <div class="text-muted">
                                Clinical Decision Making
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="max_distance_mel" string="Min Distance Miles"/>
                                    <field name="max_distance_mel" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="clinical_distance_mel" string="Clinical Distance Miles"/>
                                    <field name="clinical_distance_mel" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="zip_code_token" string="Access Token"/>
                                    <field name="zip_code_token" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="max_hardship_zipcodes" string="Number of Hardship Zipcodes"/>
                                    <field name="max_hardship_zipcodes" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="normal_number_zipcodes" string="Normal of number Student zipcodes"/>
                                    <field name="normal_number_zipcodes" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="max_zipcodes_state" string="Maximum Zip code in State"/>
                                    <field name="max_zipcodes_state" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="contract_notify_months" string="Months for notify Facility"/>
                                    <field name="contract_notify_months" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>