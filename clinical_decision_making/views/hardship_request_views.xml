<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hardship Request Views -->
    <record id="hardship_request_view_tree" model="ir.ui.view">
        <field name="name">hardship.request.view.tree</field>
        <field name="model">hardship.request</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <tree>
                <field name="studentid"/>
                <field name="student_id"/>
                <field name="create_date"/>
                <field name="expiration_date"/>
                <field name="state" widget="badge" decoration-muted="state == 'initial_submission'"  decoration-danger="state == 'expired'"  decoration-warning="state == 'update_required'" decoration-success="state == 'approved'"/>
            </tree>
        </field>
    </record>

    <record id="hardship_view_search" model="ir.ui.view">
        <field name="name">hardship.request.view.search</field>
        <field name="model">hardship.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="studentid"/>
                <field name="student_id"/>
                <field name="create_date"/>
                <field name="expiration_date"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="hardship_request_view_form" model="ir.ui.view">
        <field name="name">hardship.request.view.form</field>
        <field name="model">hardship.request</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Request">
                <header>
                    <button name="action_return_initial_submission" string="RETURN TO INITIAL SUBMISSION" type="object" class="btn btn-primary" attrs="{'invisible': [('state', 'in', ['initial_submission', 'placementing'])]}" data-hotkey="c"/>
                    <button name="action_open_update_view" string="UPDATE INFORMATION" type="object" class="btn btn-warning" data-hotkey="u"/>
                    <button name="action_attachment_file_confirm" string="APPROVE" type="object" class="oe_highlight" attrs="{'invisible': ['|',('state', '=', 'approved'), ('state', '=', 'expired')]}" data-hotkey="c"/>
                    <button name="action_attachment_file_cancel" string="DECLINE" type="object" class="btn btn-danger" attrs="{'invisible': ['|',('state', '=', 'approved'), ('state', '=', 'expired')]}" data-hotkey="c"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Expired" bg_color="bg-danger" attrs="{'invisible': [('state', '!=', 'expired')]}"/>
                    <widget name="web_ribbon" title="Update Required" bg_color="bg-warning" attrs="{'invisible': [('state', '!=', 'update_required')]}"/>
                    <widget name="web_ribbon" title="Approved" bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                    <group>
                        <field name="studentid"/>
                        <field name="student_id" attrs="{'readonly': [('state', 'in', ('expired', 'approved'))]}"/>
                        <field name="create_date"/>
                        <field name="expiration_date"/>
                    </group>
                <notebook>
                    <page string="Preferred Addresses" name="geographical_ids">
                        <field name="geographical_ids" attrs="{'readonly': [('state', 'in', ('expired', 'approved'))]}">
                            <tree editable="bottom">
                                <field name="city"/>
                                <field name="state"/>
                                <field name="zip_code"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Attachment" name="attachment_ids">
                        <field name="attachment_ids" widget="many2many_attachment_preview" string="Attach a file" nolabel="1" attrs="{'readonly': [('state', 'in', ('cancel', 'confirm'))]}"/>
                    </page>
                    <page string="Notes" name="notes">
                        <field name="note" attrs="{'readonly': [('state', 'in', ('expired', 'approved'))]}"/>
                    </page>
                    <page string="Student Geographical" name="student_geographical_ids" invisible="1">
                        <field name="student_geographical_ids" attrs="{'readonly': [('state', 'in', ('expired', 'approved'))]}"/>
                    </page>
                </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

        <!-- view form for reject message -->
        <record id="hardship_request_update_view_form" model="ir.ui.view">
            <field name="name">hardship.request.view.form</field>
            <field name="model">hardship.request</field>
            <field name="arch" type="xml">
                <form>
                    <div>
                        <p>
                            <field name="update_message" required="1"/>
                        </p>
                    </div>
                    <footer>
                        <button name="action_update" string="Send to Update" class="oe_highlight" type="object" />
                                or
                        <button special="cancel" string="Cancel" class="oe_link" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- view form for Attachment File Cancel -->
        <record id="hardship_request_attachment_file_cancel_view_form" model="ir.ui.view">
            <field name="name">hardship.request.view.form</field>
            <field name="model">hardship.request</field>
            <field name="arch" type="xml">
                <form>
                    <div>
                        <p>
                            <field name="attachment_cancel" required="1"/>
                        </p>
                    </div>
                    <footer>
                        <button name="action_cancel" string="Send" class="oe_highlight" type="object" />
                                
                        <button special="cancel" string="Cancel" class="oe_link" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- view form for Attachment File Cancel -->
        <record id="hardship_request_attachment_file_confirm_view_form" model="ir.ui.view">
            <field name="name">hardship.request.view.form</field>
            <field name="model">hardship.request</field>
            <field name="arch" type="xml">
                <form>
                    <div>
                        <p>
                            <field name="attachment_confirm" />
                        </p>
                    </div>
                    <footer>
                        <button name="action_confirm" string="Confirm" class="oe_highlight" type="object" />
                                
                        <button special="cancel" string="Cancel" class="oe_link" />
                    </footer>
                </form>
            </field>
        </record>

</odoo>