<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hardship Request Views -->
    <record id="hardship_request_view_tree" model="ir.ui.view">
        <field name="name">hardship.request.view.tree</field>
        <field name="model">hardship.request</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <tree>
                <field name="student_id"/>
                <field name="create_date"/>
                <field name="state" widget="badge" decoration-muted="state == 'draft'"  decoration-danger="state == 'cancel'"  decoration-warning="state == 'update'" decoration-success="state == 'confirm'"/>
            </tree>
        </field>
    </record>

    <record id="hardship_view_search" model="ir.ui.view">
        <field name="name">hardship.request.view.search</field>
        <field name="model">hardship.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="create_date"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="hardship_request_view_form" model="ir.ui.view">
        <field name="name">hardship.request.view.form</field>
        <field name="model">hardship.request</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Request">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" attrs="{'invisible': ['|',('state', '=', 'confirm'), ('state', '=', 'cancel')]}" data-hotkey="c"/>
                    <button name="action_open_update_view" string="Update Information" type="object" class="btn btn-warning" data-hotkey="u"/>
                    <button name="action_return_draft" string="Return To Draft" type="object" class="btn btn-primary" attrs="{'invisible': [('state', 'in', ['draft', 'placementing'])]}" data-hotkey="c"/>
                    <button name="action_attachment_file_cancel" string="Cancel" type="object" class="btn btn-danger" attrs="{'invisible': ['|',('state', '=', 'confirm'), ('state', '=', 'cancel')]}" data-hotkey="c"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
                    <widget name="web_ribbon" title="Required Update" bg_color="bg-warning" attrs="{'invisible': [('state', '!=', 'update')]}"/>
                    <widget name="web_ribbon" title="Validated" bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'confirm')]}"/>
                    <group>
                        <field name="student_id" attrs="{'readonly': [('state', 'in', ('cancel', 'confirm'))]}"/>
                        <field name="create_date"/>
                        <field name="expiration_date"/>
                    </group>
                <notebook>
                    <page string="Geographical" name="geographical_ids">
                        <field name="geographical_ids" attrs="{'readonly': [('state', 'in', ('cancel', 'confirm'))]}"/>
                    </page>
                    <page string="Attachment" name="attachment_ids">
                        <field name="attachment_ids" widget="many2many_binary" string="Attach a file" nolabel="1" colspan="2" attrs="{'readonly': [('state', 'in', ('cancel', 'confirm'))]}"/>
                    </page>
                    <page string="Notes" name="notes">
                        <field name="note" attrs="{'readonly': [('state', 'in', ('cancel', 'confirm'))]}"/>
                    </page>
                    <page string="Student Geographical" name="student_geographical_ids">
                        <field name="student_geographical_ids" attrs="{'readonly': [('state', 'in', ('cancel', 'confirm'))]}"/>
                    </page>
                </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

        <!-- view form for reject message -->
        <record id="hardship_request_update_view_form" model="ir.ui.view">
            <field name="name">hardship.request.view.form</field>
            <field name="model">hardship.request</field>
            <field name="arch" type="xml">
                <form>
                    <div>
                        <p>
                            <field name="update_message" required="1"/>
                        </p>
                    </div>
                    <footer>
                        <button name="action_update" string="Send to Update" class="oe_highlight" type="object" />
                                or
                        <button special="cancel" string="Cancel" class="oe_link" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- view form for Attachment File Cancel -->
        <record id="hardship_request_attachment_file_cancel_view_form" model="ir.ui.view">
            <field name="name">hardship.request.view.form</field>
            <field name="model">hardship.request</field>
            <field name="arch" type="xml">
                <form>
                    <div>
                        <p>
                            <field name="attachment_cancel" required="1"/>
                            <field name="attachment_cancel_id" required="1"/>
                        </p>
                    </div>
                    <footer>
                        <button name="action_update" string="Send to Update" class="oe_highlight" type="object" />
                                
                        <button special="cancel" string="Cancel" class="oe_link" />
                    </footer>
                </form>
            </field>
        </record>

</odoo>