<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Student Views -->
    <record id="student_view_tree" model="ir.ui.view">
        <field name="name">student.view.tree</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="cohort_label"/>
                <field name="email"/>
                <field name="personal_phone"/>
                <field name="home_address"/>
            </tree>
        </field>
    </record>

    <record id="partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.view.search</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cohort_label"/>
                <field name="email"/>
                <field name="personal_phone"/>
                <field name="home_address"/>
                <field name="contact_address"/>
            </search>
        </field>
    </record>

    <record id="student_view_form" model="ir.ui.view">
        <field name="name">student.view.form</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Partners">
                <header>
                    <button name="alternative_schedule_term_action" string="Alternative Schedule" type="object"/>
                </header>
                <field name="active" invisible="1"/>
                <field name="is_student" invisible="1"/>
                <field name="hardship_count" invisible="1"/>
                <field name="alternative_schedule_count" invisible="1"/>
                <sheet>
                    <div name="button_box" position="inside">
                        <button type="object" name="archive_unarchive_student"
                                class="text-center fa fa-fw fa-circle text-success"
                                attrs="{'invisible': [('active', '=', False)]}">
                            <span style="padding:10px;">Active</span>
                        </button>
                        <button type="object" name="archive_unarchive_student"
                                class="fa fa-fw fa-circle text-center"
                                attrs="{'invisible': [('active', '=', True)]}">
                            <span style="padding:10px;">Not Active</span>
                        </button>
                        <button name="action_open_hardship" type="object" class="oe_stat_button" attrs="{'invisible': [('hardship_count', '=', 0)]}">
                            <span class="o_stat_text">Hardship<br/>Request</span>
                        </button>
                        <button name="action_view_alternative_schedule" type="object" class="oe_stat_button" attrs="{'invisible': [('alternative_schedule_count', '=', 0)]}">
                            <span class="o_stat_text">Alternative Schedule History</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Not Active" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div>
                        <h1>
                            <field name="name" placeholder="Student Name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <span class="o_form_label o_td_label" name="address_name">
                                <b>Student Name</b>
                            </span>
                            <div class="o_address_format">
                                <field name="first_name" placeholder="Student First Name" required="1" class="o_address_city"/>
                                <field name="last_name" class="o_address_state" required="1" placeholder="Student Last Name"/>
                            </div>
                            <field name="is_with_hardship" invisible="1"/>
                            <field name="campus" readonly="1"/>
                            <field name="program_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="program_type" readonly="1"/>
                            <field name="start_year"/>
                            <field name="start_term_type"/>
                            <field name="cohort_label"/>
                            <field name="start_term" invisible="1"/>
                            <field name="graduation_term"/>
                        </group>
                        <group>
                            <field name="home_address"/>
                            <field name="phone" string="Home Phone"/>
                            <field name="personal_phone"/>
                            <field name="personal_email_address"/>
                            <field name="email" string="University Email Address" required="1"/>
                            <field name="student_signature" widget="signature" invisible="1" />
                            <field name="student_signature_date" invisible="1"  />
                            <field name="ci_signature" widget="signature" invisible="1" />
                            <field name="ci_signature_date" invisible="1" />
                        </group>
                    </group>

                    <notebook>                           
                            <page name='experience_schedual' string="Experience Schedule">
                                <field name="experience_schedual_ids">
                                <tree>
                                    <field name="student_id" invisible="1"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="experience_id"/>
                                    <field name="placement_term"/>
                                    <field name="year"/>
                                    <field name="archive_create_date"/>
                                    <field name="placement_status" widget="badge"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Placement History" name="student_archive">
                            <field name="archive_ids" mode="tree">
                                <tree editable="bottom" delete="false">
                                    <field name="student_id" invisible="1"/>
                                    <field name="term" invisible="1"/>
                                    <field name="archive_offer_id" invisible="1"/>
                                    <field name="company_id" string="University" groups="base.group_multi_company"/>
                                    <field name="is_declined" invisible="1"/>
                                    <field name="facility_id" readonly="1"/>
                                    <field name="department_id" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="experience_id" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="placement_term" readonly="1" force_save="1"/>
                                    <field name="year" readonly="1" force_save="1"/>
                                    <field name="setting" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="city" string="Student Preferred City"/>
                                    <field name="state" string="Student Preferred State"/>
                                    <field name="geographical_id" string="Student Preferred Zip Code" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="placement_status" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <!-- <button name="unlink_offer" type="object" string="Cancel Placement" class="btn btn-outline-danger" attrs="{'invisible': [('placement_status', 'not in', ['approved', 'pending'])]}"/> -->
                                    <field name="is_show_student" widget="boolean_toggle" />
                                    <button name="apply_student_offer" type="object" string="Re-Apply offer " class="btn btn-outline-secondary"  attrs="{'invisible': [('is_declined', '!=', True)]}"/>
                                    <button name="action_open_archive_log" type="object" string="Placement Log" icon="fa-external-link" title="Open Log"/>

                                    <field name="zip_code" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Preferred Addresses" name="student_geographical" autofocus="autofocus">
                            <field name="preferred_geographical_ids" mode="tree">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="student_id" invisible="1"/>
                                    <field name="city"/>
                                    <field name="state"/>
                                    <field name="geographical_id"/>
                                </tree>
                            </field>
                        </page>

                        <page name='preferred_settings' string="Preferred Settings">
                            <field name="preferred_setting_ids" mode="tree">
                                <tree editable="bottom" create="false">
                                    <field name="name" string="Setting"/>
                                    <field name="type_setting"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page name='post_placement_managament' string="Post Placement Managament">
                            <field name="plcement_management_ids" mode="tree">
                            <tree editable="bottom">
                                <field name="company_id" invisible="1"/>
                                <field name="experience_id"/>
                                <field name="ci_id" optional="hide"/>
                                <field name="year"/>
                                <field name="placement_term"/>
                                <field name="ptse_1"/>
                                <field name="ptse_2"/>
                                <field name="ptse_3" widget="binary"/>
                            </tree>
                        </field>
                        </page>

                        <page name='medical_attachment_ids' string="Program Required Document">
                            <field name="medical_attachment_ids" string="Attach a file" mode="tree" context="{'create': False}">
                                <tree editable="bottom" delete="false" create="false">
                                    <field name="company_id" string="University" groups="base.group_multi_company" />
                                    <field name="attachment_type" readonly="1" force_save="1"/>
                                    <field name="expiration_date" />
                                    <field name="attachment_ids" widget="many2many_attachment_preview" />
                                    
                                    <field name="state" widget="badge" decoration-muted="state == 'under_review'"  decoration-danger="state == 'cancel'"  decoration-success="state == 'confirmed'" decoration-warning="state == 'required_update'"/>
                                    <button name="action_under_review" string="Under Review" type="object" attrs="{'invisible': [('state', 'not in', ['cancel']), ('state', '!=', False)]}"/>
                                    <button name="action_required_update" string="Required Update" type="object" attrs="{'invisible': ['|', ('state', 'not in', ['under_review']), ('state', '=', False)]}"/>
                                    <button name="action_confirmed" string="Confirmed" type="object" attrs="{'invisible': ['|', ('state', 'not in', ['under_review', 'required_update']), ('state', '=', False)]}"/>
                                    <button name="action_cancel" string="Cancelled" type="object" attrs="{'invisible': ['|', ('state', 'in', ['cancel']), ('state', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                        <page name='scce_medical_attachment_ids' string="Site Required Document">
                            <field name="scce_medical_attachment_ids" string="Attach a file" mode="tree" context="{'create': False}">
                                <tree editable="bottom" delete="false" create="false">
                                    <field name="company_id" string="University" groups="base.group_multi_company"/>
                                    <field name="scce_attachment_type" readonly="1" force_save="1"/>
                                    <field name="expiration_date"/>
                                    <field name="attachment_ids" widget="many2many_attachment_preview"/>
                                    <field name="state" widget="badge" decoration-muted="state == 'under_review'"  decoration-danger="state == 'cancel'"  decoration-success="state == 'confirmed'" decoration-warning="state == 'required_update'"/>
                                    <button name="action_under_review" string="Under Review" type="object" attrs="{'invisible': [('state', 'not in', ['cancel']), ('state', '!=', False)]}"/>
                                    <button name="action_required_update" string="Required Update" type="object" attrs="{'invisible': ['|', ('state', 'not in', ['under_review']), ('state', '=', False)]}"/>
                                    <button name="action_confirmed" string="Confirmed" type="object" attrs="{'invisible': ['|', ('state', 'not in', ['under_review', 'required_update']), ('state', '=', False)]}"/>
                                    <button name="action_cancel" string="Cancelled" type="object" attrs="{'invisible': ['|', ('state', 'in', ['cancel']), ('state', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>

                        <page name='internal_notes' string="Notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>