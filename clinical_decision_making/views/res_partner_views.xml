<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Student Views -->
    <record id="student_view_tree" model="ir.ui.view">
        <field name="name">student.view.tree</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="cohort_label"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="home_address"/>
                <field name="contact_address"/>
                <field name="ice_term"/>
                <field name="tce1_term"/>
                <field name="tce2_term"/>
            </tree>
        </field>
    </record>

    <record id="student_view_form" model="ir.ui.view">
        <field name="name">student.view.form</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Partners">
                <field name="active" invisible="1"/>
                <field name="is_student" invisible="1"/>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <span class="o_form_label o_td_label" name="address_name">
                                <b >Name</b>
                            </span>
                            <div class="o_address_format">
                                <field name="first_name" placeholder="First Name" class="o_address_city"/>
                                <field name="last_name" class="o_address_state" placeholder="Last Name"/>
                            </div>
                            <field name="program_id"/>
                            <field name="start_year"/>
                            <field name="start_term_type"/>
                            <field name="cohort_label"/>
                            <field name="start_term"/>
                            <field name="graduation_term"/>
                        </group>
                        <group>
                            <field name="home_address"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="ice_term"/>
                            <field name="tce1_term"/>
                            <field name="tce2_term"/>
                        </group>
                    </group>

                    <notebook colspan="4">
                        <page string="Geographical" name="student_geographical" autofocus="autofocus">
                            <field name="geographical_ids" mode="tree">
                                <tree editable="bottom">
                                    <field name="zip_code"/>
                                    <field name="state"/>
                                    <field name="city"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Archive" name="student_archive">
                            <field name="archive_ids" mode="tree">
                                <tree edit="false" create="false" delete="false">
                                    <field name="student_id"/>
                                    <field name="facility_id"/>
                                    <field name="date"/>
                                    <field name="placement_type"/>
                                    <field name="placement_term"/>
                                    <field name="code"/>
                                    <field name="zip_code"/>
                                    <field name="city"/>
                                    <field name="state"/>
                                    <field name="date_begin"/>
                                    <field name="date_end"/>
                                </tree>
                            </field>
                        </page>
                        <page name='internal_notes' string="Internal Notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>