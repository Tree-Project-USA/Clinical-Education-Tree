<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Student Views -->
    <record id="student_view_tree" model="ir.ui.view">
        <field name="name">student.view.tree</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <tree>
                <field name="studentid"/>
                <field name="name"/>
                <field name="cohort_label"/>
                <field name="email"/>
                <field name="personal_phone"/>
                <field name="home_address"/>
                <field name="ice_term"/>
                <field name="tce1_term"/>
                <field name="tce2_term"/>
            </tree>
        </field>
    </record>

    <record id="partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.view.search</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="studentid"/>
                <field name="cohort_label"/>
                <field name="email"/>
                <field name="personal_phone"/>
                <field name="home_address"/>
                <field name="contact_address"/>
                <field name="ice_term"/>
                <field name="tce1_term"/>
                <field name="tce2_term"/>
            </search>
        </field>
    </record>

    <record id="student_view_form" model="ir.ui.view">
        <field name="name">student.view.form</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Partners">
                <header>
                    <button name="skip_student_term_action" string="Skip Student Term" type="object"/>
                </header>
                <field name="active" invisible="1"/>
                <field name="is_student" invisible="1"/>
                <sheet>
                    <field name="hardship_count" invisible="1"/>
                    <div name="button_box" position="inside">
                        <button name="action_open_hardship" type="object" class="oe_stat_button" attrs="{'invisible': [('hardship_count', '=', 0)]}">
                            <span class="o_stat_text">Hardship<br/>Request</span>
                        </button>
                        <button name="action_view_skipped_term" type="object" class="oe_stat_button" icon="fa-forward">
                            <span class="o_stat_text">Skipped<br/>Terms</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div>
                        <h3>
                            <field name="studentid" placeholder="Student ID" attrs="{'readonly': [('id', '!=', False)]}"/>
                        </h3>
                        <h1>
                            <field name="name" placeholder="Student Name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <span class="o_form_label o_td_label" name="address_name">
                                <b>Student Name</b>
                            </span>
                            <div class="o_address_format">
                                <field name="first_name" placeholder="Student First Name" required="1" class="o_address_city"/>
                                <field name="last_name" class="o_address_state" required="1" placeholder="Student Last Name"/>
                            </div>
                            <field name="is_with_hardship" invisible="1"/>
                            <field name="is_complete_ice"  invisible="1"/>
                            <field name="is_complete_tce1" invisible="1"/>
                            <field name="is_complete_tce2" invisible="1"/>
                            <field name="campus" readonly="1"/>
                            <field name="program_id"/>
                            <field name="program_type" readonly="1"/>
                            <field name="start_year"/>
                            <field name="start_term_type"/>
                            <field name="cohort_label"/>
                            <field name="start_term" invisible="1"/>
                            <field name="graduation_term"/>
                        </group>
                        <group>
                            <field name="home_address"/>
                            <field name="phone" string="Home Phone"/>
                            <field name="personal_phone"/>
                            <field name="personal_email_address"/>
                            <field name="email" string="University Email Address" required="1"/>
                            <field name="ice_term"/>
                            <field name="tce1_term"/>
                            <field name="tce2_term"/>
                        </group>
                    </group>

                    <notebook colspan="4">
                        <page string="Preferred Addresses" name="student_geographical" autofocus="autofocus">
                            <field name="geographical_ids" mode="tree">
                                <tree editable="bottom" create="false">
                                    <field name="city"/>
                                    <field name="state"/>
                                    <field name="zip_code"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Placement History" name="student_archive">
                            <field name="archive_ids" mode="tree">
                                <tree editable="bottom" delete="false">
                                    <field name="student_id" invisible="1"/>
                                    <field name="is_declined" invisible="1"/>
                                    <field name="facility_id" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="placement_type" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="placement_term" readonly="1" force_save="1"/>
                                    <field name="year" readonly="1" force_save="1"/>
                                    <field name="setting" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="city" string="Student Preferred City"/>
                                    <field name="state" string="Student Preferred State"/>
                                    <field name="geographical_id" string="Student Preferred Zip Code" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <field name="placement_status" required="1" attrs="{'readonly': [('is_declined', '=', True)]}"/>
                                    <!-- <button name="unlink_offer" type="object" string="Cancel Placement" class="btn btn-outline-danger" attrs="{'invisible': [('placement_status', 'not in', ['approved', 'pending'])]}"/> -->
                                    <field name="is_show_student" widget="boolean_toggle" />
                                    <button name="apply_student_offer" type="object" string="Re-Apply offer " class="btn btn-outline-secondary"  attrs="{'invisible': [('is_declined', '!=', True)]}"/>
                                    <button name="action_open_archive_log" type="object" icon="fa-external-link" title="Open Contract"/>

                                    <field name="zip_code" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page name='preferred_settings' string="Preferred Settings">
                            <field name="preferred_setting_ids" mode="tree">
                                <tree editable="bottom" create="false">
                                    <field name="name" string="Setting"/>
                                    <field name="type_setting"/>
                                </tree>
                            </field>
                        </page>
                        <page name='internal_notes' string="Notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>