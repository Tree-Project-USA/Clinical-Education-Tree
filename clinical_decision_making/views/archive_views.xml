<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- archive Views -->
    <record id="archive_view_tree" model="ir.ui.view">
        <field name="name">archive.view.tree</field>
        <field name="model">archive</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <tree string="Students Placement Archive" delete="false">
                <field name="studentid"/>
                <field name="student_id"/>
                <field name="facility_id"/>
                <field name="placement_type"/>
                <field name="setting"/>
                <field name="placement_term"/>
                <field name="year"/>
                <field name="city"/>
                <field name="state"/>
                <field name="geographical_id"/>
                <field name="placement_status"/>
            </tree>
        </field>
    </record>

    <record id="archive_view_form" model="ir.ui.view">
        <field name="name">archive.view.form</field>
        <field name="model">archive</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Students Placement Archive" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="studentid"/>
                            <field name="student_id"/>
                            <field name="facility_id"/>
                        </group>
                        <group>
                            <field name="placement_type"/>
                            <field name="placement_term" readonly="1"/>
                        </group>
                        <group>
                            <field name="year" readonly="1"/>
                            <field name="setting"/>
                        </group>
                        <group>
                            <field name="zip_code" invisible="1"/>
                            <field name="city"/>
                            <field name="state"/>
                            <field name="geographical_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="archive_view_search" model="ir.ui.view">
        <field name="name">archive.view.search</field>
        <field name="model">archive</field>
        <field name="arch" type="xml">
            <search>
                <field name="studentid"/>
                <field name="student_id"/>
                <field name="facility_id"/>
                <field name="placement_type"/>
                <field name="placement_term"/>
                <field name="year"/>
                <field name="geographical_id"/>
                <field name="zip_code"/>
                <field name="city"/>
                <field name="state"/>
            </search>
        </field>
    </record>


</odoo>