<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- archive Views -->
    <record id="archive_view_tree" model="ir.ui.view">
        <field name="name">archive.view.tree</field>
        <field name="model">archive</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <tree string="Students Placement Archive">
                <field name="term"/>
                <field name="department_id"/>
                <field name="student_id"/>
                <field name="facility_id"/>
                <field name="experience_id"/>
                <field name="setting"/>
                <field name="placement_term"/>
                <field name="year"/>
                <field name="city"/>
                <field name="state"/>
                <field name="geographical_id"/>
                <field name="placement_status"/>
                <field name="is_show_student" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <record id="archive_view_form" model="ir.ui.view">
        <field name="name">archive.view.form</field>
        <field name="model">archive</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Students Placement Archive">
                <field name="term" invisible="1"/>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="facility_id"/>
                        </group>
                        <group>
                            <field name="company_id" string="University" groups="base.group_multi_company"/>
                            <field name="experience_id"/>
                            <field name="placement_term" readonly="1"/>
                        </group>
                        <group>
                            <field name="year" readonly="1"/>
                            <field name="setting"/>
                        </group>
                        <group>
                            <field name="zip_code" invisible="1"/>
                            <field name="city"/>
                            <field name="state"/>
                            <field name="geographical_id" required="1"/>
                            <field name="is_show_student" widget="boolean_toggle" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- model.name form view -->
    <record id="archive_wizard_view_form" model="ir.ui.view">
        <field name="name">archive.view.form</field>
        <field name="model">archive</field>
        <field name="arch" type="xml">
            <qweb>
                <div class="oe_chatter" >
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </qweb>
        </field>
    </record>

    <record id="archive_view_search" model="ir.ui.view">
        <field name="name">archive.view.search</field>
        <field name="model">archive</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="facility_id"/>
                <field name="experience_id"/>
                <field name="company_id" string="University" groups="base.group_multi_company"/>
                <field name="placement_term"/>
                <field name="year"/>
                <field name="geographical_id"/>
                <field name="zip_code"/>
                <field name="city"/>
                <field name="state"/>
            </search>
        </field>
    </record>


</odoo>