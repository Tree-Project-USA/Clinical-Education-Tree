<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- archive Views -->
    <record id="archive_view_tree" model="ir.ui.view">
        <field name="name">archive.view.tree</field>
        <field name="model">archive</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <tree string="Students Placement Archive" edit="false" create="false" delete="false">
                <field name="student_id"/>
                <field name="facility_id"/>
                <field name="placement_type"/>
                <field name="placement_term"/>
                <field name="year"/>
                <field name="geographical_id"/>
                <field name="zip_code"/>
                <field name="city"/>
                <field name="state"/>

            </tree>
        </field>
    </record>

    <record id="archive_view_search" model="ir.ui.view">
        <field name="name">archive.view.search</field>
        <field name="model">archive</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="facility_id"/>
                <field name="placement_type"/>
                <field name="placement_term"/>
                <field name="year"/>
                <field name="geographical_id"/>
                <field name="zip_code"/>
                <field name="city"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record id="archive_view_form" model="ir.ui.view">
        <field name="name">archive.view.form</field>
        <field name="model">archive</field>
        <field name="mode">primary</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Student Placement Archive" edit="false" create="false" delete="false">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <!-- <widget name="web_ribbon" title="Archived" bg_color="bg-danger"/> -->
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="facility_id"/>
                            <field name="offer_id"/>
                            <field name="geographical_id"/>
                        </group>
                        <group>
                            <field name="geographical_id"/>
                            <field name="city"/>
                            <field name="state"/>
                            <field name="zip_code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>