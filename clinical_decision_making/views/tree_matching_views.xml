<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tree_matching_view_tree" model="ir.ui.view">
        <field name="name">tree.matching.view.tree</field>
        <field name="model">tree.matching</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree editable="bottom" js_class="o_fields_col" 
                    decoration-primary="tree_state=='approved_pp'" 
                    decoration-success="tree_state == 'approved_p'" 
                    decoration-warning="tree_state=='not_confirm_state'" 
                    decoration-muted="tree_state=='not_accepet_dis'">
                <header>
                    <!-- <button name="action_send_email_to_students" string="Send to Update Data" type="object"/> -->
                </header>
                <field name="request_id" invisible="1"/>
                <field name="parent_state" invisible="1"/>
                <field name="tree_state" invisible="1"/>
                <!-- Student Information -->
                <field name="student_id" class="o_fields_col" readonly="1"/>
                <field name="first_name" class="o_fields_col" readonly="1"/>
                <field name="last_name" class="o_fields_col" readonly="1"/>
                <field name="cohort_label" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_email" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_phone" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="home_address" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_zip_one" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_zip_two" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_zip_three" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_zip_four" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_zip_five" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_city_one_id" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_city_two_id" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_city_three_id" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_city_four_id" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_city_five_id" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_state_one_id" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_state_two_id" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_state_three_id" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_state_four_id" class="o_fields_col" optional="hide" readonly="1"/>
                <field name="stu_locatio_state_five_id" class="o_fields_col" optional="hide" readonly="1"/>

                <!-- Hardship Status -->
                <field name="hardship_status" class="o_fields_col" widget="badge" decoration-warning="hardship_status=='not_approved'" decoration-success="hardship_status == 'approved'"/>

                <!-- Placement TCE 1  -->
                <field name="aval_scce_ids" invisible="1"/>
                <field name="aval_facility_id" invisible="1"/>
                <field name="facility_id" domain="[('id', 'in', aval_facility_id)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}" attrs="{'readonly': [('parent_state', '=', 'done')]}"/>
                <field name="address" optional="hide"/>
                <field name="email" optional="hide"/>
                <field name="geographical_id" optional="hide"/>
                <field name="state" optional="hide"/>
                <field name="city" optional="hide"/>
                <field name="scce_id" domain="[('id', 'in', aval_scce_ids)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}" attrs="{'readonly': [('parent_state', '=', 'done')]}"/>
                <field name="scce_first_name" optional="hide"/>
                <field name="scce_last_name" optional="hide"/>
                <field name="scce_email" optional="hide"/>
                <field name="placement_status" widget="state_selection"  attrs="{'readonly': [('parent_state', '=', 'done')]}"/>

            </tree>

        </field>
    </record>
</odoo>