<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record model="ir.ui.view" id="geographical_view_tree">
            <field name="name">geographical.tree</field>
            <field name="model">geographical</field>
            <field name="arch" type="xml">
                <tree create='0' edit='0' delete='0'>
                    <field name="zip_code"/>
                    <field name="state"/>
                    <field name="city"/>
                    <field name="latitude"/>
                    <field name="longitude"/>
                </tree>
            </field>
        </record>
        
        <!-- Form View -->
        <record model="ir.ui.view" id="geographical_view_form">
            <field name="name">geographical.form</field>
            <field name="model">geographical</field>
            <field name="arch" type="xml">
                <form create='0' edit='0' delete='0'>
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="zip_code"/>
                                <field name="state"/>
                                <field name="city"/>
                            </group>
                            <group>
                                <field name="latitude"/>
                                <field name="longitude"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="geographical_action">
            <field name="name">Geographical Data</field>
            <field name="res_model">geographical</field>
            <field name="context">{'create': False}</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>