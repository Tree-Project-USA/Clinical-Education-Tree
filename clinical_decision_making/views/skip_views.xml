<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View skip View Tree -->
    <record id="view_skip_tree" model="ir.ui.view">
        <field name="name">view.skip.tree</field>
        <field name="model">skip</field>
        <field name="arch" type="xml">
            <tree string="Skip">
                <field name="student_id" invisible="1"/>
                <field name="term"/>
                <field name="year"/>
                <field name="state" widget="badge" decoration-muted="state == 'draft'" decoration-success="state == 'confirmed'"/>
                <button name="action_confirm" type="object" string="Confirm" class="oe_stat_button" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                <button name="action_draft" type="object" string="Return to Draft" class="oe_stat_button" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
            </tree>
        </field>
    </record>

    <!-- View skip search -->
    <record id="view_skip_search" model="ir.ui.view">
        <field name="name">view.skip.search</field>
        <field name="model">skip</field>
        <field name="arch" type="xml">
            <search string="Skip">
                <field name="term"/>
                <field name="year"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="skip_form_view_wizard" model="ir.ui.view">
        <field name="name">view.skip.form.wizard</field>
        <field name="model">skip</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="student_id" invisible="1"/>
                        <field name="term"/>
                        <field name="year"/>
                    </group>
                    <footer>
                        <button string="Save" class="btn-primary" special="save" type="object"/>
                        <button string="Confirm" class="btn-success" name="action_confirm" type="object"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action skip -->
    <record id="action_skip" model="ir.actions.act_window">
        <field name="name">Skip</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">skip</field>
        <field name="view_mode">tree</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Skip.
            </p>
        </field>
    </record>

</odoo>
