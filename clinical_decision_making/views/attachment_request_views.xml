<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View attachment.request View Tree -->
    <record id="view_attachment_request_tree" model="ir.ui.view">
        <field name="name">view.attachment.request.tree</field>
        <field name="model">attachment.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="student_id"/>
                <field name="create_date"/>
                <field name="state" widget="badge" decoration-muted="state == 'draft'"  decoration-danger="state == 'cancel'" decoration-success="state == 'confirmed'"/>
                <field name="company_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- View attachment.request form -->
    <record id="view_attachment_request_form" model="ir.ui.view">
        <field name="name">view.attachment.request.form</field>
        <field name="model">attachment.request</field>
        <field name="arch" type="xml">
            <form string="Request">
                <header>
                    <button name="confirm_attachment" string="Approve" type="object" class="btn btn-success" attrs="{'invisible': [('state', 'in', ['confirmed', 'cancel'])]}" data-hotkey="c"/>
                    <button name="action_cancel" string="Decline" type="object" class="btn btn-danger" attrs="{'invisible': [('state', 'in', ['cancel'])]}" data-hotkey="n"/>
                    <button name="action_update_required" string="Required Update" type="object" class="btn btn-warning" attrs="{'invisible': [('state', 'in', ['cancel'])]}" data-hotkey="u"/>
                    <button name="action_under_review" string="Return to Under Review" type="object" attrs="{'invisible': [('state', 'in', ['under_review'])]}" data-hotkey="d"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Canceled" bg_color="bg-danger" attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
                    <widget name="web_ribbon" title="Update Required" bg_color="bg-warning" attrs="{'invisible': [('state', '!=', 'update_required')]}"/>
                    <widget name="web_ribbon" title="Approved" bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <group>
                        <field name="student_id" attrs="{'readonly': [('state', 'in', ('confirmed', 'cancel'))]}"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                <notebook>
                    <page string="Attachment" name="medical_attachment_ids">
                    <field name="medical_attachment_ids" string="Attach a file" mode="tree">
                        <tree editable="bottom" delete="false">
                            <field name="company_id" string="University" readonly="1"/>
                            <field name="attachment_type"/>
                            <field name="expiration_date"/>
                            <field name="attachment_ids" widget="many2many_attachment_preview"/>
                        </tree>
                    </field>
                    </page>
                    <page string="Notes" name="notes">
                        <field name="note" attrs="{'readonly': [('state', 'in', ('confirmed', 'cancel'))]}"/>
                    </page>
                </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action attachment.request -->
    <record id="action_attachment_request" model="ir.actions.act_window">
        <field name="name">Attachment Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">attachment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Attachment Request.
            </p>
        </field>
    </record>

</odoo>
