<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- List View -->
        <record model="ir.ui.view" id="program_experience_term_tree">
            <field name="name">program.experience.term.tree</field>
            <field name="model">program.experience.term</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="program_id"/>
                    <field name="company_id"/>
                    <field name="experience_id"/>
                    <field name="sequence"/>
                    <field name="term"/>
                </tree>
            </field>
        </record>

        <!-- program form view -->
        <record id="clinical_experience_dates_view_form" model="ir.ui.view">
            <field name="name">clinical.experience.view.form</field>
            <field name="model">clinical.experience</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="action"/>
                        <field name="company_id" string="University" groups="base.group_multi_company" invisible="1"/>
                        <field name="date_ids">
                            <tree editable="bottom" delete="false">
                                <field name="company_id" string="University" groups="base.group_multi_company" invisible="1"/>
                                <field name="year"/>
                                <field name="fa_start_date"/>
                                <field name="fa_end_date"/>
                                <field name="sp_start_date"/>
                                <field name="sp_end_date"/>
                                <field name="su_start_date"/>
                                <field name="su_end_date"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>


</odoo>
