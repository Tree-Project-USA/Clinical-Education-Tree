<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <!-- List View -->
        <record model="ir.ui.view" id="program_tree">
            <field name="name">program.tree</field>
            <field name="model">program</field>
            <field name="arch" type="xml">
                <tree editable="bottom" decoration-muted="(not active)">
                    <field name="name"/>
                    <field name="num_terms"/>
                    <field name="company_id" />
                    <field name="ice_term" string="ICE term"/>
                    <field name="tce1_term" string="TCE 1 term"/>
                    <field name="tce2_term" string="TCE 2 term"/>
                    <button name="action_open_program_experience_term" type="object" icon="fa-external-link" title="Open Program terms"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- program form view -->
        <record id="program_view_form" model="ir.ui.view">
            <field name="name">program.view.form</field>
            <field name="model">program</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <field name="program_experience_term_ids">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="program_id" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                                <field name="company_id" readonly="1"/>
                                <field name="experience_id" readonly="1"/>
                                <field name="term" required="1"/>
                                <field name="start_date" required="1"/>
                                <field name="end_date" required="1"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

</odoo>