    <!-- cpdm.tree Views -->
    <record id="cpdm_tree_view_tree" model="ir.ui.view">
        <field name="name">cpdm.tree.view.tree</field>
        <field name="model">cpdm.tree</field>
        <field name="arch" type="xml">
            <tree >
                <field name="priority" optional="show" widget="priority" nolabel="1"/>
                <field name="sequence_number"/>
                <field name="name"/>
                <field name="term" widget="badge"/>
                <field name="type" widget="badge"/>
                <field name="date" options="{'datepicker': {'format': 'yyyy'}}"/>
                <field name="create_date"/>
                <field name="total_students"/>
                <field name="total_confirmed"/>
                <field name="total_pending"/>
                <field name="total_not_placed"/>
                <field name="total_hardships"/>
                <field name="state" widget="badge" decoration-muted="state=='draft'" decoration-success="state == 'running'" decoration-info="state=='done'"/>
            </tree>
        </field>
    </record>
    <!-- cpdm.tree form view -->
    <record id="cpdm_tree_view_form" model="ir.ui.view">
        <field name="name">cpdm.tree.view.form</field>
        <field name="model">cpdm.tree</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <field name="is_bot" invisible="1"/>
                    <button name="action_post" string="Confirm" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" data-hotkey="v"/>
                    <button name="action_draft" string="Reset To Draft" type="object" class="btn btn-secondary" attrs="{'invisible': [('state', '!=', 'done')]}" data-hotkey="w"/>
                    <button name="action_complete" string="Complete" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'running')]}" data-hotkey="w"/>
                    <button name="action_processing_by_bot" string="Processing By Bot" type="object" class="btn btn-secondary" attrs="{'invisible': ['|',('state', '!=', 'draft'),('is_bot', '=',True)]}" data-hotkey="w"/>
                    <field name="state" widget="statusbar" clickable="False"/>
                </header>

                <sheet>
                <!-- <widget name="web_ribbon" title="Bot" bg_color="bg-primary" attrs="{'invisible': [('is_bot', '=', False)]}"/> -->
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button shake"
                            type="object"
                            name="open_hardship_button"
                            icon="fa-smile-o"
                            attrs="{'invisible': [('state', '=', 'draft')]}"
                        >
                        Auto Placement
                        </button>
