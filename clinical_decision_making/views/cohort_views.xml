<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- cohort Views -->
    <record id="cohort_view_tree" model="ir.ui.view">
        <field name="name">cohort.view.tree</field>
        <field name="model">cohort</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree editable="bottom" js_class="o_fields_col" 
                    decoration-primary="tree_state=='approved_pp'" 
                    decoration-success="tree_state == 'approved_p'" 
                    decoration-warning="tree_state=='not_confirm_state'" 
                    decoration-muted="tree_state=='not_accepet_dis'">
                <header>
                    <button name="action_send_email_to_students" string="Send to Update Data" type="object"/>
                </header>
                <field name="cpdm_tree_id" invisible="1"/>
                <field name="tree_state" invisible="1"/>
                <field name="parent_type" invisible="1"/>
                <!-- Student Information -->
                <field name="student_id" class="o_fields_col"/>
                <field name="first_name" class="o_fields_col"/>
                <field name="last_name" class="o_fields_col"/>
                <field name="cohort_label" class="o_fields_col" optional="hide"/>
                <field name="stu_email" class="o_fields_col" optional="hide"/>
                <field name="stu_phone" class="o_fields_col" optional="hide"/>
                <field name="home_address" class="o_fields_col" optional="hide"/>
                <field name="stu_setting_one_id" class="o_fields_col" optional="hide"/>
                <field name="stu_setting_two_id" class="o_fields_col" optional="hide"/>
                <field name="stu_setting_three_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_city_one_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_city_two_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_city_three_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_city_four_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_city_five_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_state_one_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_state_two_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_state_three_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_state_four_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_state_five_id" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_zip_one" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_zip_two" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_zip_three" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_zip_four" class="o_fields_col" optional="hide"/>
                <field name="stu_locatio_zip_five" class="o_fields_col" optional="hide"/>

                <!-- Hardship Status -->
                <field name="hardship_status" class="o_fields_col" widget="badge" decoration-warning="hardship_status=='not_approved'" decoration-success="hardship_status == 'approved'"/>

                <!-- Hardship Status -->
                <field name="cat_one_requirment" widget="badge" decoration-warning="cat_one_requirment=='not_met'" decoration-success="cat_one_requirment == 'met'"/>
                <!-- <field name="met_via"/> -->
                <field name="pta_supervision" widget="state_selection"/>
                <field name="ipe" widget="state_selection"/>

                <!-- Placement ICE  -->
                <field name="aval_ice_setting_ids" invisible="1"/>
                <field name="aval_ice_scce_ids" invisible="1"/>
                <field name="aval_ice_site_id" invisible="1"/>
                <field name="ice_setting_id" domain="[('id', 'in', aval_ice_setting_ids)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
                <field name="ice_site_id" domain="[('id', 'in', aval_ice_site_id)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>                
                <field name="ice_site_address" optional="hide"/>
                <field name="ice_city" optional="hide"/>
                <field name="ice_state" optional="hide"/>
                <field name="ice_zip" optional="hide"/>
                <field name="ice_scce_id" domain="[('id', 'in', aval_ice_scce_ids)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
                <field name="ice_scce_first_name" optional="hide"/>
                <field name="ice_scce_last_name" optional="hide"/>
                <field name="ice_scce_email" optional="hide"/>
                <field name="ice_placement_status" widget="state_selection" />
                <field name="ice_accepted_distances" widget="badge" decoration-success="ice_accepted_distances == 'accepted'" decoration-warning="ice_accepted_distances=='not_accepted'"/>
                
                <!-- Placement TCE 1  -->
                <field name="aval_tce1_setting_id" invisible="1"/>
                <field name="aval_tce1_scce_ids" invisible="1"/>
                <field name="aval_tce1_site_id" invisible="1"/>
                <field name="tce1_setting_id" domain="[('id', 'in', aval_tce1_setting_id)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
                <field name="tce1_site_id" domain="[('id', 'in', aval_tce1_site_id)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
                <field name="tce1_site_address" optional="hide"/>
                <field name="tce1_city" optional="hide"/>
                <field name="tce1_state" optional="hide"/>
                <field name="tce1_zip" optional="hide"/>
                <field name="tce1_scce_id" domain="[('id', 'in', aval_tce1_scce_ids)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
                <field name="tce1_scce_first_name" optional="hide"/>
                <field name="tce1_scce_last_name" optional="hide"/>
                <field name="tce1_scce_email" optional="hide"/>
                <field name="tce1_placement_status" widget="state_selection" />
                <field name="tce1_accepted_distances" widget="badge" decoration-success="tce1_accepted_distances == 'accepted'" decoration-warning="tce1_accepted_distances=='not_accepted'"/>

                <!-- Placement TCE 2  -->
                <field name="aval_tce2_setting_id" invisible="1"/>
                <field name="aval_tce2_scce_ids" invisible="1"/>
                <field name="aval_tce2_site_id" invisible="1"/>
                <field name="tce2_setting_id" domain="[('id', 'in', aval_tce2_setting_id)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
                <field name="tce2_site_id" domain="[('id', 'in', aval_tce2_site_id)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
                <field name="tce2_site_address" optional="hide"/>
                <field name="tce2_city" optional="hide"/>
                <field name="tce2_state" optional="hide"/>
                <field name="tce2_zip" optional="hide"/>
                <field name="tce2_scce_id" domain="[('id', 'in', aval_tce2_scce_ids)]" options="{'no_quick_create': 1, 'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
                <field name="tce2_scce_first_name" optional="hide"/>
                <field name="tce2_scce_last_name" optional="hide"/>
                <field name="tce2_scce_email" optional="hide"/>
                <field name="tce2_placement_status" widget="state_selection"/>
                <field name="tce2_accepted_distances" widget="badge" decoration-success="tce2_accepted_distances == 'accepted'" decoration-warning="tce2_accepted_distances=='not_accepted'"/>

            </tree>

        </field>
    </record>

