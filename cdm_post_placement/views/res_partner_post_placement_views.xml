<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_view_form_post_placement" model="ir.ui.view">
        <field name="name">student.view.form.post.placement</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="cdm_base.student_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="post_placement_managament" string="Post Placement Management">
                    <field name="plcement_management_ids" mode="tree">
                        <tree editable="bottom">
                            <field name="company_id" invisible="1"/>
                            <field name="experience_id"/>
                            <field name="ci_id" optional="hide"/>
                            <field name="year"/>
                            <field name="placement_term"/>
                            <field name="ptse_1"/>
                            <field name="ptse_2"/>
                            <field name="ptse_3" widget="binary"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
