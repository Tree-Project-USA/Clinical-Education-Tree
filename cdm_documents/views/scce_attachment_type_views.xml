<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View attachment.type View Tree -->
    <record id="view_scce_attachment_type_tree" model="ir.ui.view">
        <field name="name">view.scce.attachment.type.tree</field>
        <field name="model">scce.attachment.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="scce_id"/>
                <field name="is_required"/>
            </tree>
        </field>
    </record>

    <!-- View attachment.type form -->
    <record id="view_scce_attachment_type_form" model="ir.ui.view">
        <field name="name">view.scce.attachment.type.form</field>
        <field name="model">scce.attachment.type</field>
        <field name="arch" type="xml">
            <form string="Site Attachment Type">
                <header></header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="scce_id"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="is_required"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action attachment.type -->
    <record id="action_scce_attachment_type" model="ir.actions.act_window">
        <field name="name">Site Attachment Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">scce.attachment.type</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Site Attachment Type.
            </p>
        </field>
    </record>

</odoo>
