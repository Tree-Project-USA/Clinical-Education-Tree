<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="attachments_comp_rule" model="ir.rule">
            <field name="name">Documents multi-company</field>
            <field name="model_id" ref="model_attachments"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="attachment_type_comp_rule" model="ir.rule">
            <field name="name">Attachment Type multi-company</field>
            <field name="model_id" ref="model_attachment_type"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        </record>

        <record id="scce_attachment_type_comp_rule" model="ir.rule">
            <field name="name">SCCE Attachment Type multi-company</field>
            <field name="model_id" ref="model_scce_attachment_type"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        </record>
    </data>
</odoo>
